<Window x:Class="VisionInspectionApp.Updater.UpdaterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CMS VINA Vision Updater"
        Height="220" Width="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        Loaded="Window_Loaded">

    <Border Background="#0F172A"
            BorderBrush="#38BDF8"
            BorderThickness="1.5"
            CornerRadius="10"
            Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.7" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🚀" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="CMS VINA — ĐANG CẬP NHẬT PHẦN MỀM"
                           FontWeight="Bold"
                           FontSize="14"
                           Foreground="#38BDF8"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Center Status & Progress -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,15,0,15">
                <TextBlock x:Name="StatusTextBlock"
                           Text="Đang khởi tạo trình cập nhật..."
                           Foreground="White"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <ProgressBar x:Name="UpdateProgressBar"
                             Height="12"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Foreground="#38BDF8"
                             Background="#1E293B"
                             BorderBrush="#334155" />

                <TextBlock x:Name="DetailTextBlock"
                           Text="Vui lòng không tắt máy tính hoặc ngắt nguồn..."
                           Foreground="#94A3B8"
                           FontSize="11"
                           Margin="0,8,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Bottom Warning / Info -->
            <DockPanel Grid.Row="2" LastChildFill="False">
                <TextBlock Text="⚙️ Chế độ an toàn: Tự động khôi phục nếu có sự cố."
                           Foreground="#64748B"
                           FontSize="10.5"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
