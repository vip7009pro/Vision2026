{
  "name": "vision2026-license-server",
  "version": "1.0.0",
  "description": "Enterprise Standalone License Management Server for Vision2026 (Online & Offline Support)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "gen-keys": "node -e \"require('./dist/crypto/licenseCrypto').LicenseCrypto.ensureKeyPair()\""
  },
  "keywords": [
    "license-server",
    "hardware-binding",
    "rsa-signature",
    "vision2026"
  ],
  "author": "Vision2026 Team",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
