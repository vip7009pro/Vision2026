<Window x:Class="VisionInspectionApp.UI.Views.LightingServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="🖥️ Lighting Control Server — Máy Chủ Điều Khiển Đèn (LAN)"
        Width="1050" Height="720"
        MinWidth="950" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Card Border Style -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="2" />
        </Style>

        <!-- Section Header -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <!-- Small Label -->
        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
    </Window.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="165" />
        </Grid.RowDefinitions>

        <!-- ROW 0: Main Section (Left: Server & COM settings & Client list / Right: Channel Cards) -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="450" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Server & COM Settings & Connected Clients -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,3,0">
                    
                    <!-- 1. TCP Server Configuration Card -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,4">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource SectionHeader}" Text="🖥️ Cấu Hình Máy Chủ (TCP Server)" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ServerStatusText}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Server Port & Local IP -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="75" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Cổng nghe:" VerticalAlignment="Center" Margin="0,0,4,0" Style="{StaticResource SmallLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding ServerPort, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center" Padding="4,2" Margin="0,0,8,0" FontSize="11" FontWeight="SemiBold"
                                         IsEnabled="{Binding IsServerRunning, Converter={StaticResource BoolToVis}}" />

                                <TextBlock Grid.Column="2" Text="IP LAN:" VerticalAlignment="Center" Margin="0,0,4,0" Style="{StaticResource SmallLabel}" />
                                <ComboBox Grid.Column="3" ItemsSource="{Binding LocalIpAddresses}" SelectedItem="{Binding SelectedIpAddress}"
                                          VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0" />
                                <Button Grid.Column="4" Content="📋 Copy IP" Command="{Binding CopyIpCommand}"
                                        Padding="6,2" VerticalAlignment="Center" FontSize="10.5" ToolTip="Sao chép địa chỉ IP để nhập vào máy dev văn phòng" />
                            </Grid>

                            <!-- Start / Stop Server Buttons -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="▶ Khởi Động Server" Command="{Binding StartServerCommand}"
                                        IsEnabled="{Binding IsServerStopped}"
                                        Margin="0,0,4,0" Padding="8,5" Background="#2E7D32" Foreground="White" FontWeight="SemiBold" />
                                <Button Grid.Column="1" Content="⏹ Dừng Server" Command="{Binding StopServerCommand}"
                                        IsEnabled="{Binding IsServerRunning}"
                                        Margin="0,0,4,0" Padding="8,5" Background="#C62828" Foreground="White" FontWeight="SemiBold" />
                                <Button Grid.Column="2" Content="🚀 Mở App Độc Lập" Command="{Binding LaunchStandaloneAppCommand}"
                                        Padding="8,5" Background="#0288D1" Foreground="White" FontWeight="SemiBold"
                                        ToolTip="Khởi chạy VisionInspectionApp.LightingServer.exe độc lập" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 2. Physical Hardware (COM Port) Card -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,4">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource SectionHeader}" Text="🔌 Bộ Điều Khiển Đèn Vật Lý (COM Port)" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding HardwareStatusText}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Cổng:" VerticalAlignment="Center" Margin="0,0,4,0" Style="{StaticResource SmallLabel}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableComPorts}" SelectedItem="{Binding SelectedComPort}"
                                          VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0"
                                          IsEnabled="{Binding IsHardwareDisconnected}" />
                                <Button Grid.Column="2" Content="🔄" Command="{Binding RefreshComPortsCommand}"
                                        Padding="5,2" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Làm mới danh sách cổng COM"
                                        IsEnabled="{Binding IsHardwareDisconnected}" />

                                <TextBlock Grid.Column="3" Text="Baud:" VerticalAlignment="Center" Margin="0,0,4,0" Style="{StaticResource SmallLabel}" />
                                <ComboBox Grid.Column="4" ItemsSource="{Binding AvailableBaudRates}" SelectedItem="{Binding SelectedBaudRate}"
                                          VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0"
                                          IsEnabled="{Binding IsHardwareDisconnected}" />

                                <TextBlock Grid.Column="5" Text="Kênh:" VerticalAlignment="Center" Margin="0,0,4,0" Style="{StaticResource SmallLabel}" />
                                <ComboBox Grid.Column="6" ItemsSource="{Binding AvailableChannelCounts}" SelectedItem="{Binding SelectedChannelCount}"
                                          VerticalAlignment="Center" FontSize="11"
                                          IsEnabled="{Binding IsHardwareDisconnected}" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="🔌 Kết Nối Đèn (COM)" Command="{Binding ConnectHardwareCommand}"
                                        IsEnabled="{Binding IsHardwareDisconnected}"
                                        Margin="0,0,4,0" Padding="8,4" FontWeight="SemiBold" />
                                <Button Grid.Column="1" Content="Ngắt Kết Nối COM" Command="{Binding DisconnectHardwareCommand}"
                                        IsEnabled="{Binding IsHardwareConnected}"
                                        Padding="8,4" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 3. Connected Clients List Card -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,4" MinHeight="140">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource SectionHeader}" Text="👥 Danh Sách Client Đang Kết Nối" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{DynamicResource PanelAltBackgroundBrush}" CornerRadius="3" Padding="6,2">
                                    <TextBlock Text="{Binding ClientCountText}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </Grid>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding ConnectedClients}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      Background="{DynamicResource PanelAltBackgroundBrush}"
                                      BorderBrush="{DynamicResource BorderBrush}"
                                      MaxHeight="150">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Địa Chỉ Client" Binding="{Binding RemoteEndPoint}" Width="*" />
                                    <DataGridTextColumn Header="Thời Điểm Kết Nối" Binding="{Binding ConnectedAt, StringFormat='HH:mm:ss'}" Width="90" />
                                    <DataGridTextColumn Header="Số Lệnh" Binding="{Binding CommandsProcessed}" Width="65" />
                                    <DataGridTextColumn Header="Lệnh Gần Nhất" Binding="{Binding LastCommand}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- 4. Quick Actions Card -->
                    <Border Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="💡 Bật Toàn Bộ Kênh" Command="{Binding TurnOnAllChannelsCommand}"
                                    Margin="0,0,4,0" Padding="6,4" />
                            <Button Grid.Column="1" Content="⬛ Tắt Toàn Bộ Kênh" Command="{Binding TurnOffAllChannelsCommand}"
                                    Margin="4,0,0,0" Padding="6,4" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT COLUMN: Direct 4/8 Channel Control on Server -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="3,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="💡 Điều Khiển Trực Tiếp Kênh Chiếu Sáng Trên Server" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding SelectedChannelCount, StringFormat='({0} Kênh)'}"
                                       FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="📥 Đọc Từ Đèn" Command="{Binding ReadHardwareStateCommand}" Padding="6,2" Margin="0,0,4,0" FontSize="10.5" ToolTip="Đọc lại trạng thái hiện tại từ bộ điều khiển đèn qua cổng COM" />
                            <Button Content="💡 Bật Tất Cả" Command="{Binding TurnOnAllChannelsCommand}" Padding="6,2" Margin="0,0,4,0" FontSize="10.5" />
                            <Button Content="⬛ Tắt Tất Cả" Command="{Binding TurnOffAllChannelsCommand}" Padding="6,2" FontSize="10.5" />
                        </StackPanel>
                    </Grid>

                    <!-- Channel Cards List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Channels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource PanelAltBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="8,5"
                                            Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="135" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Column 1: Channel Label + ON/OFF Switch -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ChannelLabel}"
                                                           FontWeight="Bold" FontSize="13.5"
                                                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,2" />
                                                <CheckBox IsChecked="{Binding IsEnabled}"
                                                          Content="ON" FontWeight="Bold" FontSize="11.5"
                                                          VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Column 2: Brightness Slider + TextBox -->
                                            <Grid Grid.Column="1" Margin="6,0,8,0" VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0" Margin="0,0,0,2">
                                                    <TextBlock Style="{StaticResource SmallLabel}" Text="Độ sáng (0-255):" HorizontalAlignment="Left" />
                                                    <TextBlock Text="{Binding Brightness}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                                                </Grid>
                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="48" />
                                                    </Grid.ColumnDefinitions>
                                                    <Slider Grid.Column="0" Minimum="0" Maximum="255"
                                                            Value="{Binding Brightness}"
                                                            VerticalAlignment="Center"
                                                            TickFrequency="1" IsSnapToTickEnabled="True" />
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding Brightness, UpdateSourceTrigger=PropertyChanged}"
                                                             VerticalAlignment="Center" Padding="2,1" FontSize="11"
                                                             HorizontalContentAlignment="Center"
                                                             Margin="4,0,0,0" />
                                                </Grid>
                                            </Grid>

                                            <!-- Column 3: Lighting Time ms -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource SmallLabel}" Text="Thời gian sáng (ms):" />
                                                <TextBox Text="{Binding LightingTimeMs, UpdateSourceTrigger=PropertyChanged}"
                                                         VerticalAlignment="Center" Padding="3,1" FontSize="11"
                                                         HorizontalContentAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ROW 1: Status Bar -->
        <Border Grid.Row="1" Margin="2,0,2,3" Padding="6,4" CornerRadius="4"
                Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Border>

        <!-- ROW 2: Traffic Logs -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="2,0,2,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource SectionHeader}" Text="📋 Traffic Log (Lưu Lượng Giao Tiếp LAN)" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="🗑️ Xóa Log" Command="{Binding ClearLogsCommand}" Padding="6,2" FontSize="10.5" />
                </Grid>

                <TextBox Grid.Row="1" Text="{Binding LogText, Mode=OneWay}"
                         IsReadOnly="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="11"
                         Background="{DynamicResource PanelAltBackgroundBrush}"
                         Foreground="{DynamicResource TextBrush}"
                         BorderThickness="0" />
            </Grid>
        </Border>
    </Grid>
</Window>
