<Window x:Class="VisionInspectionApp.UI.Views.OTA.OtaUpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cập Nhật Phần Mềm Từ Xa — CMS VINA OTA Update"
        Height="620" Width="720"
        MinHeight="560" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        Icon="pack://application:,,,/VisionInspectionApp.UI;component/Assets/cms-vina-vision-system.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Tab Contents -->
            <RowDefinition Height="*" />
            <!-- Footer Status & Action Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Banner -->
        <Border Grid.Row="0"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <TextBlock Text="🚀" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CMS VINA — CẬP NHẬT PHẦN MỀM TỪ XA (OTA UPDATE)"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Tự động kiểm tra, tải về và cập nhật các phiên bản mới nhất an toàn qua mạng."
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- TAB 1: CẬP NHẬT -->
            <TabItem Header="🔄 Kiểm Tra &amp; Cập Nhật">
                <Grid Margin="4,10,4,4">
                    <Grid.RowDefinitions>
                        <!-- Error Banner Row -->
                        <RowDefinition Height="Auto" />
                        <!-- Version Cards Row -->
                        <RowDefinition Height="Auto" />
                        <!-- Release Notes Section -->
                        <RowDefinition Height="*" />
                        <!-- Progress Section -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Last Update Error Alert Banner -->
                    <Border Grid.Row="0"
                            Visibility="{Binding HasLastUpdateError, Converter={StaticResource BoolToVis}}"
                            Background="#451A1A"
                            BorderBrush="#EF4444"
                            BorderThickness="1.5"
                            CornerRadius="6"
                            Padding="12,10"
                            Margin="0,0,0,10">
                        <DockPanel LastChildFill="True">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button Content="📄 Xem Chi Tiết Lỗi"
                                        Command="{Binding OpenUpdateErrorLogCommand}"
                                        Background="#DC2626"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        Padding="10,4"
                                        Margin="0,0,6,0"
                                        ToolTip="Mở tệp nhật ký lỗi updater_error.log bằng Notepad" />
                                <Button Content="✕ Đóng"
                                        Command="{Binding DismissUpdateErrorCommand}"
                                        Background="Transparent"
                                        Foreground="#FCA5A5"
                                        BorderBrush="#7F1D1D"
                                        Padding="8,4" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="⚠️ LẦN CÀI ĐẶT CẬP NHẬT TRƯỚC ĐÃ PHÁT SINH SỰ CỐ (ĐÃ KHÔI PHỤC BẢN CŨ)"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           Foreground="#FCA5A5" />
                                <TextBlock Text="{Binding LastUpdateErrorSummary}"
                                           FontSize="11.5"
                                           Foreground="#FECACA"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,8,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Version Comparison Cards -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Current Version -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="6"
                                Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="Phiên Bản Hiện Tại" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding CurrentVersionText}" FontSize="18" FontWeight="ExtraBold" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Column="1" Text="➔" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <!-- Card 2: Latest Version -->
                        <Border Grid.Column="2"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="6"
                                Padding="12,8">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="Phiên Bản Mới Nhất" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" DockPanel.Dock="Left" />
                                    <TextBlock Text="{Binding PackageSizeText, StringFormat='📦 {0}'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" DockPanel.Dock="Right" />
                                </DockPanel>
                                <DockPanel Margin="0,4,0,0">
                                    <TextBlock Text="{Binding LatestVersionText}" FontSize="18" FontWeight="ExtraBold" Foreground="#38BDF8" DockPanel.Dock="Left" />
                                    <TextBlock Text="{Binding ReleaseDateText, StringFormat='📅 {0}'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Release Notes Box -->
                    <GroupBox Grid.Row="2" Header="📝 GHI CHÚ PHÁT HÀNH &amp; TÍNH NĂNG MỚI" Foreground="{DynamicResource TextBrush}" Padding="6">
                        <Border Background="{DynamicResource PanelAltBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10">
                                <TextBlock Text="{Binding ReleaseNotes}"
                                           FontSize="12"
                                           LineHeight="18"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </GroupBox>

                    <!-- Download Progress Bar (Hiển thị khi đang tải) -->
                    <Border Grid.Row="3"
                            Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,8,0,0">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                <TextBlock Text="{Binding DownloadProgressText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" DockPanel.Dock="Left" />
                                <TextBlock Text="{Binding DownloadSpeedText}" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8" DockPanel.Dock="Right" />
                            </DockPanel>
                            <ProgressBar Height="10"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding DownloadProgress}"
                                         Foreground="#38BDF8"
                                         Background="#1E293B"
                                         BorderBrush="#334155" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: CÀI ĐẶT MÁY CHỦ CẬP NHẬT -->
            <TabItem Header="⚙️ Cài Đặt Máy Chủ OTA">
                <StackPanel Margin="6,12,6,6">
                    <TextBlock Text="Cấu hình nguồn kiểm tra cập nhật từ xa (Hỗ trợ cả mạng nội bộ LAN &amp; GitHub):"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,0,12" />

                    <!-- Loại Nguồn -->
                    <TextBlock Text="Loại nguồn cập nhật:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                    <ComboBox SelectedValue="{Binding SelectedSourceType, Mode=TwoWay}"
                              SelectedValuePath="Tag"
                              Height="28" Margin="0,0,0,12" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="🌐 Tự động nhận diện theo URL (Khuyến nghị)" Tag="Auto" />
                        <ComboBoxItem Content="🏢 Máy chủ nội bộ LAN / HTTP Manifest (version.json)" Tag="CustomManifest" />
                        <ComboBoxItem Content="☁️ GitHub Releases API (Public/Private Repo)" Tag="GitHub" />
                    </ComboBox>

                    <!-- URL Cập Nhật -->
                    <TextBlock Text="Đường dẫn máy chủ / URL Manifest / GitHub Repo:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                    <TextBox Text="{Binding ServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Height="28"
                             Padding="6,0"
                             VerticalContentAlignment="Center"
                             Background="{DynamicResource InputBackgroundBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             ToolTip="Ví dụ: http://192.168.1.100:8080/api/updates/version.json hoặc cmsvina/VisionInspectionApp"
                             Margin="0,0,0,12" />

                    <!-- CheckBox Auto check -->
                    <CheckBox Content="Tự động kiểm tra bản cập nhật khi khởi động phần mềm"
                              IsChecked="{Binding AutoCheckOnStartup, Mode=TwoWay}"
                              FontWeight="SemiBold"
                              FontSize="12"
                              Margin="0,0,0,16" />

                    <!-- Nút Lưu Cài Đặt -->
                    <Button Content="💾 Lưu Cấu Hình OTA"
                            Command="{Binding SaveSettingsCommand}"
                            HorizontalAlignment="Left"
                            Padding="16,6"
                            Height="32" />
                </StackPanel>
            </TabItem>

            <!-- TAB 3: ĐÓNG GÓI & TẢI LÊN (PUBLISH) -->
            <TabItem Header="📦 Đóng Gói &amp; Tải Lên (Publish)">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,4,6,4">
                    <Grid Margin="4,8,4,4">
                        <Grid.RowDefinitions>
                            <!-- Nguồn & Phiên Bản -->
                            <RowDefinition Height="Auto" />
                            <!-- Server & Thư mục lưu trữ trên server -->
                            <RowDefinition Height="Auto" />
                            <!-- Ghi chú phát hành -->
                            <RowDefinition Height="Auto" />
                            <!-- Tiến trình & Nút hành động -->
                            <RowDefinition Height="Auto" />
                            <!-- Log Console -->
                            <RowDefinition Height="*" MinHeight="110" />
                        </Grid.RowDefinitions>

                        <!-- KHỐI 1: Thư mục nguồn & Phiên bản -->
                        <GroupBox Grid.Row="0" Header="📁 1. THƯ MỤC ỨNG DỤNG NGUỒN &amp; PHIÊN BẢN PHÁT HÀNH" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10" Padding="8">
                            <StackPanel>
                                <!-- Thư mục nguồn -->
                                <TextBlock Text="Đường dẫn thư mục chứa bản build/mã chạy ứng dụng để nén zip:" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding PublishSourceDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28" Padding="6,0" VerticalContentAlignment="Center"
                                             Background="{DynamicResource InputBackgroundBrush}"
                                             Foreground="{DynamicResource TextBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}" />
                                    <Button Grid.Column="1" Content="📁 Duyệt..." Command="{Binding BrowseSourceDirectoryCommand}"
                                            Height="28" Padding="12,0" Margin="6,0,0,0" />
                                </Grid>

                                <!-- Phiên bản mới & Nút tăng phiên bản -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Số phiên bản mới:" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="1" Text="{Binding PublishNewVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28" Padding="6,0" VerticalContentAlignment="Center" FontWeight="Bold" FontSize="13" Foreground="#38BDF8"
                                             Background="{DynamicResource InputBackgroundBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}" />

                                    <!-- Nút tăng phiên bản nhanh -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <Button Content="+0.0.0.1 (Patch)" Command="{Binding IncrementPatchVersionCommand}"
                                                Padding="6,4" FontSize="11" Margin="0,0,4,0" ToolTip="Tăng bản vá lỗi (Patch)" />
                                        <Button Content="+0.0.1.0 (Minor)" Command="{Binding IncrementMinorVersionCommand}"
                                                Padding="6,4" FontSize="11" Margin="0,0,4,0" ToolTip="Tăng tính năng nhỏ (Minor)" />
                                        <Button Content="+0.1.0.0 (Major)" Command="{Binding IncrementMajorVersionCommand}"
                                                Padding="6,4" FontSize="11" ToolTip="Tăng phiên bản lớn (Major)" />
                                    </StackPanel>

                                    <!-- Kênh phát hành -->
                                    <DockPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="Kênh:" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox SelectedValue="{Binding PublishReleaseChannel, Mode=TwoWay}"
                                                  SelectedValuePath="Tag"
                                                  Width="90" Height="26" VerticalContentAlignment="Center">
                                            <ComboBoxItem Content="Stable" Tag="Stable" />
                                            <ComboBoxItem Content="Beta" Tag="Beta" />
                                            <ComboBoxItem Content="Hotfix" Tag="Hotfix" />
                                        </ComboBox>
                                    </DockPanel>
                                </Grid>

                                <!-- Tùy chọn Checkboxes -->
                                <DockPanel LastChildFill="False" Margin="0,6,0,0">
                                    <CheckBox Content="Bắt buộc cập nhật (IsMandatory)"
                                              IsChecked="{Binding PublishIsMandatory, Mode=TwoWay}"
                                              FontSize="11.5" DockPanel.Dock="Left" Margin="0,0,16,0" />
                                    <CheckBox Content="Tự động cập nhật số Version vào file .csproj"
                                              IsChecked="{Binding PublishAutoUpdateCsproj, Mode=TwoWay}"
                                              FontWeight="SemiBold" FontSize="11.5" DockPanel.Dock="Left"
                                              ToolTip="Tự động sửa thẻ Version trong VisionInspectionApp.UI.csproj" />
                                </DockPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- KHỐI 2: Cấu hình Server & Thư mục lưu trữ trên server -->
                        <GroupBox Grid.Row="1" Header="🌐 2. MÁY CHỦ UPLOAD &amp; THƯ MỤC LƯU TRỮ TRÊN SERVER" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10" Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- URL máy chủ PHP -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,6">
                                    <TextBlock Text="Đường dẫn script máy chủ (ota_server.php):" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding PublishServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28" Padding="6,0" VerticalContentAlignment="Center"
                                             Background="{DynamicResource InputBackgroundBrush}"
                                             Foreground="{DynamicResource TextBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}"
                                             ToolTip="Ví dụ: http://192.168.1.100/ota_server.php" />
                                </StackPanel>

                                <!-- Thư mục lưu trữ trên server (yêu cầu người dùng) -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,6">
                                    <TextBlock Text="Thư mục chứa file zip trên server:" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding PublishServerStorageFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28" Padding="6,0" VerticalContentAlignment="Center"
                                             Background="{DynamicResource InputBackgroundBrush}"
                                             Foreground="{DynamicResource TextBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}"
                                             ToolTip="Thư mục trên server để chứa file zip, ví dụ: uploads/ota_packages hoặc updates/v1" />
                                </StackPanel>

                                <!-- Khóa bảo mật API Token -->
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,2,0,0">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="Khóa bí mật API Token (nếu máy chủ yêu cầu xác thực):" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox Text="{Binding PublishApiToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="26" Padding="6,0" VerticalContentAlignment="Center"
                                                 Background="{DynamicResource InputBackgroundBrush}"
                                                 Foreground="{DynamicResource TextBrush}"
                                                 BorderBrush="{DynamicResource BorderBrush}" />
                                    </DockPanel>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <!-- KHỐI 3: Ghi chú phát hành -->
                        <GroupBox Grid.Row="2" Header="📝 3. GHI CHÚ PHÁT HÀNH (RELEASE NOTES / CHANGELOG)" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10" Padding="8">
                            <TextBox Text="{Binding PublishReleaseNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Height="55"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Padding="6,4"
                                     Background="{DynamicResource InputBackgroundBrush}"
                                     Foreground="{DynamicResource TextBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" />
                        </GroupBox>

                        <!-- KHỐI 4: Tiến trình & Nút hành động -->
                        <Border Grid.Row="3"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Thanh trạng thái & Nút lớn -->
                                <DockPanel Grid.Row="0" LastChildFill="False">
                                    <!-- Nút phát hành -->
                                    <Button Content="🚀 Đóng Gói Zip &amp; Tải Lên Server"
                                            Command="{Binding PackageAndPublishCommand}"
                                            IsEnabled="{Binding IsPublishing, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                                            Background="#2563EB"
                                            BorderBrush="#1D4ED8"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            FontSize="12.5"
                                            Padding="18,7"
                                            Height="34"
                                            DockPanel.Dock="Left" Margin="0,0,10,0" />

                                    <!-- Nút Hủy phát hành (khi đang chạy) -->
                                    <Button Content="⏹ Hủy Bỏ"
                                            Command="{Binding CancelPublishCommand}"
                                            Visibility="{Binding IsPublishing, Converter={StaticResource BoolToVis}}"
                                            Background="#DC2626"
                                            BorderBrush="#B91C1C"
                                            Foreground="White"
                                            Padding="12,5"
                                            Height="34"
                                            DockPanel.Dock="Left" Margin="0,0,10,0" />

                                    <!-- Thông điệp trạng thái -->
                                    <TextBlock Text="{Binding PublishStatusMessage}"
                                               Foreground="{Binding PublishStatusColorHex}"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               DockPanel.Dock="Right" />
                                </DockPanel>

                                <!-- ProgressBar khi đang đóng gói/upload -->
                                <StackPanel Grid.Row="1" Margin="0,8,0,0" Visibility="{Binding IsPublishing, Converter={StaticResource BoolToVis}}">
                                    <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding PublishProgressText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" DockPanel.Dock="Left" />
                                        <TextBlock Text="{Binding PublishSpeedText}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" DockPanel.Dock="Right" />
                                    </DockPanel>
                                    <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding PublishProgress}" Foreground="#38BDF8" Background="#1E293B" BorderBrush="#334155" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- KHỐI 5: Console Logs -->
                        <GroupBox Grid.Row="4" Header="📜 NHẬT KÝ TIẾN TRÌNH CHI TIẾT" Foreground="{DynamicResource TextBrush}" Padding="4">
                            <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="8">
                                    <TextBlock Text="{Binding PublishLogs}" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11" Foreground="#38BDF8" TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Border>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer: Status Message & Action Buttons -->
        <Border Grid.Row="2"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,8"
                Margin="0,10,0,0">
            <DockPanel LastChildFill="True">
                <!-- Action Buttons (Right) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <!-- Nút Kiểm Tra Lại -->
                    <Button Content="🔍 Kiểm Tra Ngay"
                            Command="{Binding CheckForUpdateCommand}"
                            IsEnabled="{Binding IsDownloading, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                            Padding="12,5" Height="30" Margin="0,0,6,0" />

                    <!-- Nút Tải & Cập Nhật (Hiện khi có bản mới và chưa tải xong) -->
                    <Button Content="⬇️ Tải &amp; Cập Nhật"
                            Command="{Binding DownloadAndInstallCommand}"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"
                            Background="#16A34A"
                            BorderBrush="#15803D"
                            Foreground="White"
                            Padding="14,5" Height="30" FontWeight="Bold" Margin="0,0,6,0" />

                    <!-- Nút Hủy Tải (Hiện khi đang tải) -->
                    <Button Content="⏹ Hủy Tải"
                            Command="{Binding CancelDownloadCommand}"
                            Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"
                            Background="#DC2626"
                            BorderBrush="#B91C1C"
                            Foreground="White"
                            Padding="10,5" Height="30" Margin="0,0,6,0" />

                    <!-- Nút Cài Đặt & Khởi Động Lại (Hiện khi đã tải xong) -->
                    <Button Content="🚀 Cài Đặt &amp; Khởi Động Lại"
                            Command="{Binding LaunchInstallerCommand}"
                            Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVis}}"
                            Background="#2563EB"
                            BorderBrush="#1D4ED8"
                            Foreground="White"
                            Padding="14,5" Height="30" FontWeight="Bold" Margin="0,0,6,0" />

                    <!-- Nút Bỏ Qua Phiên Bản Này -->
                    <Button Content="Bỏ Qua Bản Này"
                            Command="{Binding IgnoreThisVersionCommand}"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Padding="10,5" Height="30" Margin="0,0,6,0" />

                    <!-- Nút Đóng -->
                    <Button Content="Đóng"
                            Command="{Binding CloseCommand}"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Padding="12,5" Height="30" />
                </StackPanel>

                <!-- Status Message (Left) -->
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{Binding StatusColorHex}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,10,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
