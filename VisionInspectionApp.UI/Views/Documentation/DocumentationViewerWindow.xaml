<Window x:Class="VisionInspectionApp.UI.Views.Documentation.DocumentationViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CMS VINA VISION SYSTEM — TRUNG TÂM TÀI LIỆU &amp; ĐÀO TẠO KỸ THUẬT"
        Height="820" Width="1300"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="HeaderActionButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#250F5FA8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <!-- Row 0: Top Header Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Main Split Section (Left: Document List, Right: Content Viewer) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Top Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
                <!-- Left: Title & Badge -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="📖" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TRUNG TÂM TÀI LIỆU &amp; ĐÀO TẠO KỸ THUẬT" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="TxtDocSubtitle" Text="Hệ thống quy trình chuẩn và tài liệu kỹ thuật chuyên sâu" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource HeaderActionButton}" Click="BtnOpenInBrowser_Click" ToolTip="Mở tài liệu hiện tại trong trình duyệt web mặc định (Chrome/Edge)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐" Margin="0,0,5,0" />
                            <TextBlock Text="Mở Trình Duyệt" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource HeaderActionButton}" Click="BtnOpenDocsFolder_Click" ToolTip="Mở thư mục chứa toàn bộ tài liệu và hình ảnh trong Windows Explorer">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📂" Margin="0,0,5,0" />
                            <TextBlock Text="Mở Thư Mục" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource HeaderActionButton}" Click="BtnPrint_Click" ToolTip="In tài liệu này ra máy in hoặc lưu thành file PDF">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨️" Margin="0,0,5,0" />
                            <TextBlock Text="In / Xuất PDF" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Center: Active Document Breadcrumb -->
                <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtActiveDocTitle" Text="Chọn tài liệu từ danh sách bên trái..." FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" />
                </Border>
            </DockPanel>
        </Border>

        <!-- Row 1: Split View (List vs Content) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Col 0: Document List Sidebar (Width: 340) -->
                <ColumnDefinition Width="340" MinWidth="260" MaxWidth="480" />
                <!-- Col 1: Splitter -->
                <ColumnDefinition Width="6" />
                <!-- Col 2: WebBrowser HTML Content Viewer -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Col 0: Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Search Filter Box -->
                    <Border Grid.Row="0" Margin="0,0,0,8" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Margin="2,0,6,0" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBox x:Name="TxtSearchFilter" Grid.Column="1" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" VerticalContentAlignment="Center" FontSize="12" TextChanged="TxtSearchFilter_TextChanged" />
                            <Button x:Name="BtnClearSearch" Grid.Column="2" Content="✕" Width="18" Height="18" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMutedBrush}" Click="BtnClearSearch_Click" Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <!-- Documents ListBox -->
                    <ListBox x:Name="LstDocuments" Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="LstDocuments_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,5" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBd" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,6" SnapsToDevicePixels="True">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBd" Property="Background" Value="#150F5FA8" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBd" Property="Background" Value="#250F5FA8" />
                                                    <Setter TargetName="ItemBd" Property="BorderBrush" Value="#0F5FA8" />
                                                    <Setter TargetName="ItemBd" Property="BorderThickness" Value="1.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Category}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,1" />
                                        <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Footer Info -->
                    <Border Grid.Row="2" Margin="0,8,0,0" Padding="6,4" Background="{DynamicResource DarkBackgroundBrush}" CornerRadius="4">
                        <TextBlock Text="💡 Bấm F1 để mở nhanh Trung tâm tài liệu" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- Col 1: Splitter -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource DarkBorderBrush}" />

            <!-- Col 2: Content Viewer -->
            <Border Grid.Column="2" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="2">
                <WebBrowser x:Name="DocWebBrowser" />
            </Border>
        </Grid>
    </Grid>
</Window>
