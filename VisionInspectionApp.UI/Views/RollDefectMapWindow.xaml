<Window x:Class="VisionInspectionApp.UI.Views.RollDefectMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VisionInspectionApp.UI.Controls"
        Title="Bản Đồ Khuyết Tật Cuộn &amp; Quản Lý Chất Lượng (Roll Defect Map)" 
        Height="720" Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="MetricPill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Header & Metrics Dashboard -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📜" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="BẢN ĐỒ KHUYẾT TẬT CUỘN THỜI GIAN THỰC" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="{Binding Session.RollId, StringFormat='Mã Phiên Cuộn: {0}'}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Metrics badges -->
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Length -->
                    <Border Style="{StaticResource MetricPill}">
                        <StackPanel>
                            <TextBlock Text="CHIỀU DÀI CUỘN" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Session.TotalLengthMeters, StringFormat='{}{0:F2} m'}" FontSize="13" FontWeight="Bold" Foreground="#0288D1"/>
                        </StackPanel>
                    </Border>

                    <!-- Total Defects -->
                    <Border Style="{StaticResource MetricPill}">
                        <StackPanel>
                            <TextBlock Text="TỔNG VẾT LỖI" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TotalDefectsCount}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Rejects -->
                    <Border Style="{StaticResource MetricPill}" Background="#15EF4444" BorderBrush="#EF4444">
                        <StackPanel>
                            <TextBlock Text="REJECTS" FontSize="9.5" FontWeight="Bold" Foreground="#EF4444"/>
                            <TextBlock Text="{Binding RejectCount}" FontSize="13" FontWeight="Bold" Foreground="#EF4444"/>
                        </StackPanel>
                    </Border>

                    <!-- Warnings -->
                    <Border Style="{StaticResource MetricPill}" Background="#15F59E0B" BorderBrush="#F59E0B">
                        <StackPanel>
                            <TextBlock Text="WARNINGS" FontSize="9.5" FontWeight="Bold" Foreground="#F59E0B"/>
                            <TextBlock Text="{Binding WarningCount}" FontSize="13" FontWeight="Bold" Foreground="#F59E0B"/>
                        </StackPanel>
                    </Border>

                    <!-- Yield Rate -->
                    <Border Style="{StaticResource MetricPill}" Background="#1510B981" BorderBrush="#10B981">
                        <StackPanel>
                            <TextBlock Text="TỈ LỆ ĐẠT (YIELD)" FontSize="9.5" FontWeight="Bold" Foreground="#10B981"/>
                            <TextBlock Text="{Binding YieldRate, StringFormat='{}{0:F1} %'}" FontSize="13" FontWeight="Bold" Foreground="#10B981"/>
                        </StackPanel>
                    </Border>

                    <!-- Shift Register Triggered -->
                    <Border Style="{StaticResource MetricPill}">
                        <StackPanel>
                            <TextBlock Text="ĐÃ REJECT (PLC)" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TotalRejectsTriggered, StringFormat='{}{0} lần'}" FontSize="13" FontWeight="Bold" Foreground="#8B5CF6"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Row 1: Main Visualization & Action Sidebar -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- Visual Map Canvas Control -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                        <TextBlock Text="🗺️ Không Gian Bản Đồ Vật Lý Cuộn (Dọc: 0m ➔ L; Ngang: 0 ➔ W mm)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentWebPositionMm, StringFormat='Vị trí quét hiện tại: {0:F1} mm'}" FontSize="11.5" FontWeight="Bold" Foreground="#0288D1"/>
                    </DockPanel>

                    <!-- Embedded custom control RollDefectMapControl -->
                    <Border Grid.Row="1" Background="#0A000000" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <controls:RollDefectMapControl Session="{Binding Session}" CurrentWebPositionMm="{Binding CurrentWebPositionMm}" ClipToBounds="True"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Sidebar: Legend & Action Exporters -->
            <Border Grid.Column="1" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Legend -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="🏷️ Chú Giải Mã Màu" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse Width="12" Height="12" Fill="#EF4444" Margin="0,0,8,0"/>
                            <TextBlock Text="🔴 Reject (Lỗi nặng / Loại bỏ)" FontSize="11.5" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse Width="12" Height="12" Fill="#F59E0B" Margin="0,0,8,0"/>
                            <TextBlock Text="🟡 Warning (Lỗi nhẹ / Cảnh báo)" FontSize="11.5" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Rectangle Width="16" Height="4" Fill="#00E5FF" Margin="0,0,6,0"/>
                            <TextBlock Text="🟦 Vạch quét cuộn thời gian thực" FontSize="11.5" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Separator Grid.Row="1" Margin="0,0,0,14"/>

                    <!-- Action Export Buttons -->
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="📊 Xuất Báo Cáo Chất Lượng" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>

                        <!-- Export HTML Certificate -->
                        <Button Command="{Binding ExportHtmlCommand}" Margin="0,0,0,8" Padding="12,8" Background="#0288D1" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" ToolTip="Xuất Chứng chỉ Kiểm tra Chất lượng Cuộn tiêu chuẩn in ấn / PDF">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖨️" FontSize="14" Margin="0,0,8,0"/>
                                <StackPanel>
                                    <TextBlock Text="Chứng Chỉ HTML" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="Tiêu chuẩn in ấn / PDF" FontSize="10" Opacity="0.85"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- Export CSV Cut List -->
                        <Button Command="{Binding ExportCsvCommand}" Margin="0,0,0,8" Padding="12,8" Background="#10B981" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" ToolTip="Xuất bảng tọa độ vết lỗi Cut List cho máy xả cuộn">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="14" Margin="0,0,8,0"/>
                                <StackPanel>
                                    <TextBlock Text="CSV Cut List" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="Tọa độ cắt cho máy xả cuộn" FontSize="10" Opacity="0.85"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- Export JSON Data -->
                        <Button Command="{Binding ExportJsonCommand}" Margin="0,0,0,8" Padding="12,8" Background="#6366F1" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" ToolTip="Xuất toàn bộ cấu trúc dữ liệu JSON thô">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄" FontSize="14" Margin="0,0,8,0"/>
                                <StackPanel>
                                    <TextBlock Text="Dữ Liệu JSON" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="Lưu trữ cấu trúc dữ liệu gốc" FontSize="10" Opacity="0.85"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Reset Session Button -->
                    <Button Grid.Row="3" Command="{Binding ResetSessionCommand}" Padding="12,8" Background="#4B5563" Foreground="White" BorderThickness="0" ToolTip="Khởi tạo phiên cuộn mới và reset bộ đếm mét dài">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🔄" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Bắt Đầu Cuộn Mới" FontWeight="Bold" FontSize="11.5"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 2: Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,10,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding PendingRejectCount, StringFormat='Lỗi đang chờ tới trạm Reject: {0}'}" FontSize="11.5" FontWeight="SemiBold" Foreground="#F59E0B" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
