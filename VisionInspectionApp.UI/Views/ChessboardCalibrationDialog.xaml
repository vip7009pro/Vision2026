<Window x:Class="VisionInspectionApp.UI.Views.ChessboardCalibrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VisionInspectionApp.UI.Controls"
        Title="{Binding WindowTitle}"
        Loaded="OnWindowLoaded"
        Closing="OnWindowClosing"
        Height="800" Width="1220"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER BANNER: Mode & Camera Status -->
        <Border Grid.Row="0" Margin="0,0,0,8" Padding="10,6" CornerRadius="4" Background="#1E293B" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ModeBadgeText}" FontWeight="ExtraBold" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Luồng Camera:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Border CornerRadius="3" Padding="8,2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#475569" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLiveActive}" Value="True">
                                        <Setter Property="Background" Value="#15803D" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontWeight="Bold" FontSize="11" Foreground="White">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="⏸ TẠM DỪNG" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLiveActive}" Value="True">
                                            <Setter Property="Text" Value="🔴 LIVE CAMERA" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                <StackPanel>
                    <!-- GLOBAL CALIBRATION POLICY -->
                    <Border BorderBrush="#F59E0B" BorderThickness="1.5" CornerRadius="4" Padding="10,8" Margin="0,0,0,8" Background="#1E293B">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding ForceApplyGlobalCalibration, Mode=TwoWay}"
                                      Foreground="#FDE68A" FontWeight="Bold" FontSize="12"
                                      ToolTip="Khi được checked, tất cả các job khi chạy sẽ áp dụng global calib, bất kể job có thông số hiệu chuẩn riêng hay không.">
                                <TextBlock Text="Cưỡng chế sử dụng global calibration" TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock Text="Khi bật: Tất cả các job khi chạy sẽ áp dụng global calib, bất kể job có thông số hiệu chuẩn riêng hay không."
                                       Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="22,3,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Settings -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8" Background="{DynamicResource PanelBackgroundBrush}">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" Text="⚙ THIẾT LẬP CHESSBOARD" Margin="0,0,0,6" Foreground="{DynamicResource TextBrush}" />

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Số cột ô vuông (Cols)" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                                <TextBox Grid.Column="1" Text="{Binding BoardCols, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="2" Text="" VerticalAlignment="Center" Margin="4,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Số hàng ô vuông (Rows)" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                                <TextBox Grid.Column="1" Text="{Binding BoardRows, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="2" Text="" VerticalAlignment="Center" Margin="4,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cạnh ô vuông (mm)" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                                <TextBox Grid.Column="1" Text="{Binding SquareSizeMmText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="4,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Quy ước nhập" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                                <ComboBox Grid.Column="1" SelectedIndex="{Binding PatternConventionIndex}" ToolTip="Chọn quy ước nhập số góc hay số ô cờ">
                                    <ComboBoxItem Content="Số góc trong (Corners)" ToolTip="Khuyên dùng: ví dụ bàn cờ 9×6 điểm góc thì nhập 9 và 6" />
                                    <ComboBoxItem Content="Số ô cờ (Squares)" ToolTip="Nhập số ô: hệ thống tự trừ 1 để ra số góc" />
                                </ComboBox>
                            </Grid>

                            <CheckBox IsChecked="{Binding AutoSwapDimensions}" Content="Tự động thử xoay 90° (W×H &amp; H×W)" Margin="0,4,0,2" Foreground="{DynamicResource TextBrush}" ToolTip="Tự động thử cả 2 chiều, chống trường hợp xoay dọc bàn cờ" />
                            <CheckBox IsChecked="{Binding UseEnhancedSectorBased}" Content="Dò nhạy cao (Sector-Based SB + CLAHE)" Margin="0,2,0,4" Foreground="{DynamicResource TextBrush}" ToolTip="Thuật toán OpenCV 4 hiện đại: tự động sub-pixel, chống chênh lệch sáng và méo góc rộng" />

                            <Border Background="#0A2540" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,4,0,0">
                                <TextBlock FontSize="11" Foreground="#00E5FF" FontWeight="SemiBold">
                                    <Run Text="🎯 Mục tiêu dò: " />
                                    <Run Text="{Binding InnerCornersX, Mode=OneWay}" FontWeight="Bold" />
                                    <Run Text=" × " />
                                    <Run Text="{Binding InnerCornersY, Mode=OneWay}" FontWeight="Bold" />
                                    <Run Text=" góc trong (Inner corners)" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Capture & Live Controls -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8" Background="{DynamicResource PanelBackgroundBrush}">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" Text="📷 CAMERA &amp; LIVESTREAM" Margin="0,0,0,6" Foreground="{DynamicResource TextBrush}" />

                            <!-- Progress indicator khi đang xử lý phân tích ảnh -->
                            <ProgressBar Height="4" IsIndeterminate="True" Margin="0,0,0,6" Foreground="#00E5FF"
                                         Visibility="{Binding IsDetecting, Converter={StaticResource BoolToVis}}" />
                            
                            <WrapPanel Margin="0,0,0,4">
                                <Button Command="{Binding ToggleLiveStreamCommand}" Margin="0,0,6,4" Padding="10,5" FontWeight="Bold">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="#37474F" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="Content" Value="▶ Bật Live Camera" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLiveActive}" Value="True">
                                                    <Setter Property="Background" Value="#C62828" />
                                                    <Setter Property="Content" Value="🔴 Đang Live (Dừng)" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="📸 Chụp Khung Hình" Command="{Binding SnapFrameCommand}" IsEnabled="{Binding IsNotDetecting}" Margin="0,0,0,4" Padding="10,5" FontWeight="SemiBold" ToolTip="Dừng livestream và phân tích corners khung hình hiện tại" />
                            </WrapPanel>

                            <WrapPanel>
                                <Button Content="⚡ Chụp &amp; Thêm Nhanh" Command="{Binding SnapAndAddCaptureCommand}" IsEnabled="{Binding IsNotDetecting}" Margin="0,0,6,4" Padding="10,5" Background="#2E7D32" Foreground="White" FontWeight="Bold" ToolTip="Chụp, nhận diện corners và thêm ngay vào danh sách ảnh Calib mà không dừng Live" />
                                <Button Content="📂 Load File" Command="{Binding LoadImageCommand}" IsEnabled="{Binding IsNotDetecting}" Margin="0,0,6,4" Padding="8,5" />
                                <Button Content="➕ Thêm ảnh" Command="{Binding AddCaptureCommand}" IsEnabled="{Binding IsNotDetecting}" Margin="0,0,0,4" Padding="8,5" Background="#1565C0" Foreground="White" FontWeight="Bold" ToolTip="Thêm ảnh tĩnh hiện tại vào danh sách calib" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Captures list -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8" Background="{DynamicResource PanelBackgroundBrush}">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" Margin="0,0,0,6" Foreground="{DynamicResource TextBrush}">
                                <Run Text="📋 ẢNH ĐÃ CHỤP (" />
                                <Run Text="{Binding Captures.Count, Mode=OneWay}" />
                                <Run Text=" ảnh)" />
                            </TextBlock>
                            <ListBox ItemsSource="{Binding Captures}" MaxHeight="200" MinHeight="60" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0" Source="{Binding Thumbnail}" Width="50" Height="38" Stretch="Uniform" Margin="0,0,6,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock FontWeight="Bold">
                                                    <Run Text="#" /><Run Text="{Binding Index, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" 
                                                           Foreground="{Binding StatusBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="✖" 
                                                    Command="{Binding DataContext.RemoveCaptureCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                    CommandParameter="{Binding}" 
                                                    VerticalAlignment="Center" Padding="6,2" FontSize="10" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Content="🗑 Clear All" Command="{Binding ClearAllCommand}" Margin="0,6,0,0" Padding="8,4" />
                        </StackPanel>
                    </Border>

                    <!-- Calibrate -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8" Background="{DynamicResource PanelBackgroundBrush}">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" Text="🔧 CALIBRATE" Margin="0,0,0,6" Foreground="{DynamicResource TextBrush}" />
                            <Button Content="▶ Calibrate Camera (≥ 3 ảnh)" Command="{Binding CalibrateCommand}" 
                                    Padding="12,6" Background="#1565C0" Foreground="White" FontWeight="Bold" FontSize="13" />
                        </StackPanel>
                    </Border>

                    <!-- Results -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8" Background="{DynamicResource PanelBackgroundBrush}">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" Text="📊 KẾT QUẢ CALIBRATION" Margin="0,0,0,6" Foreground="{DynamicResource TextBrush}" />

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Reprojection Err:" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding ReprojectionError, StringFormat={}{0:F4} px}" Foreground="{DynamicResource TextBrush}" />
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Pixels / mm:" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding PixelsPerMm, StringFormat={}{0:F4}}" Foreground="#4CAF50" FontWeight="Bold" FontSize="14" />
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Focal (fx, fy):" Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Grid.Column="1" Foreground="{DynamicResource TextBrush}">
                                    <Run Text="{Binding FocalX, StringFormat={}{0:F2}}" />
                                    <Run Text=", " />
                                    <Run Text="{Binding FocalY, StringFormat={}{0:F2}}" />
                                </TextBlock>
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Principal (cx, cy):" Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Grid.Column="1" Foreground="{DynamicResource TextBrush}">
                                    <Run Text="{Binding PrincipalX, StringFormat={}{0:F2}}" />
                                    <Run Text=", " />
                                    <Run Text="{Binding PrincipalY, StringFormat={}{0:F2}}" />
                                </TextBlock>
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Distortion:" Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding DistCoeffsText}" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" FontSize="10" />
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="🔄 Undistort Preview" Command="{Binding UndistortPreviewCommand}" Padding="6,5" ToolTip="Xem thử ảnh sau khi khử biến dạng ống kính" />
                                <Button Grid.Column="2" Content="🌐 Set As Global Calib" Command="{Binding SetAsGlobalCalibrationCommand}" Padding="6,5" Background="#1565C0" Foreground="White" FontWeight="SemiBold" ToolTip="Lưu bộ thông số hiệu chuẩn này làm cấu hình Global mặc định cho toàn bộ ứng dụng (tự động áp dụng cho các Job mới hoặc Job chưa có calib)" />
                            </Grid>

                            <!-- Nút áp dụng Global Calib vào Job đang mở (nếu có Job đang mở) -->
                            <Button Content="📥 Áp Dụng Global Calib Vào Job Đang Mở" 
                                    Command="{Binding ApplyGlobalToJobCommand}" 
                                    Visibility="{Binding HasActiveJob, Converter={StaticResource BoolToVis}}"
                                    Margin="0,6,0,0" Padding="8,7" 
                                    Background="#0D9488" Foreground="White" FontWeight="Bold"
                                    ToolTip="Áp dụng ngay bộ thông số Global Calibration đã lưu trên máy tính này vào Job đang mở (Focal, Distortion, Pixels/mm)" />
                        </StackPanel>
                    </Border>

                    <!-- Status -->
                    <Border Background="#1A1A2E" Padding="8" CornerRadius="4">
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#E0E0E0" FontSize="11" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT PANEL: Image Preview -->
            <controls:ImageViewerControl Grid.Column="1"
                                         ImageSource="{Binding Image}"
                                         OverlayItems="{Binding OverlayItems}" />
        </Grid>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="✅ Áp Dụng &amp; Đóng" Click="OnApplyClicked" Background="#2E7D32" Foreground="White" Padding="14,6" FontWeight="Bold" Margin="0,0,8,0" />
            <Button Content="❌ Đóng" Click="OnCloseClicked" Padding="14,6" />
        </StackPanel>
    </Grid>
</Window>
