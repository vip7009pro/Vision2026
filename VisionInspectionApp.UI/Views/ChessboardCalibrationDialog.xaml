<Window x:Class="VisionInspectionApp.UI.Views.ChessboardCalibrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VisionInspectionApp.UI.Controls"
        Title="♟ Hiệu Chuẩn Camera Chessboard (Chessboard Camera Calibration)"
        Height="780" Width="1200"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                <StackPanel>
                    <!-- Settings -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8" Background="{DynamicResource PanelBackgroundBrush}">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" Text="⚙ THIẾT LẬP CHESSBOARD" Margin="0,0,0,6" Foreground="{DynamicResource TextBrush}" />

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Số cột ô vuông (Cols)" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                                <TextBox Grid.Column="1" Text="{Binding BoardCols, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="2" Text="" VerticalAlignment="Center" Margin="4,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Số hàng ô vuông (Rows)" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                                <TextBox Grid.Column="1" Text="{Binding BoardRows, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="2" Text="" VerticalAlignment="Center" Margin="4,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cạnh ô vuông (mm)" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                                <TextBox Grid.Column="1" Text="{Binding SquareSizeMm, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="4,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>

                            <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="Gray">
                                <Run Text="Inner corners: " />
                                <Run Text="{Binding InnerCornersX, Mode=OneWay}" />
                                <Run Text=" × " />
                                <Run Text="{Binding InnerCornersY, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Capture -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8" Background="{DynamicResource PanelBackgroundBrush}">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" Text="📷 CHỤP / NẠP ẢNH" Margin="0,0,0,6" Foreground="{DynamicResource TextBrush}" />
                            <WrapPanel>
                                <Button Content="📂 Load Image" Command="{Binding LoadImageCommand}" Margin="0,0,6,4" Padding="10,5" />
                                <Button Content="📷 Camera" Command="{Binding CaptureCameraCommand}" Margin="0,0,6,4" Padding="10,5" />
                                <Button Content="➕ Thêm ảnh" Command="{Binding AddCaptureCommand}" Margin="0,0,0,4" Padding="10,5" Background="#2E7D32" Foreground="White" FontWeight="Bold" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Captures list -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8" Background="{DynamicResource PanelBackgroundBrush}">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" Margin="0,0,0,6" Foreground="{DynamicResource TextBrush}">
                                <Run Text="📋 ẢNH ĐÃ CHỤP (" />
                                <Run Text="{Binding Captures.Count, Mode=OneWay}" />
                                <Run Text=" ảnh)" />
                            </TextBlock>
                            <ListBox ItemsSource="{Binding Captures}" MaxHeight="200" MinHeight="60" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0" Source="{Binding Thumbnail}" Width="50" Height="38" Stretch="Uniform" Margin="0,0,6,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock FontWeight="Bold">
                                                    <Run Text="#" /><Run Text="{Binding Index, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" 
                                                           Foreground="{Binding StatusBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="✖" 
                                                    Command="{Binding DataContext.RemoveCaptureCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                    CommandParameter="{Binding}" 
                                                    VerticalAlignment="Center" Padding="6,2" FontSize="10" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Content="🗑 Clear All" Command="{Binding ClearAllCommand}" Margin="0,6,0,0" Padding="8,4" />
                        </StackPanel>
                    </Border>

                    <!-- Calibrate -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8" Background="{DynamicResource PanelBackgroundBrush}">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" Text="🔧 CALIBRATE" Margin="0,0,0,6" Foreground="{DynamicResource TextBrush}" />
                            <Button Content="▶ Calibrate Camera (≥ 3 ảnh)" Command="{Binding CalibrateCommand}" 
                                    Padding="12,6" Background="#1565C0" Foreground="White" FontWeight="Bold" FontSize="13" />
                        </StackPanel>
                    </Border>

                    <!-- Results -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8" Background="{DynamicResource PanelBackgroundBrush}">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" Text="📊 KẾT QUẢ CALIBRATION" Margin="0,0,0,6" Foreground="{DynamicResource TextBrush}" />

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Reprojection Err:" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding ReprojectionError, StringFormat={}{0:F4} px}" Foreground="{DynamicResource TextBrush}" />
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Pixels / mm:" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding PixelsPerMm, StringFormat={}{0:F4}}" Foreground="#4CAF50" FontWeight="Bold" FontSize="14" />
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Focal (fx, fy):" Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Grid.Column="1" Foreground="{DynamicResource TextBrush}">
                                    <Run Text="{Binding FocalX, StringFormat={}{0:F2}}" />
                                    <Run Text=", " />
                                    <Run Text="{Binding FocalY, StringFormat={}{0:F2}}" />
                                </TextBlock>
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Principal (cx, cy):" Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Grid.Column="1" Foreground="{DynamicResource TextBrush}">
                                    <Run Text="{Binding PrincipalX, StringFormat={}{0:F2}}" />
                                    <Run Text=", " />
                                    <Run Text="{Binding PrincipalY, StringFormat={}{0:F2}}" />
                                </TextBlock>
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Distortion:" Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding DistCoeffsText}" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" FontSize="10" />
                            </Grid>

                            <Button Content="🔄 Undistort Preview" Command="{Binding UndistortPreviewCommand}" Margin="0,8,0,0" Padding="10,5" />
                        </StackPanel>
                    </Border>

                    <!-- Status -->
                    <Border Background="#1A1A2E" Padding="8" CornerRadius="4">
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#E0E0E0" FontSize="11" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT PANEL: Image Preview -->
            <controls:ImageViewerControl Grid.Column="1"
                                         ImageSource="{Binding Image}"
                                         OverlayItems="{Binding OverlayItems}" />
        </Grid>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="✅ Áp Dụng &amp; Đóng" Click="OnApplyClicked" Background="#2E7D32" Foreground="White" Padding="14,6" FontWeight="Bold" Margin="0,0,8,0" />
            <Button Content="❌ Đóng" Click="OnCloseClicked" Padding="14,6" />
        </StackPanel>
    </Grid>
</Window>
