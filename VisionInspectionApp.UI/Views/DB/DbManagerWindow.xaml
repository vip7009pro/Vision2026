<Window x:Class="VisionInspectionApp.UI.Views.DB.DbManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="RootDbManagerWindow"
        Title="🗄️ Database Manager &amp; Connections" Height="580" Width="860"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Databases List -->
        <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Databases List" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" Foreground="{DynamicResource TextBrush}"/>

                <ListBox Grid.Row="1" ItemsSource="{Binding Databases}" SelectedItem="{Binding SelectedDb, Mode=TwoWay}" DisplayMemberPath="Name" Margin="0,0,0,8" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource InputTextBrush}"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="➕ Add DB" Command="{Binding AddDbCommand}" Padding="8,4" Margin="0,0,4,0"/>
                    <Button Content="🗑 Delete" Command="{Binding DeleteDbCommand}" Padding="8,4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right: DB Configuration & Test -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- DB Settings Form -->
            <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Row 0: DB Name & Provider Type -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Database Name:" VerticalAlignment="Center" Margin="0,4" Foreground="{DynamicResource TextBrush}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDb.Name, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="DB Type:" VerticalAlignment="Center" Margin="8,4,0,4" Foreground="{DynamicResource TextBrush}"/>
                        <ComboBox Grid.Row="0" Grid.Column="3" ItemsSource="{Binding ProviderTypes}" SelectedItem="{Binding SelectedDb.ProviderType, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>

                        <!-- Row 1: Server / Host & Port -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Server / Host:" VerticalAlignment="Center" Margin="0,4" Foreground="{DynamicResource TextBrush}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDb.Server, UpdateSourceTrigger=PropertyChanged}" Margin="2" ToolTip="IP Address, Hostname, or file path for SQLite"/>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Port:" VerticalAlignment="Center" Margin="8,4,0,4" Foreground="{DynamicResource TextBrush}"/>
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SelectedDb.Port, UpdateSourceTrigger=PropertyChanged}" Margin="2" ToolTip="{Binding SelectedDb.DefaultPortText}"/>

                        <!-- Row 2: Database / Catalog Name -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Database Name:" VerticalAlignment="Center" Margin="0,4" Foreground="{DynamicResource TextBrush}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding SelectedDb.DatabaseName, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>

                        <!-- Row 3: Username & Password -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Username:" VerticalAlignment="Center" Margin="0,4" Foreground="{DynamicResource TextBrush}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedDb.Username, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>

                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Password:" VerticalAlignment="Center" Margin="8,4,0,4" Foreground="{DynamicResource TextBrush}"/>
                        <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding SelectedDb.Password, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>

                        <!-- Row 4: Timeout & Enabled -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Timeout (s):" VerticalAlignment="Center" Margin="0,4" Foreground="{DynamicResource TextBrush}"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedDb.ConnectionTimeout, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>

                        <CheckBox Grid.Row="4" Grid.Column="3" Content="Enable Database Connection" IsChecked="{Binding SelectedDb.IsEnabled}" VerticalAlignment="Center" Margin="2" Foreground="{DynamicResource TextBrush}"/>

                        <!-- Row 5: Custom Connection String Override -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Custom ConnStr:" VerticalAlignment="Top" Margin="0,6" Foreground="{DynamicResource TextBrush}"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding SelectedDb.ConnectionString, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="50" Margin="2" ToolTip="Leave empty to use auto-generated connection string above"/>

                        <!-- Row 6: Auto Connection String Preview -->
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Build ConnStr:" VerticalAlignment="Center" Margin="0,4" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding SelectedDb.BuildConnectionString, Mode=OneWay}" IsReadOnly="True" Background="#10000000" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="2"/>

                        <!-- Row 7: Action Row -->
                        <DockPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,12,0,0">
                            <Border DockPanel.Dock="Left" Padding="8,4" CornerRadius="4" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#424242"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDb.State}" Value="Connected">
                                                <Setter Property="Background" Value="#2E7D32"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedDb.State}" Value="Error">
                                                <Setter Property="Background" Value="#C62828"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedDb.State}" Value="Testing...">
                                                <Setter Property="Background" Value="#F57C00"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding SelectedDb.State}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                            </Border>

                            <Button DockPanel.Dock="Left" Content="⚡ Test Connection" Command="{Binding TestConnectionCommand}" Padding="10,4" Margin="10,0,0,0"/>

                            <TextBlock Text="{Binding TestStatusMessage}" VerticalAlignment="Center" Margin="10,0" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Bottom Save / Close buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button Content="💾 Save Config &amp; Close" Command="{Binding SaveCommand}" Padding="12,6" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
