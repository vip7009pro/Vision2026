<Window x:Class="VisionInspectionApp.UI.Views.OQC.JobManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🌐 Quản Lý &amp; Huấn Luyện (Teaching) Job Từ Xa Qua Server XAMPP (PHP)"
        Height="760" Width="1180"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header Card -->
        <Border Grid.Row="0" Margin="0,0,0,10" Padding="12,10" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <TextBlock Text="🌐 " FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock Text="Quản Lý &amp; Huấn Luyện (Teaching) Job Từ Xa" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="Đồng bộ ảnh mẫu, tệp Job và cấu hình kiểm tra thị giác giữa máy OQC và máy chủ Web XAMPP." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Server Status & Actions on Header -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ServerStatusText}" Foreground="{Binding ServerStatusBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text=" (" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ServerApiUrl}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text=")" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding PingServerCommand}" ToolTip="Kiểm tra kết nối tới Server API" Height="28" Padding="8,2" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡ Ping Server" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding RefreshListCommand}" ToolTip="Làm mới danh sách từ CSDL" Height="28" Padding="8,2" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄 Làm Mới" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenSettingsCommand}" ToolTip="Cài đặt kết nối máy chủ và CSDL" Height="28" Padding="8,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️ Cài Đặt" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Main Content (2 Columns: Left = DataGrid & Action Toolbar, Right = Teach Preview & Quick Panel) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Action Toolbar & Products DataGrid -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Search & Action Toolbar -->
                <Border Grid.Row="0" Margin="0,0,0,8" Padding="8,6" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Search Bar -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="True">
                            <Button Content="🔍 Tìm Kiếm" Command="{Binding SearchCommand}" DockPanel.Dock="Right" Width="90" Height="26" Margin="6,0,0,0" FontWeight="SemiBold" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center" Padding="4,0">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>

                        <!-- Actions Toolbar -->
                        <WrapPanel Grid.Row="1" Orientation="Horizontal">
                            <!-- Remote Teach Button (Highlighted) -->
                            <Button Command="{Binding RemoteTeachCommand}"
                                    Background="#2E7D32" Foreground="White" FontWeight="Bold"
                                    Padding="10,4" Margin="0,0,6,4" Height="30" Cursor="Hand"
                                    ToolTip="Nạp ảnh mẫu từ Server vào Tool Editor để huấn luyện và cấu hình Job từ xa">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌐 " />
                                    <TextBlock Text="Huấn Luyện Từ Xa (Remote Teach)" />
                                </StackPanel>
                            </Button>

                            <!-- Gán Mã Mới (Tra cứu từ Master DB) -->
                            <Button Command="{Binding OpenProductAssignCommand}"
                                    Background="#0288D1" Foreground="White" FontWeight="Bold"
                                    Padding="10,4" Margin="0,0,6,4" Height="30" Cursor="Hand"
                                    ToolTip="Tra cứu danh mục sản phẩm từ CSDL và gán mã sản phẩm mới cho tệp Job">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="➕ " />
                                    <TextBlock Text="Gán Mã Mới" />
                                </StackPanel>
                            </Button>

                            <!-- Gán Job Đang Mở Cho SP Đang Chọn -->
                            <Button Command="{Binding AssignCurrentActiveJobCommand}"
                                    Background="#00838F" Foreground="White" FontWeight="SemiBold"
                                    Padding="8,4" Margin="0,0,6,4" Height="30" Cursor="Hand"
                                    ToolTip="Gán tệp Job đang mở trong Tool Editor cho sản phẩm đang chọn trong danh sách">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔗 " />
                                    <TextBlock Text="Gán Job Đang Mở" />
                                </StackPanel>
                            </Button>

                            <!-- Upload Teach Camera -->
                            <Button Command="{Binding UploadTeachFromCameraCommand}"
                                    Background="#1565C0" Foreground="White" FontWeight="SemiBold"
                                    Padding="8,4" Margin="0,0,6,4" Height="30" Cursor="Hand"
                                    ToolTip="Chụp ảnh từ Camera hiện tại và tải lên Server làm Teach Image">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📸 " />
                                    <TextBlock Text="Chụp Ảnh Mẫu (Camera)" />
                                </StackPanel>
                            </Button>

                            <!-- Upload Teach File -->
                            <Button Command="{Binding UploadTeachFromFileCommand}"
                                    Padding="8,4" Margin="0,0,6,4" Height="30" Cursor="Hand"
                                    ToolTip="Chọn ảnh từ file và tải lên Server làm Teach Image">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁 " />
                                    <TextBlock Text="Tải Ảnh Từ File" />
                                </StackPanel>
                            </Button>

                            <!-- Open Job from List -->
                            <Button Command="{Binding OpenJobFromListCommand}"
                                    Background="#007ACC" Foreground="White" FontWeight="Bold"
                                    Padding="10,4" Margin="0,0,6,4" Height="30" Cursor="Hand"
                                    ToolTip="Mở tệp Job của sản phẩm đang chọn trong Tool Editor (tự động tải về thư mục mặc định nếu chưa có)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📂 " />
                                    <TextBlock Text="Mở Job Này" />
                                </StackPanel>
                            </Button>

                            <!-- Upload Job -->
                            <Button Command="{Binding UploadCurrentJobCommand}"
                                    Background="#E65100" Foreground="White" FontWeight="SemiBold"
                                    Padding="8,4" Margin="0,0,6,4" Height="30" Cursor="Hand"
                                    ToolTip="Tải tệp Job (.job) hiện tại lên Server và tự động cập nhật liên kết CSDL">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📤 " />
                                    <TextBlock Text="Tải Job Lên Server" />
                                </StackPanel>
                            </Button>

                            <!-- Download Job -->
                            <Button Command="{Binding DownloadJobCommand}"
                                    Padding="8,4" Margin="0,0,6,4" Height="30" Cursor="Hand"
                                    ToolTip="Tải tệp Job từ Server về máy cục bộ và mở vào Tool Editor">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📥 " />
                                    <TextBlock Text="Tải Job Về" />
                                </StackPanel>
                            </Button>

                            <!-- Assign Local Job -->
                            <Button Command="{Binding AssignLocalJobCommand}"
                                    Padding="8,4" Margin="0,0,6,4" Height="30" Cursor="Hand"
                                    ToolTip="Gán file Job cục bộ cho sản phẩm đang chọn trong CSDL">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📋 " />
                                    <TextBlock Text="Gán Job Cục Bộ" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- Products DataGrid -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          Background="{DynamicResource PanelBackgroundBrush}"
                          Foreground="{DynamicResource TextBrush}">
                    <DataGrid.ItemContainerStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <EventSetter Event="MouseDoubleClick" Handler="OnDataGridRowMouseDoubleClick" />
                        </Style>
                    </DataGrid.ItemContainerStyle>
                    <DataGrid.Columns>
                        <!-- Mã Sản Phẩm -->
                        <DataGridTextColumn Header="Mã SP (ProductCode)" Binding="{Binding ProductCode}" Width="150" FontWeight="Bold" />
                        
                        <!-- Tên Sản Phẩm -->
                        <DataGridTextColumn Header="Tên SP (ProductName)" Binding="{Binding ProductName}" Width="180" />

                        <!-- Trạng thái Job File -->
                        <DataGridTemplateColumn Header="Tệp Job" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="3" Padding="6,2" Margin="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#424242" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasJobFile}" Value="True">
                                                        <Setter Property="Background" Value="#1B5E20" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock TextAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="White">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="⚠️ Chưa có" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasJobFile}" Value="True">
                                                            <Setter Property="Text" Value="✅ Đã có Job" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Trạng thái Ảnh Mẫu Teach -->
                        <DataGridTemplateColumn Header="Ảnh Mẫu (Teach)" Width="125">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="3" Padding="6,2" Margin="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#424242" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasTeachImage}" Value="True">
                                                        <Setter Property="Background" Value="#4A148C" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock TextAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="White">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="— Chưa có" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasTeachImage}" Value="True">
                                                            <Setter Property="Text" Value="📷 Có Ảnh Mẫu" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Đường Dẫn Job -->
                        <DataGridTextColumn Header="Đường Dẫn Job" Binding="{Binding JobFilePath}" Width="160" />

                        <!-- Đường Dẫn Ảnh Mẫu -->
                        <DataGridTextColumn Header="Đường Dẫn Ảnh Mẫu" Binding="{Binding TeachImagePath}" Width="160" />

                        <!-- Ngày Cập Nhật -->
                        <DataGridTextColumn Header="Ngày Cập Nhật" Binding="{Binding UpdatedAt}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Pagination Bar -->
                <Border Grid.Row="2" Margin="0,6,0,0" Padding="4">
                    <DockPanel LastChildFill="False">
                        <Button Content="◀ Trang trước" Command="{Binding PrevPageCommand}" DockPanel.Dock="Left" Width="100" Height="26" />
                        <Button Content="Trang sau ▶" Command="{Binding NextPageCommand}" DockPanel.Dock="Right" Width="100" Height="26" />
                        <TextBlock Text="{Binding PageIndicatorText}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Grid Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}" />

            <!-- RIGHT: Teach Image Preview & Selected Item Details -->
            <Border Grid.Column="2" Padding="8" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Header Preview -->
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="🖼️ Ảnh Mẫu (Teaching Image Preview)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                            <Button Command="{Binding RefreshTeachImageCommand}"
                                    DockPanel.Dock="Right" HorizontalAlignment="Right"
                                    Padding="8,3" Height="26" FontSize="11" Cursor="Hand"
                                    ToolTip="Tải lại ảnh mẫu mới nhất từ Server (bỏ qua cache)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄 " FontSize="11" />
                                    <TextBlock Text="Làm Mới Ảnh" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <!-- Image Preview Box -->
                        <Border Background="#1E1E1E" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Height="240" Margin="0,0,0,10">
                            <Grid>
                                <Image Source="{Binding SelectedTeachImagePreview}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                
                                <!-- Empty Notice -->
                                <TextBlock Text="Chưa có ảnh mẫu xem trước"
                                           Foreground="#888888" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding SelectedTeachImagePreview, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            </Grid>
                        </Border>

                        <!-- Selected Item Details -->
                        <GroupBox Header="Thông tin sản phẩm đang chọn" Padding="8" Margin="0,0,0,10" Foreground="{DynamicResource TextBrush}">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Mã SP:" FontWeight="SemiBold" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedItem.ProductCode}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextBrush}" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tên SP:" FontWeight="SemiBold" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedItem.ProductName}" FontSize="11" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tệp Job:" FontWeight="SemiBold" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedItem.JobFilePath}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ảnh Mẫu:" FontWeight="SemiBold" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedItem.TeachImagePath}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- Big Action Buttons in Details Panel -->
                        <StackPanel Margin="0,4,0,0">
                            <Button Command="{Binding OpenJobFromListCommand}"
                                    Background="#007ACC" Foreground="White" FontWeight="Bold"
                                    Height="36" Margin="0,0,0,6" Cursor="Hand"
                                    ToolTip="Mở tệp Job của sản phẩm đang chọn, giữ nguyên cấu hình gốc (không đổi ImageSource)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📂 " FontSize="14" />
                                    <TextBlock Text="Mở Tệp Job Này" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding RemoteTeachCommand}"
                                    Background="#2E7D32" Foreground="White" FontWeight="Bold"
                                    Height="36" Margin="0,0,0,6" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌐 " FontSize="14" />
                                    <TextBlock Text="Huấn Luyện Từ Xa (Remote Teach)" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding OpenProductAssignCommand}"
                                    Background="#0288D1" Foreground="White" FontWeight="Bold"
                                    Height="32" Margin="0,0,0,6" Cursor="Hand"
                                    ToolTip="Tra cứu danh mục sản phẩm từ CSDL và gán mã sản phẩm mới">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="➕ " FontSize="13" />
                                    <TextBlock Text="Gán Mã Sản Phẩm Mới (Assign Code)" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding AssignCurrentActiveJobCommand}"
                                    Background="#00838F" Foreground="White" FontWeight="SemiBold"
                                    Height="32" Margin="0,0,0,6" Cursor="Hand"
                                    ToolTip="Gán tệp Job đang mở trong Tool Editor cho sản phẩm này">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔗 " FontSize="13" />
                                    <TextBlock Text="Gán Job Đang Mở Cho SP Này" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding UploadTeachFromCameraCommand}"
                                    Background="#1565C0" Foreground="White" FontWeight="SemiBold"
                                    Height="32" Margin="0,0,0,6" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📸 " />
                                    <TextBlock Text="Chụp Ảnh Mẫu &amp; Tải Lên Server" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding UploadCurrentJobCommand}"
                                    Background="#E65100" Foreground="White" FontWeight="SemiBold"
                                    Height="32" Margin="0,0,0,6" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📤 " />
                                    <TextBlock Text="Tải Job Hiện Tại Lên Server" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 3. Footer Status Bar -->
        <Border Grid.Row="2" Margin="0,8,0,0" Padding="8,4" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="4">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <ProgressBar IsIndeterminate="True" Width="80" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BusyMessage}" FontSize="11" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
