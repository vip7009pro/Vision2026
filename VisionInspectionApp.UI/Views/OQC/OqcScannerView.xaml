<UserControl x:Class="VisionInspectionApp.UI.Views.OQC.OqcScannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:VisionInspectionApp.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding EnableLiveCameraCommand}" />
        <KeyBinding Key="Space" Command="{Binding ScanFromCameraCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="BoldStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CenterStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RightStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="BoldRightStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Main Content Area with Blur Effect when loading -->
        <Grid x:Name="MainContentGrid" Margin="10,8,10,10">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoadingPopupVisible}" Value="True">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <BlurEffect Radius="14" RenderingBias="Quality" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Row 0: Compact Control Toolbar (Header, Input, Mode Checkboxes & Actions in 1 Sleek Bar) -->
            <Border Grid.Row="0" Margin="0,0,0,6" Padding="8,6" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <DockPanel LastChildFill="True">
                    <!-- Left: Sleek Badge Title -->
                    <Border DockPanel.Dock="Left" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📷" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="OQC SCANNER" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Right: Action Buttons -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button Content="{Binding CameraScanButtonText}"
                                Command="{Binding ScanFromCameraCommand}"
                                Height="30" Padding="10,0" Margin="0,0,6,0"
                                FontSize="11.5" FontWeight="Bold"
                                Background="#1976D2" Foreground="White" BorderThickness="0"
                                ToolTip="Chụp ảnh Camera, tự động đọc mã QR/Barcode, lọc loại mã, độ dài, cắt chuỗi và nạp/chạy Job (Phím Space / F12)." />

                        <Button Content="{Binding ScanButtonText}"
                                Command="{Binding ScanCommand}"
                                Height="30" Padding="12,0" Margin="0,0,6,0"
                                FontSize="12" FontWeight="Bold"
                                Background="#2E7D32" Foreground="White" BorderThickness="0"
                                ToolTip="Tra cứu mã / Quét mã và thực thi kiểm tra (Phím Enter)." />

                        <Button Content="📸 Tải Ảnh Mẫu"
                                Command="{Binding QuickCaptureAndUploadTeachImageCommand}"
                                Height="30" Padding="8,0" Margin="0,0,6,0"
                                FontSize="11.5" FontWeight="SemiBold"
                                Background="#00897B" Foreground="White" BorderThickness="0"
                                ToolTip="Chụp khung hình hiện tại và tải lên Server XAMPP làm ảnh mẫu huấn luyện từ xa cho mã sản phẩm này." />

                        <Button Content="🌐 Quản Lý Job"
                                Command="{Binding OpenJobManagerCommand}"
                                Height="30" Padding="8,0" Margin="0,0,6,0"
                                FontSize="11.5" FontWeight="SemiBold"
                                Background="#6A1B9A" Foreground="White" BorderThickness="0"
                                ToolTip="Mở cửa sổ Quản Lý Job &amp; Huấn Luyện Từ Xa qua Server Web." />

                        <Button Content="📁 Mở Job"
                                Command="{Binding ManualOpenJobCommand}"
                                Height="30" Padding="8,0"
                                FontSize="11.5" FontWeight="SemiBold"
                                ToolTip="Mở tệp Vision Job (.job) thủ công từ máy tính." />
                    </StackPanel>

                    <!-- Center: Input Box & Mode Checkboxes -->
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="ScanInputTextBox"
                                 Grid.Column="0"
                                 Text="{Binding ScannedCode, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13.5" FontWeight="Bold" Height="30"
                                 Padding="8,0"
                                 VerticalContentAlignment="Center"
                                 Background="{DynamicResource InputBackgroundBrush}"
                                 Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 Margin="0,0,8,0">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ScanCommand}" />
                                <KeyBinding Key="F5" Command="{Binding EnableLiveCameraCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Content="⚡ Auto Run"
                                      IsChecked="{Binding AutoRunJob, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="Khi bật: Tự động chạy kiểm tra ngay sau khi quét mã. Khi tắt: Chỉ nạp Job, căn chỉnh camera rồi bấm 'CHẠY JOB'."
                                      FontWeight="SemiBold" FontSize="11.5"
                                      Margin="0,0,10,0" VerticalAlignment="Center" />

                            <CheckBox Content="🔫 Đầu Scanner"
                                      IsChecked="{Binding UseExternalScanner, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="Khi bật: Dùng máy quét ngoài nhập mã. Lúc này phím SPACE dùng để RUN JOB."
                                      FontWeight="SemiBold" FontSize="11.5"
                                      Margin="0,0,10,0" VerticalAlignment="Center" />

                            <CheckBox Content="🎯 Chỉ Bắt Origin"
                                      IsChecked="{Binding OnlyOriginMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="Chế độ chỉ bắt Origin: Khi bật, nếu bắt được origin đạt tiêu chuẩn thì hiển thị OK, ngược lại hiển thị NG (cho dù các hạng mục kiểm tra khác có OK hay NG đi nữa). Mặc định: Bật."
                                      FontWeight="SemiBold" FontSize="11.5"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Row 1: Slim Modern Status Bar -->
            <Border Grid.Row="1" Margin="0,0,0,8" Padding="8,5" Background="{DynamicResource PanelBackgroundBrush}" BorderThickness="1.5" BorderBrush="{Binding StatusBrush}" CornerRadius="5">
                <DockPanel LastChildFill="True">
                    <!-- Left: Product Name Badge -->
                    <Border DockPanel.Dock="Left" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📦 Sản Phẩm:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentProductName}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Left: Job File Badge -->
                    <Border DockPanel.Dock="Left" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" MaxWidth="300" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📁 Job:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentJobFilePath}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentJobFilePath}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Right / Main: Status Message with color -->
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="Bold" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" />
                </DockPanel>
            </Border>

            <!-- Row 2: Bottom Split Section: Left - Preview Final/Live, Right - Scan History Table -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="300" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" MinWidth="350" />
                </Grid.ColumnDefinitions>

                <!-- Column 0: Left Side - Preview Final Image of ResultView Node / Live Stream -->
                <GroupBox Grid.Column="0" Header="{Binding PreviewHeaderTitle}" Padding="4" Foreground="{DynamicResource TextBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Control Bar with Mode Toggle & Overlay CheckBoxes -->
                        <DockPanel Grid.Row="0" Margin="2,0,2,4" LastChildFill="False">
                            <Button DockPanel.Dock="Left"
                                    Content="{Binding LiveToggleButtonText}"
                                    Command="{Binding ToggleLiveCameraCommand}"
                                    Width="140" Height="25" Margin="0,0,8,0"
                                    FontSize="11.5"
                                    ToolTip="Chuyển đổi giữa chế độ xem Live Stream từ Camera và Ảnh kết quả kiểm tra Final" />

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Content="Kết Quả (Overlay)" IsChecked="{Binding ShowResultOverlay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <CheckBox Content="Khung ROI" IsChecked="{Binding ShowRois, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <CheckBox Content="✛ Crosshair" IsChecked="{Binding ShowCrosshair, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="Bật / tắt hiển thị đường chữ thập tâm (Crosshair) trên khung nhìn camera" />
                                <CheckBox Content="Ảnh gốc" IsChecked="{Binding IsOriginalQualityPreview, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="Chuyển đổi giữa Preview nguyên gốc (100% độ phân giải, sắc nét khi zoom) và Preview giảm chất lượng (tối ưu hiệu năng, mượt mà)" />
                                <Button Content="🎯 Fit View" Height="23" Padding="8,0" Click="BtnFitImagePreview_Click" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource DarkBorderBrush}" FontSize="11" FontWeight="SemiBold" ToolTip="Tự động cân chỉnh (Auto Fit) ảnh vừa vặn toàn bộ với khung Preview" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Image Viewer & Origin Template Guide Split Grid -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Main Live / Result Image Viewer -->
                            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="Transparent" CornerRadius="4">
                                <controls:ImageViewerControl x:Name="OqcImageViewer"
                                                           ImageSource="{Binding PreviewImage}"
                                                           OverlayItems="{Binding OverlayItems}"
                                                           ShowCrosshair="{Binding ShowCrosshair}"
                                                           EnableRoiEditing="False" />
                            </Border>

                            <!-- Right: Origin Template Guide Box (Hiển thị mẫu Origin đã teach từ Job) -->
                            <Border Grid.Column="1" Width="220" Margin="6,0,0,0"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Visibility="{Binding HasOriginTemplate, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" MinHeight="120" MaxHeight="200" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Header -->
                                    <Border Grid.Row="0" Margin="0,0,0,4" Padding="5,3" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="3">
                                        <TextBlock Text="🎯 MẪU GỐC ORIGIN (TEACH)" FontSize="10.5" FontWeight="Bold" Foreground="#FFD700" />
                                    </Border>

                                    <!-- Template Image -->
                                    <Border Grid.Row="1" Background="#111" BorderBrush="{DynamicResource DarkBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="2">
                                        <Image Source="{Binding OriginTemplateImage}"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               RenderOptions.EdgeMode="Aliased"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Details & Positioning Parameters -->
                                    <Border Grid.Row="2" Margin="0,4,0,0" Padding="5" Background="#181818" CornerRadius="3" BorderBrush="{DynamicResource DarkBorderBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding OriginGuideDetails}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="10.5"
                                                   FontFamily="Consolas"
                                                   TextWrapping="Wrap" />
                                    </Border>

                                    <!-- Guidance Callout -->
                                    <Border Grid.Row="3" Margin="0,4,0,0" Padding="5,4" Background="#1B261D" BorderBrush="#2E7D32" BorderThickness="1" CornerRadius="3">
                                        <TextBlock Text="👉 Hướng dẫn: Đặt chi tiết trên phôi khớp với khung ROI (Vàng/Xanh) trên Live Preview."
                                                   Foreground="#81C784"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </GroupBox>

                <!-- GridSplitter -->
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource DarkBorderBrush}" />

                <!-- Column 2: Right Side - 10/45/45 Split (Top: Giant Product Name, Center: Giant OK/NG Judgement, Bottom: Measurement Details) -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Product Name Banner (10%) -->
                        <RowDefinition Height="10*" MinHeight="40" />
                        <RowDefinition Height="Auto" />
                        <!-- Row 2: Giant OK / NG Judgement Display (45%) -->
                        <RowDefinition Height="45*" MinHeight="140" />
                        <RowDefinition Height="Auto" />
                        <!-- Row 4: Measurement Details DataGrid (45%) -->
                        <RowDefinition Height="45*" MinHeight="140" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Product Name Display (10%) -->
                    <GroupBox Grid.Row="0" Header="📦 TÊN SẢN PHẨM (PRODUCT NAME)" Padding="4" Foreground="{DynamicResource TextBrush}">
                        <Border Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="6"
                                Padding="8,2"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentProductName}"
                                           FontWeight="ExtraBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           Margin="6,2">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.35" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Viewbox>
                        </Border>
                    </GroupBox>

                    <!-- Row 1: Splitter between Product Name and Judgement -->
                    <GridSplitter Grid.Row="1"
                                  Height="5"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Background="{DynamicResource DarkBorderBrush}"
                                  Cursor="SizeNS" />

                    <!-- Row 2: Giant OK / NG Judgement Display (40%) -->
                    <GroupBox Grid.Row="2" Header="🎯 KẾT QUẢ ĐÁNH GIÁ (INSPECTION JUDGEMENT)" Padding="6" Foreground="{DynamicResource TextBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Top Toolbar of Judgement Box -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                                <Button Content="📜 Mở Cửa Sổ Lịch Sử Quét Mã..."
                                        Command="{Binding OpenScanHistoryWindowCommand}"
                                        DockPanel.Dock="Left"
                                        Padding="10,3" Height="26" FontWeight="SemiBold"
                                        ToolTip="Mở cửa sổ danh sách toàn bộ lịch sử quét mã, tìm kiếm và xuất Excel" />
                                <Button Content="🖼️ Xem Ảnh Output"
                                        Command="{Binding ViewLatestOutputImageCommand}"
                                        DockPanel.Dock="Right"
                                        Padding="10,3" Height="26" FontWeight="SemiBold"
                                        ToolTip="Xem ảnh kết quả đo kiểm lần gần nhất phóng to" />
                            </DockPanel>

                            <!-- Big Result Center Banner -->
                            <Border Grid.Row="1"
                                    Background="{Binding BigResultBackgroundBrush}"
                                    BorderBrush="{Binding BigResultBorderBrush}"
                                    BorderThickness="3"
                                    CornerRadius="10"
                                    Padding="16"
                                    VerticalAlignment="Stretch"
                                    HorizontalAlignment="Stretch">
                                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Viewbox Grid.Row="0" MaxHeight="85" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BigResultStatusText}"
                                                   FontSize="72"
                                                   FontWeight="ExtraBold"
                                                   Foreground="{Binding BigResultForegroundBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Effect>
                                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.6" />
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </Viewbox>
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding LastResultSummary}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Bottom Warning if NG -->
                            <Border Grid.Row="2"
                                    Visibility="{Binding HasLastNgDetails, Converter={StaticResource BoolToVis}}"
                                    Background="#33FF0000"
                                    BorderBrush="#FF5252"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Margin="0,6,0,0"
                                    Padding="8,4">
                                <TextBlock Text="{Binding LastNgDetails, StringFormat='⚠️ Chi tiết lỗi: {0}'}"
                                           Foreground="#FF5252"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </GroupBox>

                    <!-- Row 3: Splitter between Judgement and Details -->
                    <GridSplitter Grid.Row="3"
                                  Height="5"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Background="{DynamicResource DarkBorderBrush}"
                                  Cursor="SizeNS" />

                    <!-- Row 4: Measurement Details DataGrid (40%) -->
                    <GroupBox Grid.Row="4" Header="📊 CHI TIẾT CÁC PHÉP ĐO (MEASUREMENT DETAILS &amp; SPECS)" Padding="4" Foreground="{DynamicResource TextBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DataGrid Grid.Row="0"
                                      ItemsSource="{Binding CurrentMeasurementDetails}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      Background="{DynamicResource PanelBackgroundBrush}"
                                      Foreground="{DynamicResource TextBrush}"
                                      RowHeight="26">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="35" ElementStyle="{StaticResource CenterStyle}" />
                                    <DataGridTextColumn Header="Tên Phép Đo" Binding="{Binding ToolName}" Width="1.4*" ElementStyle="{StaticResource BoldStyle}" />
                                    <DataGridTextColumn Header="Loại Tool" Binding="{Binding ToolType}" Width="*" />
                                    <DataGridTextColumn Header="Tiêu Chuẩn" Binding="{Binding FormattedSpec}" Width="*" ElementStyle="{StaticResource RightStyle}" />
                                    <DataGridTextColumn Header="Dung Sai" Binding="{Binding FormattedTol}" Width="*" ElementStyle="{StaticResource RightStyle}" />
                                    <DataGridTextColumn Header="Giới Hạn [Min~Max]" Binding="{Binding FormattedRange}" Width="1.2*" ElementStyle="{StaticResource CenterStyle}" />
                                    <DataGridTextColumn Header="Giá Trị Đo" Binding="{Binding FormattedResult}" Width="1.2*" ElementStyle="{StaticResource BoldRightStyle}" />

                                    <!-- Over Spec Column -->
                                    <DataGridTemplateColumn Header="Over Spec" Width="1.1*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FormattedOverSpec}"
                                                           Foreground="{Binding OverSpecBrushHex}"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Over Spec Description Column -->
                                    <DataGridTemplateColumn Header="Mô Tả Vượt Cận" Width="1.2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding OverSpecDescription}"
                                                           Foreground="{Binding OverSpecBrushHex}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Judgement Status Column -->
                                    <DataGridTemplateColumn Header="Đánh Giá" Width="85">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding StatusBrushHex}" CornerRadius="3" Padding="4,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Bottom Action Bar for Details -->
                            <DockPanel Grid.Row="1" Margin="0,6,0,0" LastChildFill="False">
                                <Button Content="🔍 Mở Chi Tiết Đầy Đủ &amp; Ảnh..."
                                        Command="{Binding ViewLatestScanDetailCommand}"
                                        DockPanel.Dock="Left"
                                        Padding="10,3" Height="26" FontWeight="SemiBold"
                                        ToolTip="Mở cửa sổ chi tiết đầy đủ của lần đo này kèm zoom &amp; pan ảnh kết quả" />
                                <Button Content="📜 Toàn Bộ Lịch Sử Quét"
                                        Command="{Binding OpenScanHistoryWindowCommand}"
                                        DockPanel.Dock="Right"
                                        Padding="10,3" Height="26"
                                        ToolTip="Mở cửa sổ lịch sử quét mã độc lập" />
                            </DockPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </Grid>
        </Grid>

        <!-- Loading Popup Modal Overlay -->
        <Border Visibility="{Binding IsLoadingPopupVisible, Converter={StaticResource BoolToVis}}"
                Background="#90000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="440"
                    Padding="24,20"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="#1E88E5"
                    BorderThickness="2"
                    CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.5" Color="#000000" />
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Height="5" Width="340" Foreground="#1E88E5" Margin="0,0,0,16" />
                    <TextBlock Text="🔍 ĐANG PHÂN TÍCH &amp; NHẬN DIỆN MÃ 360°..."
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#1E88E5"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding LoadingMessage}"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12" />
                    <TextBlock Text="Hệ thống đang chạy quy trình đọc mã đa tầng (360° Omni-Scanning) chuyên sâu. Vui lòng chờ..."
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
