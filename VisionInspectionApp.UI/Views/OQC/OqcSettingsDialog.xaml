<Window x:Class="VisionInspectionApp.UI.Views.OQC.OqcSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cấu hình OQC Scanner &amp; Tra cứu Database"
        Height="720" Width="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="10" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="⚙ Cấu hình Tra cứu &amp; Ghi log Database cho OQC" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                <TextBlock Text="Tùy chỉnh các câu lệnh SQL tra cứu file Job, danh sách sản phẩm và ghi kết quả kiểm tra lên DB." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Body Scrollable -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">

                <!-- 0. Cấu hình Đọc mã Barcode / QR Code từ Camera -->
                <GroupBox Header="📷 Cấu hình Nhận diện Mã (Barcode / QR Code) từ Camera" Margin="0,0,0,12" Padding="8" Foreground="{DynamicResource TextBrush}">
                    <StackPanel>
                        <CheckBox Content="Cho phép tự động đọc mã QR/Barcode từ Camera khi bấm Space hoặc nút Quét"
                                  IsChecked="{Binding EnableCameraBarcodeScan, UpdateSourceTrigger=PropertyChanged}"
                                  FontWeight="Bold" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Loại mã Code chỉ định:" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableCodeTypes}"
                                      SelectedItem="{Binding TargetCodeType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding EnableCameraBarcodeScan}"
                                      Height="28" VerticalContentAlignment="Center" />
                        </Grid>

                        <!-- Lọc độ dài -->
                        <Border Margin="0,4,0,8" Padding="8" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="4">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="Chỉ nhận mã có độ dài n ký tự:"
                                          IsChecked="{Binding EnableLengthFilter, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding EnableCameraBarcodeScan}"
                                          FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBox Text="{Binding RequiredCodeLength, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding EnableLengthFilter}"
                                         Width="80" Height="26" VerticalContentAlignment="Center" FontWeight="Bold" HorizontalContentAlignment="Center" />
                                <TextBlock Text="ký tự (VD: 10, 12...)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>

                        <!-- Trích xuất / Cắt chuỗi -->
                        <Border Margin="0,0,0,8" Padding="8" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="4">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="Cắt chuỗi mã đầu ra (Crop Substring):"
                                          IsChecked="{Binding EnableCodeCrop, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding EnableCameraBarcodeScan}"
                                          FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="Vị trí bắt đầu (0-based):" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding CropStartIndex, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding EnableCodeCrop}"
                                         Width="60" Height="26" VerticalContentAlignment="Center" FontWeight="Bold" HorizontalContentAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="Số ký tự lấy:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding CropLength, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding EnableCodeCrop}"
                                         Width="60" Height="26" VerticalContentAlignment="Center" FontWeight="Bold" HorizontalContentAlignment="Center"
                                         ToolTip="Nhập 0 để lấy toàn bộ phần còn lại từ vị trí bắt đầu" />
                            </StackPanel>
                        </Border>

                        <!-- Thời gian chờ quét mã (Timeout) -->
                        <Border Margin="0,0,0,4" Padding="8" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏱️ Thời gian chờ quét mã (Timeout):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0" />
                                <TextBox Text="{Binding ScanTimeoutMs, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding EnableCameraBarcodeScan}"
                                         Width="80" Height="26" VerticalContentAlignment="Center" FontWeight="Bold" HorizontalContentAlignment="Center" />
                                <TextBlock Text="ms (Mặc định: 3000 ms. Quá thời gian này không tìm thấy mã sẽ tự động trả về FAIL)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- 1. Tra cứu Job File (Lookup) -->
                <GroupBox Header="1. Tra cứu tệp Job từ Mã Scan (Lookup Query)" Margin="0,0,0,12" Padding="8" Foreground="{DynamicResource TextBrush}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cơ sở dữ liệu:" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <ComboBox Grid.Column="0" Grid.ColumnSpan="2" Margin="160,0,0,0"
                                      ItemsSource="{Binding AvailableDatabases}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding LookupDbId, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <TextBlock Text="Truy vấn SQL Tra cứu (hỗ trợ token {ScannedCode}):" Margin="0,0,0,4" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding LookupQuery, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" Height="60" Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tên cột chứa đường dẫn Job:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding JobFilePathColumn, UpdateSourceTrigger=PropertyChanged}" ToolTip="Mặc định là 'JobFilePath' hoặc cột đầu tiên nếu rỗng" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Thư mục gốc lưu tệp Job:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding JobRootDirectory, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nếu DB chỉ trả tên tệp (VD: 'ModelA.job'), phần mềm sẽ tìm trong thư mục gốc này." />
                            <Button Grid.Column="2" Content="📁 Duyệt" Click="BrowseJobFolder_Click" Margin="6,0,0,0" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- 2. Tra cứu Tên sản phẩm từ Mã Scan -->
                <GroupBox Header="2. Tra cứu Tên sản phẩm từ Mã Scan (Product Name Query)" Margin="0,0,0,12" Padding="8" Foreground="{DynamicResource TextBrush}">
                    <StackPanel>
                        <CheckBox Content="Kích hoạt tra cứu Tên sản phẩm từ DB theo Mã Scan"
                                  IsChecked="{Binding EnableProductNameLookup, UpdateSourceTrigger=PropertyChanged}"
                                  FontWeight="Bold" Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cơ sở dữ liệu:" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <ComboBox Grid.Column="0" Grid.ColumnSpan="2" Margin="160,0,0,0"
                                      ItemsSource="{Binding AvailableDatabases}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding ProductNameDbId, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding EnableProductNameLookup}" />
                        </Grid>

                        <TextBlock Text="Truy vấn SQL lấy Tên sản phẩm (hỗ trợ token {ScannedCode}):" Margin="0,0,0,4" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding ProductNameQuery, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding EnableProductNameLookup}"
                                 AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" Height="60" Margin="0,0,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tên cột chứa Tên sản phẩm:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding ProductNameColumn, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding EnableProductNameLookup}"
                                     ToolTip="Tên cột chứa tên sản phẩm (VD: 'G_NAME_KD' hoặc 'ProductName')" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- 3. Danh sách Sản phẩm (Product List) -->
                <GroupBox Header="3. Danh sách sản phẩm (Product Browser Query)" Margin="0,0,0,12" Padding="8" Foreground="{DynamicResource TextBrush}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cơ sở dữ liệu:" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <ComboBox Grid.Column="0" Grid.ColumnSpan="2" Margin="160,0,0,0"
                                      ItemsSource="{Binding AvailableDatabases}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding ProductListDbId, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <TextBlock Text="Truy vấn SQL danh sách sản phẩm (hỗ trợ {SearchText}, {Offset}, {PageSize}):" Margin="0,0,0,4" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding ProductListQuery, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" Height="65" Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tên cột mã SP (Code):" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBox Grid.Column="1" Text="{Binding ProductListCodeColumn, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Tên cột mã sản phẩm dùng để liên kết / gán vào CSDL (VD: 'G_CODE', 'ProductCode')" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tên cột tên SP (Name):" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBox Grid.Column="1" Text="{Binding ProductListNameColumn, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Tên cột tên sản phẩm dùng để auto-fill vào ô Mã SP trong Tool Editor (VD: 'G_NAME_KD', 'ProductName')" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Số dòng / trang (PageSize):" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding ProductListPageSize, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- 4. Gán sản phẩm ↔ Job (Assign Query) -->
                <GroupBox Header="4. Gán sản phẩm ↔ Tệp Job (Assign / Upsert Query)" Margin="0,0,0,12" Padding="8" Foreground="{DynamicResource TextBrush}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cơ sở dữ liệu:" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <ComboBox Grid.Column="0" Grid.ColumnSpan="2" Margin="160,0,0,0"
                                      ItemsSource="{Binding AvailableDatabases}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding AssignDbId, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <TextBlock Text="Truy vấn SQL Gán / Cập nhật (hỗ trợ {ProductCode}, {JobFilePath}):" Margin="0,0,0,4" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding AssignQuery, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" Height="65" />
                    </StackPanel>
                </GroupBox>

                <!-- 5. Ghi log kết quả lên DB (Master Log) -->
                <GroupBox Header="5. Ghi log tổng kết quả kiểm tra OQC lên DB (Master Result Log)" Margin="0,0,0,12" Padding="8" Foreground="{DynamicResource TextBrush}">
                    <StackPanel>
                        <CheckBox Content="Kích hoạt tự động ghi log kết quả tổng thể lên DB"
                                  IsChecked="{Binding LogResultToDb, UpdateSourceTrigger=PropertyChanged}"
                                  FontWeight="Bold" Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cơ sở dữ liệu:" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <ComboBox Grid.Column="0" Grid.ColumnSpan="2" Margin="160,0,0,0"
                                      ItemsSource="{Binding AvailableDatabases}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding LogResultDbId, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding LogResultToDb}" />
                        </Grid>

                        <TextBlock Text="Truy vấn SQL Ghi log Master (hỗ trợ {ScannedCode}, {UUID}, {ProductName}, {JobFilePath}, {PassBit}, {InspectResult}, {NgReasons}):" Margin="0,0,0,4" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding LogResultQuery, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding LogResultToDb}"
                                 AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" Height="65" />
                    </StackPanel>
                </GroupBox>

                <!-- 6. Ghi log chi tiết từng phép đo lên DB (Detail Measurements Log) -->
                <GroupBox Header="6. Ghi log chi tiết từng phép đo lên DB (Detail Measurements Log)" Margin="0,0,0,8" Padding="8" Foreground="{DynamicResource TextBrush}">
                    <StackPanel>
                        <CheckBox Content="Kích hoạt ghi log chi tiết từng phép đo (ToolName, Spec, Tol+, Tol-, Min, Max, Result, Judge)"
                                  IsChecked="{Binding LogDetailResultToDb, UpdateSourceTrigger=PropertyChanged}"
                                  FontWeight="Bold" Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cơ sở dữ liệu:" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <ComboBox Grid.Column="0" Grid.ColumnSpan="2" Margin="160,0,0,0"
                                      ItemsSource="{Binding AvailableDatabases}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding LogDetailResultDbId, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding LogDetailResultToDb}" />
                        </Grid>

                        <TextBlock Text="Truy vấn SQL Ghi chi tiết phép đo (hỗ trợ {ScannedCode}, {UUID}, {ToolName}, {Spec}, {UpperTor}/{TolPlus}, {LowerTor}/{TolMinus}, {MinSpec}/{Min}, {MaxSpec}/{Max}, {Result}, {TextSpect}, {TextResult}, {Unit}, {Judge}, {PassBit}):" Margin="0,0,0,4" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding LogDetailResultQuery, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding LogDetailResultToDb}"
                                 AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" Height="70" />
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="📤 Xuất Cấu Hình (Export)" Command="{Binding ExportConfigCommand}" Height="28" Padding="12,2" Margin="0,0,8,0" ToolTip="Lưu toàn bộ cấu hình OQC ra tệp JSON để sao lưu hoặc copy sang máy khác" />
                    <Button Content="📥 Nạp Cấu Hình (Import)" Command="{Binding ImportConfigCommand}" Height="28" Padding="12,2" ToolTip="Nạp cấu hình OQC từ tệp JSON đã lưu" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="💾 Lưu cấu hình" Click="Save_Click" Width="130" Height="28" Margin="0,0,8,0" IsDefault="True" />
                    <Button Content="Hủy" Click="Cancel_Click" Width="90" Height="28" IsCancel="True" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
