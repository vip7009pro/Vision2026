<Window x:Class="VisionInspectionApp.UI.Views.OQC.OqcSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cấu hình OQC Scanner &amp; Tra cứu Database"
        Height="720" Width="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="10" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="⚙ Cấu hình Tra cứu &amp; Ghi log Database cho OQC" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                <TextBlock Text="Tùy chỉnh các câu lệnh SQL tra cứu file Job, danh sách sản phẩm và ghi kết quả kiểm tra lên DB." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Body Scrollable -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">

                <!-- 1. Tra cứu Job File (Lookup) -->
                <GroupBox Header="1. Tra cứu tệp Job từ Mã Scan (Lookup Query)" Margin="0,0,0,12" Padding="8" Foreground="{DynamicResource TextBrush}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cơ sở dữ liệu:" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <ComboBox Grid.Column="0" Grid.ColumnSpan="2" Margin="160,0,0,0"
                                      ItemsSource="{Binding AvailableDatabases}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding LookupDbId, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <TextBlock Text="Truy vấn SQL Tra cứu (hỗ trợ token {ScannedCode}):" Margin="0,0,0,4" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding LookupQuery, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" Height="60" Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tên cột chứa đường dẫn Job:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding JobFilePathColumn, UpdateSourceTrigger=PropertyChanged}" ToolTip="Mặc định là 'JobFilePath' hoặc cột đầu tiên nếu rỗng" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Thư mục gốc lưu tệp Job:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding JobRootDirectory, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nếu DB chỉ trả tên tệp (VD: 'ModelA.job'), phần mềm sẽ tìm trong thư mục gốc này." />
                            <Button Grid.Column="2" Content="📁 Duyệt" Click="BrowseJobFolder_Click" Margin="6,0,0,0" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- 2. Danh sách Sản phẩm (Product List) -->
                <GroupBox Header="2. Danh sách sản phẩm (Product Browser Query)" Margin="0,0,0,12" Padding="8" Foreground="{DynamicResource TextBrush}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cơ sở dữ liệu:" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <ComboBox Grid.Column="0" Grid.ColumnSpan="2" Margin="160,0,0,0"
                                      ItemsSource="{Binding AvailableDatabases}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding ProductListDbId, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <TextBlock Text="Truy vấn SQL danh sách sản phẩm (hỗ trợ {SearchText}, {Offset}, {PageSize}):" Margin="0,0,0,4" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding ProductListQuery, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" Height="65" Margin="0,0,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Số dòng / trang (PageSize):" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding ProductListPageSize, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- 3. Gán sản phẩm ↔ Job (Assign Query) -->
                <GroupBox Header="3. Gán sản phẩm ↔ Tệp Job (Assign / Upsert Query)" Margin="0,0,0,12" Padding="8" Foreground="{DynamicResource TextBrush}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cơ sở dữ liệu:" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <ComboBox Grid.Column="0" Grid.ColumnSpan="2" Margin="160,0,0,0"
                                      ItemsSource="{Binding AvailableDatabases}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding AssignDbId, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <TextBlock Text="Truy vấn SQL Gán / Cập nhật (hỗ trợ {ProductCode}, {JobFilePath}):" Margin="0,0,0,4" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding AssignQuery, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" Height="65" />
                    </StackPanel>
                </GroupBox>

                <!-- 4. Ghi log kết quả lên DB -->
                <GroupBox Header="4. Ghi log kết quả kiểm tra OQC lên DB (Upload Result Log)" Margin="0,0,0,8" Padding="8" Foreground="{DynamicResource TextBrush}">
                    <StackPanel>
                        <CheckBox Content="Kích hoạt tự động ghi log kết quả kiểm tra lên DB"
                                  IsChecked="{Binding LogResultToDb, UpdateSourceTrigger=PropertyChanged}"
                                  FontWeight="Bold" Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cơ sở dữ liệu:" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <ComboBox Grid.Column="0" Grid.ColumnSpan="2" Margin="160,0,0,0"
                                      ItemsSource="{Binding AvailableDatabases}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding LogResultDbId, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding LogResultToDb}" />
                        </Grid>

                        <TextBlock Text="Truy vấn SQL Ghi log (hỗ trợ {ScannedCode}, {JobFilePath}, {PassBit}, {InspectResult}, {NgReasons}):" Margin="0,0,0,4" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding LogResultQuery, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding LogResultToDb}"
                                 AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" Height="65" />
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="💾 Lưu cấu hình" Click="Save_Click" Width="130" Margin="0,0,8,0" IsDefault="True" />
                <Button Content="Hủy" Click="Cancel_Click" Width="90" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
