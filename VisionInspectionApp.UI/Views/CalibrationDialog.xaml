<Window x:Class="VisionInspectionApp.UI.Views.CalibrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VisionInspectionApp.UI.Views"
        Title="📐 Hiệu Chuẩn Calibration (Active Job)"
        Height="720" Width="1120"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:CalibrationView Grid.Row="0" DataContext="{Binding}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Hoàn Tất &amp; Áp Dụng Hệ Số" Click="OnApplyAndCloseClicked" Background="#007ACC" Foreground="White" Padding="14,6" FontWeight="Bold" Margin="0,0,8,0" />
            <Button Content="Đóng" Click="OnCloseClicked" Padding="14,6" />
        </StackPanel>
    </Grid>
</Window>
