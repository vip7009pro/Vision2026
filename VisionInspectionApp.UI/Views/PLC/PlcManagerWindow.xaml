<Window x:Class="VisionInspectionApp.UI.Views.PLC.PlcManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="RootPlcManagerWindow"
        Title="PLC Manager &amp; Connectivity" Height="560" Width="840"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: PLCs List -->
        <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="PLCs List" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" Foreground="{DynamicResource TextBrush}"/>

                <ListBox Grid.Row="1" ItemsSource="{Binding Plcs}" SelectedItem="{Binding SelectedPlc, Mode=TwoWay}" DisplayMemberPath="Name" Margin="0,0,0,8" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource InputTextBrush}"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="➕ Add PLC" Command="{Binding AddPlcCommand}" Padding="8,4" Margin="0,0,4,0"/>
                    <Button Content="🗑 Delete" Command="{Binding DeletePlcCommand}" Padding="8,4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right: PLC Config & Tags -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- PLC Settings Card -->
            <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 0: PLC Name & Driver -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="PLC Name:" VerticalAlignment="Center" Margin="0,2" Foreground="{DynamicResource TextBrush}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedPlc.Name, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Driver:" VerticalAlignment="Center" Margin="8,2,0,2" Foreground="{DynamicResource TextBrush}"/>
                    <ComboBox Grid.Row="0" Grid.Column="3" ItemsSource="{Binding DriverTypes}" SelectedItem="{Binding SelectedPlc.DriverType, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>

                    <!-- Row 1: Connection Parameters (Ethernet IP/Port vs MX Component Station No) -->
                    <!-- MC Protocol Ethernet (Visibility when IsMcProtocol) -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="IP Address:" VerticalAlignment="Center" Margin="0,2" Foreground="{DynamicResource TextBrush}" Visibility="{Binding IsMcProtocol, Converter={StaticResource BoolToVis}}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedPlc.IPAddress, UpdateSourceTrigger=PropertyChanged}" Margin="2" Visibility="{Binding IsMcProtocol, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Port:" VerticalAlignment="Center" Margin="8,2,0,2" Foreground="{DynamicResource TextBrush}" Visibility="{Binding IsMcProtocol, Converter={StaticResource BoolToVis}}"/>
                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SelectedPlc.Port, UpdateSourceTrigger=PropertyChanged}" Margin="2" Visibility="{Binding IsMcProtocol, Converter={StaticResource BoolToVis}}"/>

                    <!-- MX Component Station Number (Visibility when IsMxComponent) -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Station No:" VerticalAlignment="Center" Margin="0,2" Foreground="{DynamicResource TextBrush}" Visibility="{Binding IsMxComponent, Converter={StaticResource BoolToVis}}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedPlc.LogicalStationNumber, UpdateSourceTrigger=PropertyChanged}" ToolTip="ActLogicalStationNumber configured in Mitsubishi Communication Utility (MX Component)" Margin="2" Visibility="{Binding IsMxComponent, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Text="(MX Component Station)" VerticalAlignment="Center" Margin="8,2,0,2" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Visibility="{Binding IsMxComponent, Converter={StaticResource BoolToVis}}"/>

                    <!-- Row 2: Scan Interval & Enabled -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Scan (ms):" VerticalAlignment="Center" Margin="0,2" Foreground="{DynamicResource TextBrush}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedPlc.ScanIntervalMs, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>

                    <CheckBox Grid.Row="2" Grid.Column="3" Content="Enabled" IsChecked="{Binding SelectedPlc.Enabled}" VerticalAlignment="Center" Margin="2" Foreground="{DynamicResource TextBrush}"/>

                    <!-- Row 3: Action Buttons & Connection Status Indicator -->
                    <DockPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,8,0,0">
                        <Border DockPanel.Dock="Left" Padding="8,4" CornerRadius="3" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#424242"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPlc.State}" Value="Connected">
                                            <Setter Property="Background" Value="#2E7D32"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedPlc.State}" Value="Error">
                                            <Setter Property="Background" Value="#C62828"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedPlc.State}" Value="Connecting">
                                            <Setter Property="Background" Value="#F57F17"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Status: " FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding SelectedPlc.State}" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding SelectedPlc.CpuName, StringFormat=' ({0})'}" Foreground="White" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="💾 Save Config" Command="{Binding SaveConfigCommand}" Padding="10,5" Margin="0,0,4,0" Background="#0277BD" Foreground="White" FontWeight="Bold"/>
                            <Button Content="⚡ Connect" Command="{Binding ConnectSelectedPlcCommand}" Padding="10,5" Margin="0,0,4,0" FontWeight="Bold"/>
                            <Button Content="🔌 Disconnect" Command="{Binding DisconnectSelectedPlcCommand}" Padding="10,5"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Tags Table Card -->
            <Border Grid.Row="1" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="PLC Tags" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" Foreground="{DynamicResource TextBrush}"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredTags}" SelectedItem="{Binding SelectedTag, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tag Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                            <DataGridTextColumn Header="Address" Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Width="90"/>

                            <!-- Data Type Template Column with reliable WPF DataContext binding -->
                            <DataGridTemplateColumn Header="Data Type" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DataType}" VerticalAlignment="Center" Margin="4,2" Foreground="{DynamicResource TextBrush}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.DataTypes, ElementName=RootPlcManagerWindow}" SelectedItem="{Binding DataType, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridCheckBoxColumn Header="ReadOnly" Binding="{Binding ReadOnly}" Width="75"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="➕ Add Tag" Command="{Binding AddTagCommand}" Padding="8,4" Margin="0,0,4,0"/>
                        <Button Content="🗑 Delete Tag" Command="{Binding DeleteTagCommand}" Padding="8,4" Margin="0,0,4,0"/>
                        <Button Content="💾 Save Config" Command="{Binding SaveConfigCommand}" Padding="8,4" Background="#0277BD" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
