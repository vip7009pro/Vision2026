<UserControl x:Class="VisionInspectionApp.UI.Views.PLC.PlcBrowserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}"
             Foreground="{DynamicResource TextBrush}">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header / Search Filter -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="🔍 Filter:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
            <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left"/>
        </DockPanel>

        <!-- Variable Tree/Grid -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding TagItems}" AutoGenerateColumns="False" IsReadOnly="True" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="PLC" Binding="{Binding PlcName}" Width="85"/>
                <DataGridTextColumn Header="Tag Name" Binding="{Binding TagName}" Width="120"/>
                <DataGridTextColumn Header="Data Type" Binding="{Binding DataType}" Width="85"/>
                <DataGridTextColumn Header="Current Value" Binding="{Binding CurrentValue}" Width="100"/>
                <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="75"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
