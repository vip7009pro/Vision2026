<Window x:Class="VisionInspectionApp.UI.Views.PLC.PlcMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLC Live Monitor &amp; Diagnostics" Height="520" Width="880"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <!-- Top Bar: Auto Refresh toggle & clear log -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="📊 Real-Time Diagnostics" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox Content="Auto Refresh" IsChecked="{Binding IsAutoRefreshEnabled}" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource TextBrush}"/>
                <Button Content="Clear Logs" Command="{Binding ClearLogsCommand}" Padding="8,4"/>
            </StackPanel>
        </DockPanel>

        <!-- Middle: Driver Connection Status Grid -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding MonitorItems}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,8" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="PLC Name" Binding="{Binding PlcName}" Width="120"/>
                <DataGridTextColumn Header="IP / Station" Binding="{Binding Endpoint}" Width="140"/>
                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="100"/>
                <DataGridTextColumn Header="Latency (ms)" Binding="{Binding LatencyMs, StringFormat=\{0:F1\}}" Width="95"/>
                <DataGridTextColumn Header="Packets" Binding="{Binding PacketCount}" Width="85"/>
                <DataGridTextColumn Header="Reconnects" Binding="{Binding ReconnectCount}" Width="90"/>
                <DataGridTextColumn Header="Last Error" Binding="{Binding LastError}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Bottom: Live Logs Console Box -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6">
            <DockPanel>
                <TextBlock Text="PLC Event &amp; Diagnostic Logs" DockPanel.Dock="Top" FontWeight="Bold" Margin="4,2,4,4" Foreground="{DynamicResource TextBrush}"/>
                <ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="11" Foreground="#00E676" Background="#121212" BorderThickness="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="#00E676"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="4,2"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
