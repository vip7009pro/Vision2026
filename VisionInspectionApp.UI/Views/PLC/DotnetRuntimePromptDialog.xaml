<Window x:Class="VisionInspectionApp.UI.Views.PLC.DotnetRuntimePromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cảnh Báo Môi Trường .NET — Yêu Cầu .NET Desktop Runtime (x86)"
        Height="500" Width="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        Icon="pack://application:,,,/VisionInspectionApp.UI;component/Assets/cms-vina-vision-system.ico">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Banner -->
        <Border Grid.Row="0"
                Background="#2A1B0A"
                BorderBrush="#F59E0B"
                BorderThickness="1.5"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,14">
            <DockPanel LastChildFill="True">
                <TextBlock Text="⚠️" FontSize="32" VerticalAlignment="Center" Margin="0,0,14,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="YÊU CẦU .NET DESKTOP RUNTIME (x86 / 32-BIT)"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="#FBBF24" />
                    <TextBlock Text="Module giao tiếp PLC Mitsubishi (PlcBridge) cần .NET 8.0 x86 để hoạt động."
                               FontSize="11.5"
                               Foreground="#FDE68A"
                               Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Explanation Content -->
        <Border Grid.Row="1"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18,14"
                Margin="0,0,0,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Tại sao cần cài đặt .NET Desktop Runtime (x86)?"
                               FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8" />

                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextBrush}" LineHeight="19" Margin="0,0,0,8">
                        • Ứng dụng thị giác chính <Run FontWeight="Bold">Vision 2026</Run> chạy ở kiến trúc 64-bit (<Run FontWeight="Bold" Foreground="#38BDF8">x64</Run>). Khi mới cài đặt, hệ thống chỉ hiển thị thông báo tải bản .NET x64.
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextBrush}" LineHeight="19" Margin="0,0,0,8">
                        • Tuy nhiên, module kết nối PLC <Run FontWeight="Bold">VisionInspectionApp.PlcBridge</Run> bắt buộc phải chạy ở kiến trúc 32-bit (<Run FontWeight="Bold" Foreground="#F59E0B">x86</Run>) để nạp thư viện COM điều khiển <Run FontWeight="Bold">ActUtlType</Run> của hãng Mitsubishi Electric.
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextBrush}" LineHeight="19" Margin="0,0,0,10">
                        • Vì module này chạy ngầm phụ trợ, Windows không thể tự động mở thông báo yêu cầu tải .NET x86. Nếu chưa cài đặt, ứng dụng sẽ không thể kết nối tới PLC Mitsubishi.
                    </TextBlock>

                    <!-- Status / Installation progress box -->
                    <Border x:Name="ProgressContainer"
                            Background="#0F172A"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,10"
                            Visibility="Collapsed"
                            Margin="0,4,0,4">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                <TextBlock x:Name="TxtProgressTitle" Text="📥 Đang tải bộ cài đặt .NET 8.0 x86 từ Microsoft..."
                                           FontWeight="SemiBold" FontSize="11.5" Foreground="#38BDF8" DockPanel.Dock="Left" />
                                <TextBlock x:Name="TxtProgressPercent" Text="0%"
                                           FontWeight="Bold" FontSize="11.5" Foreground="#38BDF8" DockPanel.Dock="Right" />
                            </DockPanel>

                            <ProgressBar x:Name="PbDownloadProgress" Height="8" Minimum="0" Maximum="100" Value="0"
                                         Foreground="#38BDF8" Background="#1E293B" BorderBrush="#334155" Margin="0,0,0,6" />

                            <TextBlock x:Name="TxtProgressDetail" Text="Đang kết nối tới máy chủ Microsoft CDN..."
                                       FontSize="11" Foreground="#94A3B8" FontFamily="Consolas, Segoe UI" />
                        </StackPanel>
                    </Border>

                    <!-- Success / Error notification -->
                    <Border x:Name="AlertContainer"
                            CornerRadius="6"
                            Padding="12,8"
                            Visibility="Collapsed"
                            Margin="0,6,0,0">
                        <TextBlock x:Name="TxtAlertMessage" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Don't ask again Checkbox -->
        <CheckBox Grid.Row="2"
                  x:Name="ChkSuppressPrompt"
                  Content="Không nhắc lại cảnh báo này khi khởi động ứng dụng trên máy tính này"
                  FontSize="11.5"
                  Foreground="{DynamicResource TextMutedBrush}"
                  Margin="4,0,0,14" />

        <!-- Footer Action Buttons -->
        <DockPanel Grid.Row="3" LastChildFill="False">
            <Button x:Name="BtnSkip"
                    Content="⏩ Bỏ Qua (Chưa Dùng PLC)"
                    Click="BtnSkip_Click"
                    Padding="14,8" Height="34" FontSize="11.5"
                    Background="Transparent"
                    Foreground="{DynamicResource TextMutedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Cursor="Hand"
                    DockPanel.Dock="Left" />

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="BtnBrowser"
                        Content="🌐 Tải Bằng Trình Duyệt"
                        Click="BtnBrowser_Click"
                        Padding="14,8" Height="34" FontSize="11.5"
                        Background="#1E293B"
                        Foreground="#E2E8F0"
                        BorderBrush="#475569"
                        BorderThickness="1"
                        Cursor="Hand"
                        Margin="0,0,10,0" />

                <Button x:Name="BtnAutoInstall"
                        Content="⚡ Tự Động Tải &amp; Cài Đặt (1-Click)"
                        Click="BtnAutoInstall_Click"
                        Padding="18,8" Height="34" FontSize="11.5" FontWeight="Bold"
                        Background="#D97706"
                        Foreground="#FFFFFF"
                        BorderBrush="#F59E0B"
                        BorderThickness="1"
                        Cursor="Hand" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
