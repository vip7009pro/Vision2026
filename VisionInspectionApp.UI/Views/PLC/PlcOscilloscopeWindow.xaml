<Window x:Class="VisionInspectionApp.UI.Views.PLC.PlcOscilloscopeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:VisionInspectionApp.UI.Controls"
        xmlns:models="clr-namespace:VisionInspectionApp.Models;assembly=VisionInspectionApp.Models"
        mc:Ignorable="d"
        Title="📈 PLC Oscilloscope - Phân Tích Dạng Sóng &amp; Đo Độ Trễ Tín Hiệu Thời Gian Thực"
        Height="820" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ScopeTopButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontFamily" Value="Consolas, Segoe UI" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- Row 0: Top Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Main Oscilloscope Waveform Display -->
            <RowDefinition Height="3*" MinHeight="250" />
            <!-- Row 2: Splitter -->
            <RowDefinition Height="6" />
            <!-- Row 3: Bottom Control Panel (Metrics / Channels / Event History) -->
            <RowDefinition Height="2*" MinHeight="180" />
            <!-- Row 4: Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: TOP TOOLBAR & CONTROLS -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <!-- Left: Run/Pause/Clear/Scope Controls -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <!-- PLC Selector -->
                    <TextBlock Text="PLC:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextBrush}" />
                    <ComboBox ItemsSource="{Binding Plcs}" SelectedItem="{Binding SelectedPlc}" DisplayMemberPath="Name" Width="120" Height="30" Margin="0,0,14,0" VerticalAlignment="Center" />

                    <!-- Run / Pause Buttons -->
                    <Button Style="{StaticResource ScopeTopButton}" Command="{Binding StartCaptureCommand}" Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVisConverter}}" Background="#00E676" Foreground="#000000">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▶ " FontSize="12" FontWeight="Bold" />
                            <TextBlock Text="BẮT ĐẦU GHI (RUN)" FontWeight="Bold" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ScopeTopButton}" Command="{Binding PauseCaptureCommand}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" Background="#FF9100" Foreground="#000000">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏸ " FontSize="12" FontWeight="Bold" />
                            <TextBlock Text="ĐÓNG BĂNG SÓNG (PAUSE)" FontWeight="Bold" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ScopeTopButton}" Command="{Binding ClearBufferCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧹 " FontSize="12" />
                            <TextBlock Text="Xóa Bộ Đệm" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ScopeTopButton}" Command="{Binding AutoFitTimeScaleCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎯 " FontSize="12" />
                            <TextBlock Text="Auto Fit" />
                        </StackPanel>
                    </Button>

                    <!-- Sampling Rate Selector -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Margin="6,0,10,0" Padding="10,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Chu kỳ quét:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextBrush}" FontSize="12" />
                            <ComboBox ItemsSource="{Binding AvailableIntervals}" SelectedItem="{Binding SamplingIntervalMs}" Width="75" Height="30" VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='{}{0} ms'}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Time Window Selector -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="Khung thời gian:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextBrush}" FontSize="12" />
                        <ComboBox ItemsSource="{Binding AvailableTimeWindows}" SelectedItem="{Binding TimeWindowMs}" Width="85" Height="30" VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='{}{0:F0} ms'}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Measurement Cursors & Export -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <CheckBox Content="📏 Thước Đo Cursors (A/B)" IsChecked="{Binding ShowCursors}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{DynamicResource TextBrush}" />

                    <Button Style="{StaticResource ScopeTopButton}" Command="{Binding ExportCsvCommand}" Background="#0288D1" Foreground="#FFFFFF">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾 " FontSize="12" />
                            <TextBlock Text="Xuất CSV" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ROW 1: MAIN OSCILLOSCOPE WAVEFORM CANVAS -->
        <Border Grid.Row="1" Background="#0E1014" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
            <controls:PlcOscilloscopeCanvas Channels="{Binding RenderChannels}"
                                            TimeWindowMs="{Binding TimeWindowMs, Mode=TwoWay}"
                                            ViewOffsetMs="{Binding ViewOffsetMs, Mode=TwoWay}"
                                            CursorAPosMs="{Binding CursorAPosMs, Mode=TwoWay}"
                                            CursorBPosMs="{Binding CursorBPosMs, Mode=TwoWay}"
                                            ShowCursors="{Binding ShowCursors}"
                                            MaxSessionTimeMs="{Binding MaxSessionTimeMs}" />
        </Border>

        <!-- ROW 2: SPLITTER -->
        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" Cursor="SizeNS" />

        <!-- ROW 3: BOTTOM TABS & STATS PANEL -->
        <TabControl Grid.Row="3" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <!-- TAB 1: LIVE TIMING METRICS & CHANNEL STATS -->
            <TabItem Header="📊 Đo Kiểm Thời Gian Thực (Timing Metrics)" FontSize="12.5" FontWeight="SemiBold" Padding="12,6">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Banner: Cursor Measurement HUD -->
                    <Border Grid.Row="0" Background="#16202C" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📏 THƯỚC ĐO THỜI GIAN (CURSORS):" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,16,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CursorAPosMs, StringFormat='Cursor A: {0:F2} ms'}" Foreground="#FFAB00" FontWeight="Bold" FontFamily="Consolas" Margin="0,0,16,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CursorBPosMs, StringFormat='Cursor B: {0:F2} ms'}" Foreground="#00E5FF" FontWeight="Bold" FontFamily="Consolas" Margin="0,0,20,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DeltaTimeMs, StringFormat='Khoảng thời gian Δt = {0:F2} ms'}" Foreground="#00E676" FontWeight="Bold" FontSize="14" FontFamily="Consolas" Margin="0,0,20,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DeltaFreqHz, StringFormat='Tần số xung f = {0:F2} Hz'}" Foreground="#FFD600" FontWeight="Bold" FontSize="13" FontFamily="Consolas" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right" Text="💡 Click chuột trái đặt Cursor A, click chuột phải đặt Cursor B" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontStyle="Italic" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <!-- Channel Cards Grid -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Channels}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PanelAltBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="4" Padding="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- Channel Header -->
                                        <DockPanel Grid.Row="0" LastChildFill="False">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="10" Height="10" Fill="{Binding Color, Converter={StaticResource ColorToBrushConverter}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextBrush}" />
                                            </StackPanel>
                                            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Enabled}" ToolTip="Bật / Tắt Kênh" VerticalAlignment="Center" />
                                        </DockPanel>

                                        <Separator Grid.Row="1" Margin="0,6,0,6" Background="{DynamicResource BorderBrush}" />

                                        <!-- Channel Metrics -->
                                        <StackPanel Grid.Row="2">
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Trạng thái hiện tại:" Style="{StaticResource MetricLabel}" />
                                                <TextBlock Grid.Column="1" Text="{Binding CurrentValue, StringFormat='{}{0}'}" Style="{StaticResource MetricValue}" />
                                            </Grid>

                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Độ rộng xung (Pulse Width):" Style="{StaticResource MetricLabel}" />
                                                <TextBlock Grid.Column="1" Text="{Binding PulseWidthMs, StringFormat='{}{0:F2} ms'}" Style="{StaticResource MetricValue}" Foreground="#00E676" />
                                            </Grid>

                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Chu kỳ xung (Period T):" Style="{StaticResource MetricLabel}" />
                                                <TextBlock Grid.Column="1" Text="{Binding PeriodMs, StringFormat='{}{0:F2} ms'}" Style="{StaticResource MetricValue}" Foreground="#00E5FF" />
                                            </Grid>

                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Tần số xung (Frequency f):" Style="{StaticResource MetricLabel}" />
                                                <TextBlock Grid.Column="1" Text="{Binding FrequencyHz, StringFormat='{}{0:F2} Hz'}" Style="{StaticResource MetricValue}" Foreground="#FFD600" />
                                            </Grid>

                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Số lần đổi mức (Edges):" Style="{StaticResource MetricLabel}" />
                                                <TextBlock Grid.Column="1" Text="{Binding TransitionCount, StringFormat='{}{0:N0}'}" Style="{StaticResource MetricValue}" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </TabItem>

            <!-- TAB 2: CHANNEL SETUP & DIRECT ADDRESS INPUT -->
            <TabItem Header="🏷️ Cấu Hình Kênh Đo (Channel Setup)" FontSize="12.5" FontWeight="SemiBold" Padding="12,6">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Nhập trực tiếp địa chỉ PLC (ví dụ: X0, X1, M100, Y0, Y1, D100, D200...) hoặc chọn từ danh bạ để giám sát:" Margin="0,0,0,8" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Channels}" AutoGenerateColumns="False" CanUserAddRows="False" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Bật" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                            <DataGridTextColumn Header="Kênh" Binding="{Binding ChannelId, StringFormat='CH{0}'}" IsReadOnly="True" Width="60" />
                            <DataGridTextColumn Header="Tên Gợi Nhớ (Label)" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                            <DataGridTextColumn Header="Địa Chỉ PLC (Address)" Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Width="140" />

                            <DataGridTemplateColumn Header="Kiểu Dữ Liệu" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DataType}" VerticalAlignment="Center" Margin="4,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.DataTypes, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding DataType, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Giá Trị Hiện Tại" Binding="{Binding CurrentValue, StringFormat='{}{0}'}" IsReadOnly="True" Width="110" />
                            <DataGridTextColumn Header="Độ Rộng Xung (ms)" Binding="{Binding PulseWidthMs, StringFormat='{}{0:F2}'}" IsReadOnly="True" Width="130" />
                            <DataGridTextColumn Header="Số Lần Chuyển Mức" Binding="{Binding TransitionCount, StringFormat='{}{0:N0}'}" IsReadOnly="True" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 3: EVENT LOG WITH MILLISECOND TIMESTAMPS -->
            <TabItem Header="📜 Lịch Sử Chuyển Trạng Thái Timestamp (Event Log)" FontSize="12.5" FontWeight="SemiBold" Padding="12,6">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                        <TextBlock Text="Danh sách sự kiện sườn xung kèm Dấu Thời Gian Thực (Timestamp hh:mm:ss.fff):" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" FontSize="12" />
                        <Button DockPanel.Dock="Right" Content="💾 Xuất Bảng Ra CSV" Command="{Binding ExportCsvCommand}" Padding="10,4" />
                    </DockPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}" AutoGenerateColumns="False" IsReadOnly="True" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="50" />
                            <DataGridTextColumn Header="Dấu Thời Gian (Timestamp)" Binding="{Binding TimeString}" Width="130" FontFamily="Consolas" FontWeight="Bold" />
                            <DataGridTextColumn Header="Kênh" Binding="{Binding ChannelId, StringFormat='CH{0}'}" Width="65" />
                            <DataGridTextColumn Header="Địa Chỉ" Binding="{Binding Address}" Width="90" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Trạng Thái Cũ" Binding="{Binding OldState}" Width="100" />
                            <DataGridTextColumn Header="Trạng Thái Mới" Binding="{Binding NewState}" Width="100" FontWeight="Bold" />
                            <DataGridTextColumn Header="Sự Kiện Sườn Xung" Binding="{Binding TransitionType}" Width="160" />
                            <DataGridTextColumn Header="Thời Lượng Duy Trì (ms)" Binding="{Binding DurationMs, StringFormat='{}{0:F2}'}" Width="150" FontFamily="Consolas" />
                            <DataGridTextColumn Header="Độ Rộng Xung (ms)" Binding="{Binding PulseWidthMs, StringFormat='{}{0:F2}'}" Width="130" FontFamily="Consolas" />
                            <DataGridTextColumn Header="Chi Tiết" Binding="{Binding Description}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ROW 4: STATUS BAR -->
        <Border Grid.Row="4" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,1,1" CornerRadius="0,0,6,6" Padding="10,4" Margin="0,0,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" FontSize="11.5" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalCapturedSamples, StringFormat='Tổng số mẫu đo: {0:N0}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,14,0" />
                    <TextBlock Text="{Binding Events.Count, StringFormat='Sự kiện: {0}'}" Foreground="#00E5FF" FontWeight="SemiBold" FontSize="11" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
