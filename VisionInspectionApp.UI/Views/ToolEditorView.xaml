<UserControl x:Class="VisionInspectionApp.UI.Views.ToolEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:VisionInspectionApp.UI.Controls"
             xmlns:models="clr-namespace:VisionInspectionApp.Models;assembly=VisionInspectionApp.Models"
             xmlns:converters="clr-namespace:VisionInspectionApp.UI.Converters"
             mc:Ignorable="d"
             Focusable="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:HexToBrushConverter x:Key="HexToBrush" />
        <converters:ToolToIconConverter x:Key="ToolToIcon" />
        <converters:ToolToColorConverter x:Key="ToolToColor" />
        <converters:EnumToVisibilityConverter x:Key="EnumToVis" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopySelectedNodeCommand}" />
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteNodeCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveJobCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectionCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,4">
            <TextBlock Text="Mã SP:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,0" Foreground="{DynamicResource TextBrush}" />
            <TextBox Width="110" Text="{Binding ProductCode, UpdateSourceTrigger=LostFocus}" Margin="0,0,8,0" VerticalContentAlignment="Center" Padding="4,2" />

            <!-- 1. Load Image Icon Button -->
            <Button Command="{Binding LoadPreviewImageCommand}" Margin="0,0,4,0" Padding="8,4" ToolTip="Tải ảnh xem trước từ file (Load Image)">
                <TextBlock Text="🖼️" FontSize="13" VerticalAlignment="Center"/>
            </Button>

            <!-- 2. Capture Camera Icon Button -->
            <Button Command="{Binding CaptureCameraImageCommand}" Margin="0,0,8,0" Padding="8,4" ToolTip="{Binding CaptureButtonText}">
                <TextBlock Text="📷" FontSize="13" VerticalAlignment="Center"/>
            </Button>

            <!-- 3. Run Once Icon Button -->
            <Button Command="{Binding RunOnceCommand}" Margin="0,0,4,0" Padding="10,4" Background="#0F5FA8" Foreground="White" BorderThickness="0" ToolTip="Chạy Flow 1 lần duy nhất (Run Once)">
                <TextBlock Text="▶" FontFamily="Segoe UI Emoji" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
            </Button>

            <!-- 4. Run Continuous Icon Button -->
            <Button Command="{Binding RunContinuousCommand}" Margin="0,0,8,0" Padding="10,4" Background="{Binding RunContinuousButtonBackgroundBrush}" Foreground="White" BorderThickness="0" ToolTip="{Binding RunContinuousButtonToolTip}">
                <TextBlock Text="{Binding RunContinuousButtonIcon}" FontFamily="Segoe UI Emoji" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
            </Button>

            <!-- 5. Calibration Icon Button -->
            <Button Command="{Binding OpenCalibrationDialogCommand}" Margin="0,0,4,0" Padding="8,4" Background="#E65100" Foreground="White" BorderThickness="0" ToolTip="Hiệu chuẩn tỉ lệ Pixels/mm trực tiếp trên Job hiện tại (Calibration)">
                <TextBlock Text="📐" FontSize="13" VerticalAlignment="Center"/>
            </Button>

            <!-- 6. Chessboard Calib Icon Button -->
            <Button Command="{Binding OpenChessboardCalibrationDialogCommand}" Margin="0,0,4,0" Padding="8,4" Background="#6A1B9A" Foreground="White" BorderThickness="0" ToolTip="Hiệu chuẩn camera bằng bảng Chessboard (Chessboard Calib)">
                <TextBlock Text="♟" FontSize="13" VerticalAlignment="Center"/>
            </Button>

            <!-- 7. Gán Mã - Job Icon Button -->
            <Button Command="{Binding OpenProductAssignDialogCommand}" Margin="0,0,4,0" Padding="8,4" Background="#0288D1" Foreground="White" BorderThickness="0" ToolTip="Gán mã sản phẩm trong CSDL cho tệp Job đang mở (Assign Product - Job)">
                <TextBlock Text="🏷️" FontSize="13" VerticalAlignment="Center"/>
            </Button>

            <!-- 8. Chụp & Lưu Ảnh Icon Button -->
            <Button Command="{Binding CaptureAndSaveImageCommand}" Margin="0,0,4,0" Padding="8,4" Background="#10B981" Foreground="White" BorderThickness="0" ToolTip="Chụp 1 frame nguyên bản chất lượng cao từ Camera và lưu ra file ảnh PNG/BMP (Capture &amp; Save Image)">
                <TextBlock Text="💾" FontSize="13" VerticalAlignment="Center"/>
            </Button>

            <!-- 9. Bản Đồ Cuộn Icon Button -->
            <Button Command="{Binding OpenRollDefectMapCommand}" Margin="0,0,8,0" Padding="8,4" Background="#7C3AED" Foreground="White" BorderThickness="0" ToolTip="Mở giao diện Bản đồ khuyết tật cuộn thời gian thực &amp; Xuất báo cáo (Roll Defect Map)">
                <TextBlock Text="📜" FontSize="13" VerticalAlignment="Center"/>
            </Button>

            <!-- 1. Result Badge (Right-Aligned) -->
            <Border DockPanel.Dock="Right" Background="{Binding ResultBackgroundBrush}" BorderBrush="{Binding ResultBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,3" VerticalAlignment="Center" Margin="6,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Result: " FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ResultStatusText}" Foreground="{Binding ResultForegroundBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 2. Continuous Running Speed & Time (Right-Aligned) -->
            <Border DockPanel.Dock="Right" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center" Margin="6,0,0,0" ToolTip="Tốc độ kiểm tra tức thời và tổng thời gian chạy liên tục">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding ContinuousElapsedAndSpeedText}" FontWeight="Bold" FontSize="11.5" Foreground="#10B981" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 3. Recent 20 Parts Stepped Bar (Right-Aligned, OK/NG Inspection History) -->
            <Border DockPanel.Dock="Right" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{Binding RecentPartsBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,4" VerticalAlignment="Center" Margin="6,0,0,0" ToolTip="{Binding RecentPartsToolTipText}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎯" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="Recent:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding RecentPartsStatusText}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>

                    <!-- Discrete Stepped Slots (20 items, Left-to-Right Stream) -->
                    <Border Background="#12000000" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="2,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <!-- Slot 0 (Oldest) -->
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1" Background="{Binding RecentPartSlot0Bg}" BorderBrush="{Binding RecentPartSlot0Border}"/>
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1" Background="{Binding RecentPartSlot1Bg}" BorderBrush="{Binding RecentPartSlot1Border}"/>
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1" Background="{Binding RecentPartSlot2Bg}" BorderBrush="{Binding RecentPartSlot2Border}"/>
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1" Background="{Binding RecentPartSlot3Bg}" BorderBrush="{Binding RecentPartSlot3Border}"/>
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1" Background="{Binding RecentPartSlot4Bg}" BorderBrush="{Binding RecentPartSlot4Border}"/>
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1" Background="{Binding RecentPartSlot5Bg}" BorderBrush="{Binding RecentPartSlot5Border}"/>
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1" Background="{Binding RecentPartSlot6Bg}" BorderBrush="{Binding RecentPartSlot6Border}"/>
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1" Background="{Binding RecentPartSlot7Bg}" BorderBrush="{Binding RecentPartSlot7Border}"/>
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1" Background="{Binding RecentPartSlot8Bg}" BorderBrush="{Binding RecentPartSlot8Border}"/>
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1" Background="{Binding RecentPartSlot9Bg}" BorderBrush="{Binding RecentPartSlot9Border}"/>
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1" Background="{Binding RecentPartSlot10Bg}" BorderBrush="{Binding RecentPartSlot10Border}"/>
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1" Background="{Binding RecentPartSlot11Bg}" BorderBrush="{Binding RecentPartSlot11Border}"/>
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1" Background="{Binding RecentPartSlot12Bg}" BorderBrush="{Binding RecentPartSlot12Border}"/>
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1" Background="{Binding RecentPartSlot13Bg}" BorderBrush="{Binding RecentPartSlot13Border}"/>
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1" Background="{Binding RecentPartSlot14Bg}" BorderBrush="{Binding RecentPartSlot14Border}"/>
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1" Background="{Binding RecentPartSlot15Bg}" BorderBrush="{Binding RecentPartSlot15Border}"/>
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1" Background="{Binding RecentPartSlot16Bg}" BorderBrush="{Binding RecentPartSlot16Border}"/>
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1" Background="{Binding RecentPartSlot17Bg}" BorderBrush="{Binding RecentPartSlot17Border}"/>
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1" Background="{Binding RecentPartSlot18Bg}" BorderBrush="{Binding RecentPartSlot18Border}"/>
                            <!-- Slot 19 (Newest) -->
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1" Background="{Binding RecentPartSlot19Bg}" BorderBrush="{Binding RecentPartSlot19Border}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 4. Queue Visualization Status Bar (Right-Aligned, Stepped Bar 16 Segments) -->
            <Border DockPanel.Dock="Right" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{Binding QueueBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,4" VerticalAlignment="Center" Margin="6,0,0,0" ToolTip="{Binding QueueToolTipText}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📦" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="Queue:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding QueueStatusText}" FontWeight="Bold" FontSize="11.5" Foreground="{Binding QueueFillBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>

                    <!-- Discrete Stepped Slots (16 items) -->
                    <Border Background="#12000000" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="2,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <!-- Slot 0 -->
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#15808080"/>
                                        <Setter Property="BorderBrush" Value="#30808080"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QueueSlot0Active}" Value="True">
                                                <Setter Property="Background" Value="{Binding DataContext.QueueFillBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                <Setter Property="BorderBrush" Value="{Binding DataContext.QueueBorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Slot 1 -->
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#15808080"/>
                                        <Setter Property="BorderBrush" Value="#30808080"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QueueSlot1Active}" Value="True">
                                                <Setter Property="Background" Value="{Binding DataContext.QueueFillBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                <Setter Property="BorderBrush" Value="{Binding DataContext.QueueBorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Slot 2 -->
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#15808080"/>
                                        <Setter Property="BorderBrush" Value="#30808080"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QueueSlot2Active}" Value="True">
                                                <Setter Property="Background" Value="{Binding DataContext.QueueFillBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                <Setter Property="BorderBrush" Value="{Binding DataContext.QueueBorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Slot 3 -->
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#15808080"/>
                                        <Setter Property="BorderBrush" Value="#30808080"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QueueSlot3Active}" Value="True">
                                                <Setter Property="Background" Value="{Binding DataContext.QueueFillBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                <Setter Property="BorderBrush" Value="{Binding DataContext.QueueBorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Slot 4 -->
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#15808080"/>
                                        <Setter Property="BorderBrush" Value="#30808080"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QueueSlot4Active}" Value="True">
                                                <Setter Property="Background" Value="{Binding DataContext.QueueFillBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                <Setter Property="BorderBrush" Value="{Binding DataContext.QueueBorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Slot 5 -->
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#15808080"/>
                                        <Setter Property="BorderBrush" Value="#30808080"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QueueSlot5Active}" Value="True">
                                                <Setter Property="Background" Value="{Binding DataContext.QueueFillBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                <Setter Property="BorderBrush" Value="{Binding DataContext.QueueBorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Slot 6 -->
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#15808080"/>
                                        <Setter Property="BorderBrush" Value="#30808080"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QueueSlot6Active}" Value="True">
                                                <Setter Property="Background" Value="{Binding DataContext.QueueFillBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                <Setter Property="BorderBrush" Value="{Binding DataContext.QueueBorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Slot 7 -->
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#15808080"/>
                                        <Setter Property="BorderBrush" Value="#30808080"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QueueSlot7Active}" Value="True">
                                                <Setter Property="Background" Value="{Binding DataContext.QueueFillBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                <Setter Property="BorderBrush" Value="{Binding DataContext.QueueBorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Slot 8 -->
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#15808080"/>
                                        <Setter Property="BorderBrush" Value="#30808080"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QueueSlot8Active}" Value="True">
                                                <Setter Property="Background" Value="{Binding DataContext.QueueFillBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                <Setter Property="BorderBrush" Value="{Binding DataContext.QueueBorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Slot 9 -->
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#15808080"/>
                                        <Setter Property="BorderBrush" Value="#30808080"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QueueSlot9Active}" Value="True">
                                                <Setter Property="Background" Value="{Binding DataContext.QueueFillBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                <Setter Property="BorderBrush" Value="{Binding DataContext.QueueBorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Slot 10 -->
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#15808080"/>
                                        <Setter Property="BorderBrush" Value="#30808080"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QueueSlot10Active}" Value="True">
                                                <Setter Property="Background" Value="{Binding DataContext.QueueFillBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                <Setter Property="BorderBrush" Value="{Binding DataContext.QueueBorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Slot 11 -->
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#15808080"/>
                                        <Setter Property="BorderBrush" Value="#30808080"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QueueSlot11Active}" Value="True">
                                                <Setter Property="Background" Value="{Binding DataContext.QueueFillBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                <Setter Property="BorderBrush" Value="{Binding DataContext.QueueBorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Slot 12 -->
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#15808080"/>
                                        <Setter Property="BorderBrush" Value="#30808080"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QueueSlot12Active}" Value="True">
                                                <Setter Property="Background" Value="{Binding DataContext.QueueFillBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                <Setter Property="BorderBrush" Value="{Binding DataContext.QueueBorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Slot 13 -->
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#15808080"/>
                                        <Setter Property="BorderBrush" Value="#30808080"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QueueSlot13Active}" Value="True">
                                                <Setter Property="Background" Value="{Binding DataContext.QueueFillBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                <Setter Property="BorderBrush" Value="{Binding DataContext.QueueBorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Slot 14 -->
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#15808080"/>
                                        <Setter Property="BorderBrush" Value="#30808080"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QueueSlot14Active}" Value="True">
                                                <Setter Property="Background" Value="{Binding DataContext.QueueFillBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                <Setter Property="BorderBrush" Value="{Binding DataContext.QueueBorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Slot 15 -->
                            <Border Width="6" Height="14" CornerRadius="2" Margin="1,0" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#15808080"/>
                                        <Setter Property="BorderBrush" Value="#30808080"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QueueSlot15Active}" Value="True">
                                                <Setter Property="Background" Value="{Binding DataContext.QueueFillBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                <Setter Property="BorderBrush" Value="{Binding DataContext.QueueBorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 5. System Monitor (RAM & Multi-Core CPU Performance) -->
            <Border DockPanel.Dock="Right" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6,3" VerticalAlignment="Center" Margin="6,0,0,0" ToolTip="{Binding SystemMonitorToolTip}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- RAM Section -->
                    <TextBlock Text="💾" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <TextBlock Text="{Binding SystemRamText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding RamBarFillBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>

                    <Rectangle Width="1" Height="14" Fill="{DynamicResource BorderBrush}" Margin="0,0,6,0"/>

                    <!-- CPU App & System Section -->
                    <TextBlock Text="⚙️" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <TextBlock Text="{Binding CpuAppText}" FontSize="11" FontWeight="Bold" Foreground="{Binding CpuAppBarFillBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding CpuSystemText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>

                    <!-- Multi-Core Equalizer Bars (Up to 16 Cores) -->
