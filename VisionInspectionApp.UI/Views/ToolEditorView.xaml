                                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailablePlcNames}" Text="{Binding PlcNode_PlcId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedItem="{Binding PlcNode_PlcId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" MaxDropDownHeight="220" PreviewMouseDown="ComboBox_PreviewMouseDown" Margin="2"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Tags / Addresses:" VerticalAlignment="Center" Margin="0,2"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PlcNode_BatchTagListString, UpdateSourceTrigger=LostFocus}" ToolTip="Comma separated tag names or addresses (e.g. X0, X1, D100)" Margin="2"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsPlcBatchWriteNode, Converter={StaticResource BoolToVis}}">
                                <Border Background="{DynamicResource BorderBrush}" Padding="3,1" Margin="0,3,0,0">
                                    <TextBlock Text="Batch Write PLC Node" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                </Border>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="PLC:" VerticalAlignment="Center" Margin="0,2"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailablePlcNames}" Text="{Binding PlcNode_PlcId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedItem="{Binding PlcNode_PlcId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" MaxDropDownHeight="220" PreviewMouseDown="ComboBox_PreviewMouseDown" Margin="2"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Tag/Address=Value:" VerticalAlignment="Center" Margin="0,2"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PlcNode_BatchWriteValuesString, UpdateSourceTrigger=LostFocus}" ToolTip="Comma separated Tag/Address=Value (e.g. Y0=true, D100=500)" Margin="2"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsResultTransferNode, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                                <Border Background="#1565C0" Padding="6,4" CornerRadius="4" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="📤 Result Transfer (Truyền kết quả tổng PLC)" FontWeight="Bold" Foreground="White" FontSize="13" />
                                        <TextBlock Text="Tự động truyền kết quả OK/NG và tọa độ/kích thước xuống PLC ngay sau khi Job Flow chạy xong." Foreground="#E3F2FD" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="⚡ Preset OK/NG" Command="{Binding AddResultTransferPresetOkNgCommand}" Background="#2E7D32" Foreground="White" Padding="6,3" Margin="0,0,4,0" ToolTip="Thêm nhanh 2 dòng truyền bit Y0 (OK) và Y1 (NG)" />
                                    <Button Content="📐 Preset Tọa Độ" Command="{Binding AddResultTransferPresetPoseCommand}" Background="#1976D2" Foreground="White" Padding="6,3" Margin="0,0,4,0" ToolTip="Thêm nhanh truyền tọa độ Origin X, Y, Angle vào D200, D202, D204" />
                                    <Button Content="➕ Thêm Dòng" Command="{Binding AddResultTransferItemCommand}" Background="#6A1B9A" Foreground="White" Padding="6,3" ToolTip="Thêm 1 dòng ghi PLC tùy chỉnh" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding ResultTransferItemVMs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="PLC Target:" VerticalAlignment="Center" Foreground="#CCCCCC" FontSize="11"/>
                                                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding DataContext.AvailablePlcNames, RelativeSource={RelativeSource AncestorType=UserControl}}" Text="{Binding PlcId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" MaxDropDownHeight="220" PreviewMouseDown="ComboBox_PreviewMouseDown" Margin="2" Height="24"/>
                                                    <Button Grid.Row="0" Grid.Column="2" Content="❌" Command="{Binding DataContext.RemoveResultTransferItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#FF5252" BorderThickness="0" ToolTip="Xóa dòng này" Margin="4,0,0,0" VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Tag / Address:" VerticalAlignment="Center" Foreground="#CCCCCC" FontSize="11"/>
                                                    <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding DataContext.AvailablePlcAllTagNames, RelativeSource={RelativeSource AncestorType=UserControl}}" Text="{Binding TagName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" MaxDropDownHeight="220" PreviewMouseDown="ComboBox_PreviewMouseDown" Margin="2" Height="24"/>

                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Giá trị gửi:" VerticalAlignment="Center" Foreground="#CCCCCC" FontSize="11"/>
                                                    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding ValueExpression, UpdateSourceTrigger=PropertyChanged}" controls:IntellisenseBehavior.Enable="True" Margin="2" Height="24"
                                                             ToolTip="Nhập giá trị hoặc cú pháp: TotalPass, TotalFail, TotalPassBit, TotalFailBit, {Origin.X}, {Origin.Y}, {Origin.AngleDeg}, {Distance1.Value}"/>

                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Điều kiện:" VerticalAlignment="Center" Foreground="#CCCCCC" FontSize="11"/>
                                                    <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding AvailableConditions}" SelectedItem="{Binding Condition, UpdateSourceTrigger=PropertyChanged}" Margin="2" Height="24"/>

                                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Chế độ gửi:" VerticalAlignment="Center" Foreground="#CCCCCC" FontSize="11"/>
                                                    <Grid Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableModes}" SelectedItem="{Binding Mode, UpdateSourceTrigger=PropertyChanged}" Margin="2" Height="24" ToolTip="Level: Giữ mức logic. Pulse: Đảo trạng thái trong thời gian xung rồi tự động khôi phục mức ban đầu."/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsPulseMode, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" Margin="4,0,0,0">
                                                            <TextBlock Text="Xung (ms):" VerticalAlignment="Center" Foreground="#FFA726" FontSize="11" Margin="0,0,4,0"/>
                                                            <TextBox Text="{Binding PulseDurationMs, UpdateSourceTrigger=PropertyChanged}" Width="55" Height="24" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,2,2,2" ToolTip="Thời gian giữ xung trước khi tự động trả về mức ban đầu (ms)"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,4,0,6">
                    <StackPanel>
                        <TextBlock Text="💡 Hướng dẫn cú pháp giá trị gửi xuống PLC:" FontWeight="Bold" Foreground="#4FC3F7" FontSize="11" Margin="0,0,0,4"/>
                        <TextBlock Text="• TotalPass / TotalFail: Gửi boolean (true/false) kết quả tổng" Foreground="#BBDEFB" FontSize="10" TextWrapping="Wrap"/>
                        <TextBlock Text="• TotalPassBit / TotalFailBit: Gửi số 1/0 bit Pass hoặc Fail" Foreground="#BBDEFB" FontSize="10" TextWrapping="Wrap"/>
                        <TextBlock Text="• {Origin.X}, {Origin.Y}, {Origin.AngleDeg}: Tọa độ gốc" Foreground="#BBDEFB" FontSize="10" TextWrapping="Wrap"/>
                        <TextBlock Text="• {KhoangCach1.Value}, {Caliper1.Value}: Khoảng cách / kích thước" Foreground="#BBDEFB" FontSize="10" TextWrapping="Wrap"/>
                        <TextBlock Text="• {MaBarCode.Text}: Chuỗi văn bản đọc được từ Barcode/OCR" Foreground="#BBDEFB" FontSize="10" TextWrapping="Wrap"/>
                        <TextBlock Text="• Chế độ Level: Giữ mức logic true/false thông thường." Foreground="#C8E6C9" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <TextBlock Text="• Chế độ Pulse: Đảo trạng thái trong thời gian xung (ms) rồi tự động hoàn trả mức ban đầu." Foreground="#FFE082" FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- DB Node Properties Panel -->
            <StackPanel Visibility="{Binding IsDbNode, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                <Border Background="#0D9488" Padding="6,4" CornerRadius="4" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Text="🗄️ Database Node (Read / Write DB)" FontWeight="Bold" Foreground="White" FontSize="13" />
                        <TextBlock Text="Truy vấn CSDL động (MS SQL, MySQL, PostgreSQL, SQLite, ODBC). Hỗ trợ chèn thuộc tính tool {Distance1.Value}, {Origin.X}, {Result.Pass}." Foreground="#E0F2FE" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <CheckBox Content="⚡ Kích hoạt DbNode" IsChecked="{Binding Db_Enable, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" ToolTip="Tích chọn để kích hoạt thực thi node CSDL này khi chạy flow. Bỏ tích chọn để tạm ngắt kích hoạt mà không cần xóa node."/>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Target DB:" VerticalAlignment="Center" Margin="0,2" Foreground="{DynamicResource TextBrush}"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableDatabases}" DisplayMemberPath="Name" SelectedItem="{Binding Db_SelectedDbChoice, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Operation Mode:" VerticalAlignment="Center" Margin="0,2" Foreground="{DynamicResource TextBrush}"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding DbNodeModes}" SelectedItem="{Binding Db_Mode, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Timing:" VerticalAlignment="Center" Margin="0,2" Foreground="{DynamicResource TextBrush}"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding DbExecutionTimings}" SelectedItem="{Binding Db_Timing, UpdateSourceTrigger=PropertyChanged}" Margin="2" ToolTip="Before Flow: Chạy trước inspection. After Flow: Chạy sau khi inspection kết thúc."/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Condition:" VerticalAlignment="Center" Margin="0,2" Foreground="{DynamicResource TextBrush}"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding AvailableConditions}" SelectedItem="{Binding Db_Condition, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                </Grid>

                <!-- Read Format Settings (Visible in Read Mode) -->
                <StackPanel Visibility="{Binding IsDbReadMode, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                    <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="⚙️ Trích Xuất Kết Quả Read DB" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="0,0,0,4"/>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Read Format:" VerticalAlignment="Center" Margin="0,2" Foreground="{DynamicResource TextBrush}"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding DbReadOutputFormats}" SelectedItem="{Binding Db_ReadFormat, UpdateSourceTrigger=PropertyChanged}" Margin="2" ToolTip="FirstCell (Hàng 0, Cột 0), SpecificCell (Chỉ định ô), ColumnJoin (Gộp cột), FullTableCsv/Json (Cả bảng)"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Target Row Idx:" VerticalAlignment="Center" Margin="0,2" Foreground="{DynamicResource TextBrush}" Visibility="{Binding IsSpecificCellFormat, Converter={StaticResource BoolToVis}}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Db_TargetRowIndex, UpdateSourceTrigger=PropertyChanged}" Margin="2" Visibility="{Binding IsSpecificCellFormat, Converter={StaticResource BoolToVis}}" ToolTip="Chỉ số dòng (0 là dòng đầu tiên)"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Target Column:" VerticalAlignment="Center" Margin="0,2" Foreground="{DynamicResource TextBrush}"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Db_TargetColumnName, UpdateSourceTrigger=PropertyChanged}" Margin="2" ToolTip="Tên cột hoặc chỉ số cột (vd: SerialNumber, Status, 0)"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Separator:" VerticalAlignment="Center" Margin="0,2" Foreground="{DynamicResource TextBrush}" Visibility="{Binding IsColumnJoinFormat, Converter={StaticResource BoolToVis}}"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Db_ColumnJoinSeparator, UpdateSourceTrigger=PropertyChanged}" Margin="2" Visibility="{Binding IsColumnJoinFormat, Converter={StaticResource BoolToVis}}" ToolTip="Ký tự phân cách khi gộp cột (vd: , hoặc \n)"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Dynamic SQL Query String -->
                <TextBlock Text="Dynamic SQL Query:" FontWeight="SemiBold" Margin="0,4,0,2" Foreground="{DynamicResource TextBrush}"/>
                <TextBox Text="{Binding Db_SqlQuery, UpdateSourceTrigger=PropertyChanged}" controls:IntellisenseBehavior.Enable="True" AcceptsReturn="True" TextWrapping="Wrap" Height="85" Margin="0,0,0,4" ToolTip="Nhập câu truy vấn SQL. Ví dụ: INSERT INTO Logs (Result, Dist) VALUES ('{Result.Pass}', {Distance1.Value}) hoặc SELECT Status FROM Orders WHERE ID = 1"/>

                <CheckBox Content="🔒 Cho phép câu lệnh UPDATE / DELETE (Bắt buộc có WHERE)" IsChecked="{Binding Db_AllowUpdateDelete, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" Foreground="#FFB74D" FontSize="11" ToolTip="Cảnh báo an toàn CSDL: Mặc định ứng dụng ngăn chặn các lệnh UPDATE/DELETE. Tích chọn ô này để cho phép thực thi lệnh UPDATE/DELETE có chứa điều kiện WHERE."/>

                <!-- Debug Output Preview -->
                <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,2,0,8">
                    <StackPanel>
                        <TextBlock Text="🔍 Live Result Preview:" FontWeight="Bold" Foreground="#4FC3F7" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Db_LastRunResultText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" Foreground="#E0E0E0" BorderThickness="0" FontSize="11" MaxHeight="80"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ================= PREPROCESS NODE PROPERTIES ================= -->
            <StackPanel Visibility="{Binding IsPreprocessNode, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="⚙️ Preprocessor Settings" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>

                        <!-- Illumination Profile -->
                        <TextBlock Text="Illumination Profile" FontWeight="SemiBold" FontSize="11" Margin="0,2,0,4" Foreground="{DynamicResource TextBrush}"/>
                        <ComboBox ItemsSource="{Binding AvailableIlluminationCorrectionPresets}" SelectedItem="{Binding IlluminationCorrection, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" FontSize="11"/>

                        <StackPanel Margin="0,0,0,6" ToolTip="Illumination Kernel Size">
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="Kernel Size:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding IlluminationKernel}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{DynamicResource TextBrush}"/>
                            </Grid>
                            <Slider Minimum="3" Maximum="401" Value="{Binding IlluminationKernel, UpdateSourceTrigger=PropertyChanged}" IsSnapToTickEnabled="True" TickFrequency="2"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,6" ToolTip="CLAHE Clip Limit (Contrast Limit)">
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="CLAHE Clip:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding ClaheClipLimit}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{DynamicResource TextBrush}"/>
                            </Grid>
                            <Slider Minimum="0.1" Maximum="10" Value="{Binding ClaheClipLimit, UpdateSourceTrigger=PropertyChanged}" TickFrequency="0.1"/>
                        </StackPanel>

                        <!-- Filters -->
                        <TextBlock Text="Filters &amp; Binarization" FontWeight="SemiBold" FontSize="11" Margin="0,6,0,4" Foreground="{DynamicResource TextBrush}"/>
                        <CheckBox Content="Grayscale" IsChecked="{Binding UseGray, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" FontSize="11" Foreground="{DynamicResource TextBrush}"/>

                        <CheckBox Content="Gaussian Blur" IsChecked="{Binding UseGaussianBlur, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                        <StackPanel Margin="0,0,0,6" IsEnabled="{Binding UseGaussianBlur}">
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="Blur Kernel:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding BlurKernel}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{DynamicResource TextBrush}"/>
                            </Grid>
                            <Slider Minimum="1" Maximum="21" Value="{Binding BlurKernel, UpdateSourceTrigger=PropertyChanged}" IsSnapToTickEnabled="True" TickFrequency="2"/>
                        </StackPanel>

                        <CheckBox Content="Threshold / Binarize" IsChecked="{Binding UseThreshold, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                        <StackPanel Margin="0,0,0,6" IsEnabled="{Binding UseThreshold}">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Type:" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableThresholdTypes}" SelectedItem="{Binding ThresholdType, UpdateSourceTrigger=PropertyChanged}" FontSize="11"/>
                            </Grid>

                            <StackPanel Visibility="{Binding IsThresholdBinary, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="Threshold Low:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding ThresholdLow}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{DynamicResource TextBrush}"/>
                                </Grid>
                                <Slider Minimum="0" Maximum="255" Value="{Binding ThresholdLow, UpdateSourceTrigger=PropertyChanged}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,0,4"/>

                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="Threshold High:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding ThresholdHigh}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{DynamicResource TextBrush}"/>
                                </Grid>
                                <Slider Minimum="0" Maximum="255" Value="{Binding ThresholdHigh, UpdateSourceTrigger=PropertyChanged}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,0,4"/>

                                <CheckBox Content="Invert Binary" IsChecked="{Binding InvertBinary, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <CheckBox Content="Canny Edge" IsChecked="{Binding UseCanny, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,4" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                        <CheckBox Content="Morphology Close" IsChecked="{Binding UseMorphology, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Preprocessor ROI Management Card -->
                <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                    <StackPanel>
                        <TextBlock Text="🎯 Region of Interest (ROI Mask)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>

                        <!-- Buttons to add ROI Shapes -->
                        <UniformGrid Columns="3" Margin="0,0,0,6">
                            <Button Content="➕ ⏹️ Square" Command="{Binding Preprocess_AddRectangleRoiCommand}" Margin="0,0,2,0" Padding="2" FontSize="10" ToolTip="Thêm ROI Hình Chữ Nhật/Vuông"/>
                            <Button Content="➕ ⭕ Circle" Command="{Binding Preprocess_AddCircleRoiCommand}" Margin="2,0,2,0" Padding="2" FontSize="10" ToolTip="Thêm ROI Hình Tròn"/>
                            <Button Content="➕ 🔷 Polygon" Command="{Binding Preprocess_AddPolygonRoiCommand}" Margin="2,0,0,0" Padding="2" FontSize="10" ToolTip="Thêm ROI Đa Giác"/>
                        </UniformGrid>

                        <!-- List of active ROIs -->
                        <ItemsControl ItemsSource="{Binding PreprocessRois}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="6" Margin="0,0,0,4">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Shape}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                                
                                                <Button Grid.Column="2" Content="{Binding Mode}" Command="{Binding DataContext.Preprocess_ToggleRoiModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,4,0" Padding="6,1" FontSize="10" ToolTip="Chuyển đổi giữa Include (Cộng vùng) và Exclude (Trừ vùng)"/>
                                                <Button Grid.Column="3" Content="🗑️" Command="{Binding DataContext.Preprocess_RemoveRoiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="4,1" FontSize="10" ToolTip="Xóa ROI này"/>
                                            </Grid>

                                            <!-- Coordinate Fields for Rectangle/Square ROI -->
                                            <UniformGrid Columns="4" Margin="0,2,0,0" Visibility="{Binding Shape, Converter={StaticResource EnumToVis}, ConverterParameter=Rectangle}">
                                                <StackPanel Margin="1,0">
                                                    <TextBlock Text="X:" FontSize="9" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <TextBox Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" FontSize="10" Padding="1"/>
                                                </StackPanel>
