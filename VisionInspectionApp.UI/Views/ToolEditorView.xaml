        <Grid Grid.Row="1" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="260" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="3.5*" MinWidth="240" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="4.5*" MinWidth="300" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="3.5*" MinWidth="280" />
