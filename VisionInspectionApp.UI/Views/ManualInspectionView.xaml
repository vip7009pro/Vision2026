<UserControl x:Class="VisionInspectionApp.UI.Views.ManualInspectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:VisionInspectionApp.UI.Controls"
             xmlns:rulers="clr-namespace:VisionInspectionApp.UI.Controls.Rulers"
             xmlns:conv="clr-namespace:VisionInspectionApp.UI.Converters"
             xmlns:models="clr-namespace:VisionInspectionApp.UI.Models.ManualInspection"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:EqualityToBoolConverter x:Key="EqToBool" />
        <conv:EqualityToVisibilityConverter x:Key="EqToVis" />
        <conv:ToleranceStatusToBrushConverter x:Key="StatusToBrush" />

        <Style x:Key="ToolGroupButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#252830" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="BorderBrush" Value="#3B4252" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#0284C7" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="#38BDF8" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#60A5FA" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolItemButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#0EA5E9" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="#7DD3FC" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#38BDF8" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="220" />
        </Grid.RowDefinitions>

        <!-- Top Action Bar -->
        <Border Grid.Row="0" Background="#1E222B" BorderBrush="#333846" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
            <DockPanel LastChildFill="False">
                <Button Content="📂 Mở ảnh File" Command="{Binding LoadImageCommand}" Margin="0,0,8,0" Padding="10,4" />
                <Button Content="📷 Chụp từ Camera" Command="{Binding CaptureCameraImageCommand}" Margin="0,0,12,0" Padding="10,4" />

                <Rectangle Width="1" Height="22" Fill="#475569" Margin="0,0,12,0" />

                <TextBlock Text="Độ phân giải Calib (px/mm):" VerticalAlignment="Center" Foreground="#E2E8F0" FontWeight="SemiBold" Margin="0,0,6,0" />
                <TextBox Width="90" Text="{Binding CalibrationPixelsPerMm, Converter={StaticResource DoubleConv}, UpdateSourceTrigger=PropertyChanged, Delay=250}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Button Content="🔄 Lấy từ Global Calib" Command="{Binding SyncCalibrationFromGlobalCommand}" ToolTip="Đồng bộ lại tỉ lệ px/mm từ Global Chessboard Calibration" Margin="0,0,16,0" Padding="6,4" />

                <CheckBox Content="Bắt điểm Sub-pixel Edge" IsChecked="{Binding EnableSubpixelSnapping}" VerticalAlignment="Center" Foreground="#38BDF8" ToolTip="Tự động dò mép biên cực kỳ chính xác dưới mức 1 pixel khi click" Margin="0,0,16,0" />

                <Rectangle Width="1" Height="22" Fill="#475569" Margin="0,0,12,0" />

                <Button Content="🗑️ Xóa toàn bộ" Command="{Binding ClearMeasurementsCommand}" ToolTip="Xóa toàn bộ danh sách kết quả đo và các hình vẽ overlay trên ảnh" Margin="0,0,8,0" Padding="10,4" Background="#7F1D1D" Foreground="#FCA5A5" BorderBrush="#991B1B" />
                <Button Content="📊 Xuất file CSV" Command="{Binding ExportCsvCommand}" ToolTip="Xuất bảng kết quả đo lường và kiểm tra dung sai ra file CSV" Margin="0,0,8,0" Padding="10,4" Background="#065F46" Foreground="#6EE7B7" BorderBrush="#047857" />
            </DockPanel>
        </Border>

        <!-- Tool Palette Ribbon -->
        <Border Grid.Row="1" Background="#161922" BorderBrush="#2A2F3D" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,6">
            <StackPanel>
                <!-- Group Tabs -->
                <WrapPanel Margin="0,0,0,6">
                    <RadioButton Style="{StaticResource ToolGroupButtonStyle}" Content="📍 1. Điểm &amp; Khoảng cách"
                                 IsChecked="{Binding SelectedGroup, Converter={StaticResource EqToBool}, ConverterParameter={x:Static models:ManualMeasurementGroup.PointAndDistance}}"
                                 Command="{Binding SelectGroupCommand}" CommandParameter="{x:Static models:ManualMeasurementGroup.PointAndDistance}" />

                    <RadioButton Style="{StaticResource ToolGroupButtonStyle}" Content="📏 2. Đoạn thẳng &amp; Line"
                                 IsChecked="{Binding SelectedGroup, Converter={StaticResource EqToBool}, ConverterParameter={x:Static models:ManualMeasurementGroup.LineAndSegments}}"
                                 Command="{Binding SelectGroupCommand}" CommandParameter="{x:Static models:ManualMeasurementGroup.LineAndSegments}" />

                    <RadioButton Style="{StaticResource ToolGroupButtonStyle}" Content="⭕ 3. Đường tròn &amp; Cung"
                                 IsChecked="{Binding SelectedGroup, Converter={StaticResource EqToBool}, ConverterParameter={x:Static models:ManualMeasurementGroup.CircleAndArc}}"
                                 Command="{Binding SelectGroupCommand}" CommandParameter="{x:Static models:ManualMeasurementGroup.CircleAndArc}" />

                    <RadioButton Style="{StaticResource ToolGroupButtonStyle}" Content="⬛ 4. Hình học &amp; Diện tích"
                                 IsChecked="{Binding SelectedGroup, Converter={StaticResource EqToBool}, ConverterParameter={x:Static models:ManualMeasurementGroup.ShapesAndArea}}"
                                 Command="{Binding SelectGroupCommand}" CommandParameter="{x:Static models:ManualMeasurementGroup.ShapesAndArea}" />

                    <RadioButton Style="{StaticResource ToolGroupButtonStyle}" Content="📐 5. Góc lượn &amp; Khúc xạ"
                                 IsChecked="{Binding SelectedGroup, Converter={StaticResource EqToBool}, ConverterParameter={x:Static models:ManualMeasurementGroup.Angles}}"
                                 Command="{Binding SelectGroupCommand}" CommandParameter="{x:Static models:ManualMeasurementGroup.Angles}" />

                    <RadioButton Style="{StaticResource ToolGroupButtonStyle}" Content="🔍 6. Vision Edge Detection"
                                 IsChecked="{Binding SelectedGroup, Converter={StaticResource EqToBool}, ConverterParameter={x:Static models:ManualMeasurementGroup.VisionEdge}}"
                                 Command="{Binding SelectGroupCommand}" CommandParameter="{x:Static models:ManualMeasurementGroup.VisionEdge}" />
                </WrapPanel>

                <!-- Tool Items Ribbon based on selected group -->
                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="3" Padding="6,4">
                    <DockPanel>
                        <!-- Group 1: Point & Distance -->
                        <WrapPanel Visibility="{Binding SelectedGroup, Converter={StaticResource EqToVis}, ConverterParameter={x:Static models:ManualMeasurementGroup.PointAndDistance}}">
                            <RadioButton Style="{StaticResource ToolItemButtonStyle}" Content="Tọa độ điểm (XY)"
                                         IsChecked="{Binding SelectedTool, Converter={StaticResource EqToBool}, ConverterParameter={x:Static models:ManualMeasurementType.PointCoordinates}}"
                                         Command="{Binding SelectToolCommand}" CommandParameter="{x:Static models:ManualMeasurementType.PointCoordinates}" />
                            <RadioButton Style="{StaticResource ToolItemButtonStyle}" Content="Khoảng cách 2 điểm (2P)"
                                         IsChecked="{Binding SelectedTool, Converter={StaticResource EqToBool}, ConverterParameter={x:Static models:ManualMeasurementType.PointToPointDistance}}"
                                         Command="{Binding SelectToolCommand}" CommandParameter="{x:Static models:ManualMeasurementType.PointToPointDistance}" />
                            <RadioButton Style="{StaticResource ToolItemButtonStyle}" Content="Độ lệch ΔX"
                                         IsChecked="{Binding SelectedTool, Converter={StaticResource EqToBool}, ConverterParameter={x:Static models:ManualMeasurementType.DeltaXDistance}}"
                                         Command="{Binding SelectToolCommand}" CommandParameter="{x:Static models:ManualMeasurementType.DeltaXDistance}" />
                            <RadioButton Style="{StaticResource ToolItemButtonStyle}" Content="Độ lệch ΔY"
                                         IsChecked="{Binding SelectedTool, Converter={StaticResource EqToBool}, ConverterParameter={x:Static models:ManualMeasurementType.DeltaYDistance}}"
                                         Command="{Binding SelectToolCommand}" CommandParameter="{x:Static models:ManualMeasurementType.DeltaYDistance}" />
                            <RadioButton Style="{StaticResource ToolItemButtonStyle}" Content="Khoảng cách Điểm - Đường (3P)"
                                         IsChecked="{Binding SelectedTool, Converter={StaticResource EqToBool}, ConverterParameter={x:Static models:ManualMeasurementType.PointToLineDistance}}"
                                         Command="{Binding SelectToolCommand}" CommandParameter="{x:Static models:ManualMeasurementType.PointToLineDistance}" />
                        </WrapPanel>

                        <!-- Group 2: Line & Segments -->
                        <WrapPanel Visibility="{Binding SelectedGroup, Converter={StaticResource EqToVis}, ConverterParameter={x:Static models:ManualMeasurementGroup.LineAndSegments}}">
                            <RadioButton Style="{StaticResource ToolItemButtonStyle}" Content="Đoạn thẳng 2 điểm"
                                         IsChecked="{Binding SelectedTool, Converter={StaticResource EqToBool}, ConverterParameter={x:Static models:ManualMeasurementType.LineTwoPoints}}"
                                         Command="{Binding SelectToolCommand}" CommandParameter="{x:Static models:ManualMeasurementType.LineTwoPoints}" />
                            <RadioButton Style="{StaticResource ToolItemButtonStyle}" Content="Trung điểm (Midpoint)"
                                         IsChecked="{Binding SelectedTool, Converter={StaticResource EqToBool}, ConverterParameter={x:Static models:ManualMeasurementType.LineMidpoint}}"
                                         Command="{Binding SelectToolCommand}" CommandParameter="{x:Static models:ManualMeasurementType.LineMidpoint}" />
                            <RadioButton Style="{StaticResource ToolItemButtonStyle}" Content="Khoảng cách 2 đường (4P)"
                                         IsChecked="{Binding SelectedTool, Converter={StaticResource EqToBool}, ConverterParameter={x:Static models:ManualMeasurementType.LineDistance}}"
                                         Command="{Binding SelectToolCommand}" CommandParameter="{x:Static models:ManualMeasurementType.LineDistance}" />
                            <RadioButton Style="{StaticResource ToolItemButtonStyle}" Content="Giao điểm 2 đường (4P)"
                                         IsChecked="{Binding SelectedTool, Converter={StaticResource EqToBool}, ConverterParameter={x:Static models:ManualMeasurementType.LineIntersection}}"
                                         Command="{Binding SelectToolCommand}" CommandParameter="{x:Static models:ManualMeasurementType.LineIntersection}" />
                            <RadioButton Style="{StaticResource ToolItemButtonStyle}" Content="Góc 2 đường (4P)"
                                         IsChecked="{Binding SelectedTool, Converter={StaticResource EqToBool}, ConverterParameter={x:Static models:ManualMeasurementType.LineAngle}}"
                                         Command="{Binding SelectToolCommand}" CommandParameter="{x:Static models:ManualMeasurementType.LineAngle}" />
                        </WrapPanel>

                        <!-- Group 3: Circle & Arc -->
                        <WrapPanel Visibility="{Binding SelectedGroup, Converter={StaticResource EqToVis}, ConverterParameter={x:Static models:ManualMeasurementGroup.CircleAndArc}}">
                            <RadioButton Style="{StaticResource ToolItemButtonStyle}" Content="Đường tròn qua 3 điểm (3P)"
                                         IsChecked="{Binding SelectedTool, Converter={StaticResource EqToBool}, ConverterParameter={x:Static models:ManualMeasurementType.CircleThreePoints}}"
                                         Command="{Binding SelectToolCommand}" CommandParameter="{x:Static models:ManualMeasurementType.CircleThreePoints}" />
                            <RadioButton Style="{StaticResource ToolItemButtonStyle}" Content="Tâm &amp; Bán kính (2P)"
                                         IsChecked="{Binding SelectedTool, Converter={StaticResource EqToBool}, ConverterParameter={x:Static models:ManualMeasurementType.CircleCenterRadius}}"
                                         Command="{Binding SelectToolCommand}" CommandParameter="{x:Static models:ManualMeasurementType.CircleCenterRadius}" />
                            <RadioButton Style="{StaticResource ToolItemButtonStyle}" Content="Đo Bán kính / Đường kính"
                                         IsChecked="{Binding SelectedTool, Converter={StaticResource EqToBool}, ConverterParameter={x:Static models:ManualMeasurementType.CircleRadiusDiameter}}"
                                         Command="{Binding SelectToolCommand}" CommandParameter="{x:Static models:ManualMeasurementType.CircleRadiusDiameter}" />
                            <RadioButton Style="{StaticResource ToolItemButtonStyle}" Content="Cung tròn (Arc 3P)"
                                         IsChecked="{Binding SelectedTool, Converter={StaticResource EqToBool}, ConverterParameter={x:Static models:ManualMeasurementType.ArcThreePoints}}"
                                         Command="{Binding SelectToolCommand}" CommandParameter="{x:Static models:ManualMeasurementType.ArcThreePoints}" />
                        </WrapPanel>

                        <!-- Group 4: Shapes & Area -->
                        <WrapPanel Visibility="{Binding SelectedGroup, Converter={StaticResource EqToVis}, ConverterParameter={x:Static models:ManualMeasurementGroup.ShapesAndArea}}">
                            <RadioButton Style="{StaticResource ToolItemButtonStyle}" Content="Hình chữ nhật thẳng (2P)"
                                         IsChecked="{Binding SelectedTool, Converter={StaticResource EqToBool}, ConverterParameter={x:Static models:ManualMeasurementType.RectangleTwoPoints}}"
                                         Command="{Binding SelectToolCommand}" CommandParameter="{x:Static models:ManualMeasurementType.RectangleTwoPoints}" />
                            <RadioButton Style="{StaticResource ToolItemButtonStyle}" Content="Hình chữ nhật xoay (3P)"
                                         IsChecked="{Binding SelectedTool, Converter={StaticResource EqToBool}, ConverterParameter={x:Static models:ManualMeasurementType.RotatedRectangleThreePoints}}"
                                         Command="{Binding SelectToolCommand}" CommandParameter="{x:Static models:ManualMeasurementType.RotatedRectangleThreePoints}" />
                        </WrapPanel>

                        <!-- Group 5: Angles -->
                        <WrapPanel Visibility="{Binding SelectedGroup, Converter={StaticResource EqToVis}, ConverterParameter={x:Static models:ManualMeasurementGroup.Angles}}">
                            <RadioButton Style="{StaticResource ToolItemButtonStyle}" Content="Góc tạo bởi 3 điểm (Đỉnh P2)"
                                         IsChecked="{Binding SelectedTool, Converter={StaticResource EqToBool}, ConverterParameter={x:Static models:ManualMeasurementType.AngleThreePoints}}"
                                         Command="{Binding SelectToolCommand}" CommandParameter="{x:Static models:ManualMeasurementType.AngleThreePoints}" />
                            <RadioButton Style="{StaticResource ToolItemButtonStyle}" Content="Góc giữa 2 đường (4P)"
                                         IsChecked="{Binding SelectedTool, Converter={StaticResource EqToBool}, ConverterParameter={x:Static models:ManualMeasurementType.AngleTwoLines}}"
                                         Command="{Binding SelectToolCommand}" CommandParameter="{x:Static models:ManualMeasurementType.AngleTwoLines}" />
                            <RadioButton Style="{StaticResource ToolItemButtonStyle}" Content="Góc nghiêng trục ngang (2P)"
                                         IsChecked="{Binding SelectedTool, Converter={StaticResource EqToBool}, ConverterParameter={x:Static models:ManualMeasurementType.AngleToAxis}}"
                                         Command="{Binding SelectToolCommand}" CommandParameter="{x:Static models:ManualMeasurementType.AngleToAxis}" />
                        </WrapPanel>

                        <!-- Group 6: Vision Edge -->
                        <WrapPanel Visibility="{Binding SelectedGroup, Converter={StaticResource EqToVis}, ConverterParameter={x:Static models:ManualMeasurementGroup.VisionEdge}}">
                            <RadioButton Style="{StaticResource ToolItemButtonStyle}" Content="🎯 Dò mép Sub-pixel (1P)"
                                         IsChecked="{Binding SelectedTool, Converter={StaticResource EqToBool}, ConverterParameter={x:Static models:ManualMeasurementType.VisionEdgePoint}}"
                                         Command="{Binding SelectToolCommand}" CommandParameter="{x:Static models:ManualMeasurementType.VisionEdgePoint}" />
                            <RadioButton Style="{StaticResource ToolItemButtonStyle}" Content="🎯 Đo khoảng cách 2 Mép Sub-pixel (2P)"
                                         IsChecked="{Binding SelectedTool, Converter={StaticResource EqToBool}, ConverterParameter={x:Static models:ManualMeasurementType.VisionEdgeDistance}}"
                                         Command="{Binding SelectToolCommand}" CommandParameter="{x:Static models:ManualMeasurementType.VisionEdgeDistance}" />
                        </WrapPanel>
                    </DockPanel>
                </Border>

                <!-- Prompt Banner -->
                <Border Background="#0C4A6E" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,4,0,0">
                    <TextBlock Text="{Binding StatusPrompt}" Foreground="#E0F2FE" FontWeight="Medium" FontSize="12" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Center Image Viewport with Rulers -->
        <Border Grid.Row="2" BorderThickness="1" BorderBrush="#333846" Background="#111318">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="26" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top-Left Origin / Unit Display -->
                <Border Grid.Row="0" Grid.Column="0" Background="#1A1C22" BorderBrush="#373C48" BorderThickness="0,0,1,1">
                    <TextBlock Text="mm" Foreground="#94A3B8" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Top Horizontal Ruler -->
                <rulers:RulerCanvas Grid.Row="0" Grid.Column="1"
                                    Orientation="Horizontal"
                                    PixelsPerMm="{Binding CalibrationPixelsPerMm}"
                                    ViewportMatrix="{Binding ViewportMatrix, ElementName=PART_Viewer}"
                                    MouseScreenPoint="{Binding CurrentMouseScreenPoint, ElementName=PART_Viewer}" />

                <!-- Left Vertical Ruler -->
                <rulers:RulerCanvas Grid.Row="1" Grid.Column="0"
                                    Orientation="Vertical"
                                    PixelsPerMm="{Binding CalibrationPixelsPerMm}"
                                    ViewportMatrix="{Binding ViewportMatrix, ElementName=PART_Viewer}"
                                    MouseScreenPoint="{Binding CurrentMouseScreenPoint, ElementName=PART_Viewer}" />

                <!-- Main Viewport Control -->
                <controls:ImageViewerControl x:Name="PART_Viewer"
                                             Grid.Row="1" Grid.Column="1"
                                             ImageSource="{Binding Image}"
                                             OverlayItems="{Binding OverlayItems}"
                                             EnableInteractiveMeasurement="True"
                                             InteractivePointClickedCommand="{Binding InteractivePointClickedCommand}"
                                             InteractiveMouseMoveCommand="{Binding InteractiveMouseMoveCommand}"
                                             InteractiveCancelledCommand="{Binding InteractiveCancelledCommand}" />
            </Grid>
        </Border>

        <!-- Bottom Measurement Results Grid & Tolerance Table -->
        <Border Grid.Row="3" BorderThickness="1" BorderBrush="#333846" Background="#181B22" Padding="6" Margin="0,6,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Text="📋 BẢNG KẾT QUẢ ĐO LƯỜNG &amp; KIỂM TRA DUNG SAI (2D VISION CMM)" FontWeight="Bold" Foreground="#E2E8F0" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Records.Count, StringFormat='{} (Tổng cộng: {0} phép đo)'}" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0" />
                </DockPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Records}" AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="#111318" RowBackground="#161922" AlternatingRowBackground="#1A1E29"
                          BorderBrush="#2A2F3D" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#262C3A">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="40" IsReadOnly="True" />
                        <DataGridTextColumn Header="Loại công cụ" Binding="{Binding ToolName}" Width="170" IsReadOnly="True" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="Giá trị đo (mm / °)" Binding="{Binding ValueMm, StringFormat={}{0:0.0000}}" Width="120" IsReadOnly="True" Foreground="#38BDF8" FontWeight="Bold" />
                        <DataGridTextColumn Header="Giá trị (px)" Binding="{Binding ValuePx, StringFormat={}{0:0.0}}" Width="85" IsReadOnly="True" Foreground="#94A3B8" />

                        <!-- Tolerance GD&T Columns -->
                        <DataGridTextColumn Header="Tiêu chuẩn (Nominal)" Binding="{Binding Nominal, Converter={StaticResource DoubleConv}, UpdateSourceTrigger=PropertyChanged}" Width="125" />
                        <DataGridTextColumn Header="+ Dung sai trên" Binding="{Binding UpperTolerance, Converter={StaticResource DoubleConv}, UpdateSourceTrigger=PropertyChanged}" Width="105" />
                        <DataGridTextColumn Header="- Dung sai dưới" Binding="{Binding LowerTolerance, Converter={StaticResource DoubleConv}, UpdateSourceTrigger=PropertyChanged}" Width="105" />

                        <!-- PASS / NG Badge -->
                        <DataGridTemplateColumn Header="Đánh giá" Width="80" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Status, Converter={StaticResource StatusToBrush}}" CornerRadius="3" Padding="6,2" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="Bold" FontSize="11" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Chi tiết tọa độ / Kết cấu" Binding="{Binding Details}" Width="*" IsReadOnly="True" Foreground="#CBD5E1" />

                        <!-- Action Column -->
                        <DataGridTemplateColumn Header="Xóa" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕"
                                            Command="{Binding DataContext.DeleteRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Xóa phép đo này"
                                            Background="#7F1D1D" Foreground="#FCA5A5" BorderThickness="0" Padding="4,1" Width="26" Height="22" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
