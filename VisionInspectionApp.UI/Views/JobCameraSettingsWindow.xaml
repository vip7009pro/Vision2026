<Window x:Class="VisionInspectionApp.UI.Views.JobCameraSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VisionInspectionApp.UI.Views"
        xmlns:controls="clr-namespace:VisionInspectionApp.UI.Controls"
        xmlns:converters="clr-namespace:VisionInspectionApp.UI.Converters"
        mc:Ignorable="d"
        Title="{Binding JobName, StringFormat='⚙️ Cấu Hình Camera Cho Job: {0}'}" 
        Height="800" Width="1280"
        MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📷" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="{Binding JobName, StringFormat='Cấu Hình Camera - Job: {0}'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="Các thông số sẽ được lưu riêng cho Job này và tự động nạp khi chuyển Job." FontSize="11" Foreground="#888" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding SaveJobCameraSettingsCommand}" 
                            Background="#2E7D32" Foreground="White" FontWeight="Bold" Padding="16,8" Margin="0,0,8,0" BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾 " />
                            <TextBlock Text="Lưu Vào Job Này" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CancelCommand}" 
                            Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextBrush}" Padding="14,8" BorderThickness="0" Content="❌ Đóng" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main 3-Column Work Area -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Device Selection & Basic Stream Controls -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" Margin="0,0,8,0" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="🔌 Kết Nối Thiết Bị" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Chọn camera công nghiệp" FontSize="11" Foreground="#888" Margin="0,0,0,8" />
                        <Separator Margin="0,0,0,8" />

                        <!-- Device Selection ComboBox -->
                        <TextBlock Text="Danh sách Camera phát hiện:" FontSize="11" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding AvailableDevices}" SelectedItem="{Binding SelectedDevice}" Margin="0,0,0,10" Padding="6,4">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Device Info Card -->
                        <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedDevice.DisplayName, FallbackValue='Chưa chọn thiết bị'}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedDevice.InterfaceType, StringFormat='Chuẩn giao tiếp: {0}'}" FontSize="11" Foreground="#888" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding SelectedDevice.IpAddress, StringFormat='Địa chỉ IP: {0}'}" FontSize="11" Foreground="#888" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Start / Stop Controls -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding StartCameraCommand}" 
                                    IsEnabled="{Binding IsCameraRunning, Converter={StaticResource InverseBoolConverter}}"
                                    Background="#2E7D32" Foreground="White" BorderThickness="0" Padding="8,8" Margin="0,0,4,0" FontWeight="Bold">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▶ " />
                                    <TextBlock Text="Start Cam" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1" Command="{Binding StopCameraCommand}" 
                                    IsEnabled="{Binding IsCameraRunning}"
                                    Background="#C62828" Foreground="White" BorderThickness="0" Padding="8,8" Margin="4,0,0,0" FontWeight="Bold">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⏹ " />
                                    <TextBlock Text="Stop Cam" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Live View Streaming Toggle & Snap Frame Button -->
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding ToggleLiveViewCommand}" 
                                    IsEnabled="{Binding IsCameraRunning}"
                                    Background="{Binding LiveViewButtonBackgroundBrush}" Foreground="White" BorderThickness="0" Padding="6,7" Margin="0,0,3,0" FontWeight="Bold">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding LiveViewButtonIcon}" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding LiveViewButtonText}" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1" Command="{Binding SnapFrameCommand}" 
                                    IsEnabled="{Binding IsCameraRunning}"
                                    Background="#673AB7" Foreground="White" BorderThickness="0" Padding="6,7" Margin="3,0,0,0" FontWeight="Bold">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📸 " />
                                    <TextBlock Text="Chụp Thử" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Button Command="{Binding ExecuteSoftwareTriggerCommand}" IsEnabled="{Binding IsCameraRunning}"
                                Margin="0,6,0,0" Padding="8,6" Background="#1565C0" Foreground="White" BorderThickness="0" FontWeight="Bold">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡ " />
                                <TextBlock Text="Software Trigger" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Center Panel: Live Preview Display -->
            <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" ClipToBounds="True">
                <Grid>
                    <!-- Live Image Display with Interactive ROI Handles & Zoom/Pan -->
                    <controls:ImageViewerControl ImageSource="{Binding LiveImage}"
                                                 OverlayItems="{Binding OverlayItems}"
                                                 EnableRoiEditing="True"
                                                 RoiEditedCommand="{Binding RoiEditedCommand}"
                                                 ActiveRoiLabel="CamROI" />

                    <!-- HUD Info Overlay -->
                    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="15" Background="#C0000000" Padding="12,8" CornerRadius="6" IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Fps, StringFormat='FPS: {0}'}" Foreground="#4CAF50" FontWeight="Bold" FontSize="14" Margin="0,0,16,0" />
                            <TextBlock Text="{Binding ResolutionText, StringFormat='Res: {0}'}" Foreground="#00BCD4" FontWeight="Bold" FontSize="14" Margin="0,0,16,0" />
                            <TextBlock Text="{Binding SelectedDevice.Vendor, StringFormat='Vendor: {0}'}" Foreground="#FFC107" FontWeight="Bold" FontSize="14" Margin="0,0,16,0" />
                            <TextBlock Text="{Binding StreamStatusText}" Foreground="#FF9800" FontWeight="Bold" FontSize="13" />
                        </StackPanel>
                    </Border>

                    <!-- Offline Placeholder -->
                    <Grid Visibility="{Binding LiveImage, Converter={StaticResource NullToVisibilityConverter}}" IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📷" FontSize="56" Foreground="#555" HorizontalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock Text="Camera Chưa Phát Trực Tiếp" FontSize="18" FontWeight="Bold" Foreground="#AAA" HorizontalAlignment="Center" />
                            <TextBlock Text="Bấm 'Start Cam' sau đó 'Bật Live View' hoặc 'Chụp Thử' để kiểm tra hình ảnh" FontSize="13" Foreground="#777" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right Panel: Parameters Settings -->
            <Border Grid.Column="2" Background="{DynamicResource PanelBackgroundBrush}" Margin="8,0,0,0" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="⚙️ Thông Số Camera (Lưu Theo Job)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="Phơi sáng, Gain, White Balance &amp; Trigger" FontSize="11" Foreground="#888" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding SyncFromCameraCommand}" IsEnabled="{Binding IsCameraRunning}"
                                Content="🔄 Đọc Từ Camera" Padding="6,3" FontSize="10" FontWeight="Bold" Background="#00897B" Foreground="White" BorderThickness="0" VerticalAlignment="Center" ToolTip="Đọc và đồng bộ toàn bộ trạng thái thực tế từ Camera vào Job này" />
                    </Grid>

                    <!-- Scrollable Parameters -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Orientation="Vertical">

                            <!-- Group 1: Phơi sáng & Gain -->
                            <GroupBox Header="💡 Phơi Sáng &amp; Độ Khuếch Đại" Margin="0,0,0,8" Padding="6" FontWeight="SemiBold">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,2">
                                        <TextBlock Text="Phơi sáng (Exposure us):" FontSize="11" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                                        <CheckBox Content="Auto" IsChecked="{Binding AutoExposure}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </DockPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="65" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="100" Maximum="100000" Value="{Binding ExposureTimeUs}" IsEnabled="{Binding AutoExposure, Converter={StaticResource InverseBoolConverter}}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding ExposureTimeUs, StringFormat='{}{0:F0}'}" IsEnabled="{Binding AutoExposure, Converter={StaticResource InverseBoolConverter}}" Margin="6,0,0,0" Padding="4,2" TextAlignment="Right" />
                                    </Grid>

                                    <DockPanel Margin="0,0,0,2">
                                        <TextBlock Text="Độ khuếch đại (Gain dB):" FontSize="11" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                                        <CheckBox Content="Auto" IsChecked="{Binding AutoGain}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </DockPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="65" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="0" Maximum="24" Value="{Binding GainDb}" IsEnabled="{Binding AutoGain, Converter={StaticResource InverseBoolConverter}}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding GainDb, StringFormat='{}{0:F1}'}" IsEnabled="{Binding AutoGain, Converter={StaticResource InverseBoolConverter}}" Margin="6,0,0,0" Padding="4,2" TextAlignment="Right" />
                                    </Grid>

                                    <TextBlock Text="Gamma Correction:" FontSize="11" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2" />
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="65" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="0.1" Maximum="4.0" Value="{Binding Gamma}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding Gamma, StringFormat='{}{0:F2}'}" Margin="6,0,0,0" Padding="4,2" TextAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <!-- Group 2: Cân Bằng Trắng ISP -->
                            <GroupBox Header="🎨 Cân Bằng Trắng (White Balance ISP)" Margin="0,0,0,8" Padding="6" FontWeight="SemiBold">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <CheckBox Content="Auto White Balance" IsChecked="{Binding AutoWhiteBalance}" VerticalAlignment="Center" />
                                        <Button Command="{Binding AutoWhiteBalanceOnceCommand}" Content="⚡ Cân Bằng 1 Lần" DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="6,2" FontSize="10" Background="#3F51B5" Foreground="White" BorderThickness="0" />
                                    </DockPanel>

                                    <TextBlock Text="Tỷ lệ Đỏ (Red Gain):" FontSize="10" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,1" />
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="55" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="0.1" Maximum="5.0" Value="{Binding RedGain}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding RedGain, StringFormat='{}{0:F2}'}" Margin="4,0,0,0" Padding="2" TextAlignment="Right" FontSize="11" />
                                    </Grid>

                                    <TextBlock Text="Tỷ lệ Xanh Lá (Green Gain):" FontSize="10" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,1" />
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="55" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="0.1" Maximum="5.0" Value="{Binding GreenGain}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding GreenGain, StringFormat='{}{0:F2}'}" Margin="4,0,0,0" Padding="2" TextAlignment="Right" FontSize="11" />
                                    </Grid>

                                    <TextBlock Text="Tỷ lệ Xanh Dương (Blue Gain):" FontSize="10" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,1" />
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="55" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="0.1" Maximum="5.0" Value="{Binding BlueGain}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding BlueGain, StringFormat='{}{0:F2}'}" Margin="4,0,0,0" Padding="2" TextAlignment="Right" FontSize="11" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <!-- Group 3: Trigger Mode & I/O -->
                            <GroupBox Header="🎯 Chế Độ Trigger" Margin="0,0,0,8" Padding="6" FontWeight="SemiBold">
                                <StackPanel>
                                    <CheckBox Content="Kích hoạt Trigger Mode (On)" IsChecked="{Binding TriggerModeOn}" Margin="0,0,0,6" />
                                    
                                    <TextBlock Text="Nguồn tín hiệu Trigger:" FontSize="11" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2" />
                                    <ComboBox ItemsSource="{Binding TriggerSources}" SelectedItem="{Binding SelectedTriggerSource}" IsEnabled="{Binding TriggerModeOn}" Margin="0,0,0,6" Padding="4,2" />

                                    <TextBlock Text="Độ trễ Trigger (Delay us):" FontSize="11" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding TriggerDelayUs}" IsEnabled="{Binding TriggerModeOn}" Padding="4,2" />
                                </StackPanel>
                            </GroupBox>

                            <!-- Group 4: Định dạng điểm ảnh & Lật hình -->
                            <GroupBox Header="🔄 Định Dạng Điểm Ảnh &amp; Khung Hình" Margin="0,0,0,8" Padding="6" FontWeight="SemiBold">
                                <StackPanel>
                                    <TextBlock Text="Định dạng điểm ảnh (Pixel Format):" FontSize="11" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2" />
                                    <ComboBox ItemsSource="{Binding PixelFormatOptions}" SelectedItem="{Binding SelectedPixelFormat}" Margin="0,0,0,6" Padding="4,3" />

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <CheckBox Content="Lật Ngang (X)" IsChecked="{Binding ReverseX}" Margin="0,0,12,0" />
                                        <CheckBox Content="Lật Dọc (Y)" IsChecked="{Binding ReverseY}" />
                                    </StackPanel>

                                    <TextBlock Text="Độ Phân Giải (Resolution):" FontSize="11" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2" />
                                    <ComboBox ItemsSource="{Binding ResolutionOptions}" SelectedItem="{Binding SelectedResolution}" Margin="0,0,0,6" Padding="4,2" />

                                    <TextBlock Text="Tần Số Quét Target FPS:" FontSize="11" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2" />
                                    <ComboBox ItemsSource="{Binding FpsOptions}" SelectedItem="{Binding SelectedFps}" Margin="0,0,0,2" Padding="4,2" />
                                </StackPanel>
                            </GroupBox>

                            <!-- Group 5: Hardware Camera ROI -->
                            <GroupBox Header="📐 Camera Hardware ROI (Cắt Từ Phần Cứng)" Margin="0,0,0,8" Padding="6" FontWeight="SemiBold">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <CheckBox Content="Kích hoạt Hardware ROI" IsChecked="{Binding EnableHardwareRoi}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                    </DockPanel>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Command="{Binding SetFullSensorRoiCommand}" Content="🖥️ Full Sensor" Margin="0,0,3,0" Padding="4,3" FontSize="10" Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" />
                                        <Button Grid.Column="1" Command="{Binding CenterRoiCommand}" Content="🎯 Căn Giữa ROI" Margin="3,0,0,0" Padding="4,3" FontSize="10" Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" />
                                    </Grid>

                                    <TextBlock Text="Offset X (Vị trí X):" FontSize="10" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,1" />
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="65" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="0" Maximum="5440" Value="{Binding RoiOffsetX}" IsEnabled="{Binding EnableHardwareRoi}" SmallChange="4" LargeChange="16" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding RoiOffsetX}" IsEnabled="{Binding EnableHardwareRoi}" Margin="4,0,0,0" Padding="2" TextAlignment="Right" FontSize="11" />
                                    </Grid>

                                    <TextBlock Text="Offset Y (Vị trí Y):" FontSize="10" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,1" />
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="65" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="0" Maximum="3616" Value="{Binding RoiOffsetY}" IsEnabled="{Binding EnableHardwareRoi}" SmallChange="2" LargeChange="8" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding RoiOffsetY}" IsEnabled="{Binding EnableHardwareRoi}" Margin="4,0,0,0" Padding="2" TextAlignment="Right" FontSize="11" />
                                    </Grid>

                                    <TextBlock Text="Width (Chiều rộng ROI):" FontSize="10" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,1" />
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="65" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="32" Maximum="5472" Value="{Binding RoiWidth}" IsEnabled="{Binding EnableHardwareRoi}" SmallChange="4" LargeChange="16" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding RoiWidth}" IsEnabled="{Binding EnableHardwareRoi}" Margin="4,0,0,0" Padding="2" TextAlignment="Right" FontSize="11" />
                                    </Grid>

                                    <TextBlock Text="Height (Chiều cao ROI):" FontSize="10" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,1" />
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="65" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="32" Maximum="3648" Value="{Binding RoiHeight}" IsEnabled="{Binding EnableHardwareRoi}" SmallChange="2" LargeChange="8" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding RoiHeight}" IsEnabled="{Binding EnableHardwareRoi}" Margin="4,0,0,0" Padding="2" TextAlignment="Right" FontSize="11" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <!-- Group 5: Mạng GigE Vision -->
                            <GroupBox Header="🌐 Mạng GigE Vision" Margin="0,0,0,8" Padding="6" FontWeight="SemiBold">
                                <StackPanel>
                                    <TextBlock Text="Packet Size (Bytes):" FontSize="11" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding PacketSize}" Padding="4,2" Margin="0,0,0,6" />

                                    <TextBlock Text="Packet Delay (us):" FontSize="11" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding PacketDelay}" Padding="4,2" />
                                </StackPanel>
                            </GroupBox>

                            <!-- Group 6: Bộ lọc OpenCV mềm -->
                            <GroupBox Header="🎨 Bộ Lọc Mềm (Brightness, Contrast)" Margin="0,0,0,8" Padding="6" FontWeight="SemiBold">
                                <StackPanel>
                                    <TextBlock Text="Độ sáng (Brightness):" FontSize="11" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2" />
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="55" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="-100" Maximum="100" Value="{Binding Brightness}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding Brightness, StringFormat='{}{0:F0}'}" Margin="4,0,0,0" Padding="2" TextAlignment="Right" />
                                    </Grid>

                                    <TextBlock Text="Độ tương phản (Contrast):" FontSize="11" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2" />
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="55" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="0.1" Maximum="3.0" Value="{Binding Contrast}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding Contrast, StringFormat='{}{0:F2}'}" Margin="4,0,0,0" Padding="2" TextAlignment="Right" />
                                    </Grid>

                                    <CheckBox Content="Ảnh Đen Trắng (Grayscale)" IsChecked="{Binding IsGrayscale}" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Status & Reset Footer -->
                    <StackPanel Grid.Row="2" Margin="0,6,0,0">
                        <Separator Margin="0,0,0,6" />
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#4CAF50" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Button Command="{Binding ResetSettingsCommand}" Content="🔄 Khôi phục mặc định" Padding="6,3" Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Actions Bar -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <TextBlock Text="💡 Bấm 'Lưu Vào Job Này' để lưu toàn bộ các thông số trên vào tệp cấu hình của Job hiện tại." VerticalAlignment="Center" Foreground="#AAA" FontSize="11" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding SaveJobCameraSettingsCommand}" 
                            Background="#2E7D32" Foreground="White" FontWeight="Bold" Padding="20,8" Margin="0,0,10,0" BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾 " />
                            <TextBlock Text="Lưu Vào Job Hiện Tại" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CancelCommand}" 
                            Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextBrush}" Padding="16,8" BorderThickness="0" Content="Hủy / Đóng" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
