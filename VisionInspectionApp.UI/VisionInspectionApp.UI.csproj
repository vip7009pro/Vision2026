<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VisionInspectionApp.Application\VisionInspectionApp.Application.csproj" />
    <ProjectReference Include="..\VisionInspectionApp.Models\VisionInspectionApp.Models.csproj" />
    <ProjectReference Include="..\VisionInspectionApp.Persistence\VisionInspectionApp.Persistence.csproj" />
    <ProjectReference Include="..\VisionInspectionApp.PlcBridge\VisionInspectionApp.PlcBridge.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="DirectShowLib.Standard" Version="2.1.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="MvCameraControl.Net" Version="1.1.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20240616" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20240616" />
    <PackageReference Include="OpenCvSharp4.WpfExtensions" Version="4.10.0.20240616" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\cms-vina-vision-system.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\cms-vina-vision-system.ico" />
  </ItemGroup>

  <Target Name="KillPlcBridgeBeforeBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="powershell -Command &quot;Get-CimInstance Win32_Process -ErrorAction SilentlyContinue | Where-Object { $_.CommandLine -like '*VisionInspectionApp.PlcBridge*' -or $_.Name -eq 'VisionInspectionApp.PlcBridge.exe' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }&quot;" ContinueOnError="true" />
  </Target>

  <Target Name="CopyPlcBridgeFiles" AfterTargets="Build">
    <ItemGroup>
      <PlcBridgeFiles Include="..\VisionInspectionApp.PlcBridge\bin\x86\$(Configuration)\net8.0-windows\*.*" />
      <PlcBridgeFiles Include="..\VisionInspectionApp.PlcBridge\bin\$(Platform)\$(Configuration)\net8.0-windows\*.*" />
      <PlcBridgeFiles Include="..\VisionInspectionApp.PlcBridge\bin\$(Configuration)\net8.0-windows\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PlcBridgeFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

</Project>
