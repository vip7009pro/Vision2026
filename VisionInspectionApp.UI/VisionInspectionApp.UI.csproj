<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VisionInspectionApp.Application\VisionInspectionApp.Application.csproj" />
    <ProjectReference Include="..\VisionInspectionApp.Models\VisionInspectionApp.Models.csproj" />
    <ProjectReference Include="..\VisionInspectionApp.Persistence\VisionInspectionApp.Persistence.csproj" />
    <ProjectReference Include="..\VisionInspectionApp.PlcBridge\VisionInspectionApp.PlcBridge.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="DirectShowLib.Standard" Version="2.1.0" />
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="MvCameraControl.Net" Version="1.1.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20240616" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20240616" />
    <PackageReference Include="OpenCvSharp4.WpfExtensions" Version="4.10.0.20240616" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\cms-vina-vision-system.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Application Version (Dùng cho OTA Update & Windows File Properties) -->
    <Version>1.0.0.25</Version>
    <AssemblyVersion>1.0.0.25</AssemblyVersion>
    <FileVersion>1.0.0.25</FileVersion>
    <InformationalVersion>1.0.0.25</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\cms-vina-vision-system.ico" />
    <Resource Include="Assets\cms_vina_logo.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\docs\**\*.*" Link="docs\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="KillPlcBridgeBeforeBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="powershell -Command &quot;Get-CimInstance Win32_Process -ErrorAction SilentlyContinue | Where-Object { $_.CommandLine -like '*VisionInspectionApp.PlcBridge*' -or $_.Name -eq 'VisionInspectionApp.PlcBridge.exe' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }&quot;" ContinueOnError="true" />
  </Target>

  <Target Name="CopyPlcBridgeFiles" AfterTargets="Build">
    <ItemGroup>
      <PlcBridgeFiles Include="..\VisionInspectionApp.PlcBridge\bin\x86\$(Configuration)\net8.0-windows\*.*" />
      <PlcBridgeFiles Include="..\VisionInspectionApp.PlcBridge\bin\$(Platform)\$(Configuration)\net8.0-windows\*.*" />
      <PlcBridgeFiles Include="..\VisionInspectionApp.PlcBridge\bin\$(Configuration)\net8.0-windows\*.*" />
      <PlcBridgeFiles Include="..\VisionInspectionApp.PlcBridge\bin\x86\Debug\net8.0-windows\*.*" />
      <PlcBridgeFiles Include="..\VisionInspectionApp.PlcBridge\bin\x86\Release\net8.0-windows\*.*" />
      <PlcBridgeFiles Include="..\VisionInspectionApp.PlcBridge\bin\Debug\net8.0-windows\*.*" />
      <PlcBridgeFiles Include="..\VisionInspectionApp.PlcBridge\bin\Release\net8.0-windows\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PlcBridgeFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="false" ContinueOnError="true" />
  </Target>

  <Target Name="CopyUpdaterFiles" AfterTargets="Build">
    <ItemGroup>
      <UpdaterFiles Include="..\VisionInspectionApp.Updater\bin\$(Configuration)\net8.0-windows\VisionUpdater.*" />
      <UpdaterFiles Include="..\VisionInspectionApp.Updater\bin\$(Platform)\$(Configuration)\net8.0-windows\VisionUpdater.*" />
      <UpdaterFiles Include="..\VisionInspectionApp.Updater\bin\Debug\net8.0-windows\VisionUpdater.*" />
      <UpdaterFiles Include="..\VisionInspectionApp.Updater\bin\Release\net8.0-windows\VisionUpdater.*" />
    </ItemGroup>
    <Copy SourceFiles="@(UpdaterFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="false" ContinueOnError="true" />
  </Target>

  <!-- Tự động đồng bộ toàn bộ cấu hình hệ thống (OTA, DB, OQC, Camera, PLC, Jobs, Configs) sang thư mục Output Release -->
  <Target Name="SyncReleaseConfigurations" AfterTargets="Build">
    <PropertyGroup>
      <AppDataDir>$(APPDATA)\Vision2026</AppDataDir>
      <AppDataLegacyDir>$(APPDATA)\VisionInspectionApp</AppDataLegacyDir>
      <SystemConfigDest>$(TargetDir)configs\system</SystemConfigDest>
      <JobsDest>$(TargetDir)jobs</JobsDest>
      <ConfigsDest>$(TargetDir)configs</ConfigsDest>
    </PropertyGroup>

    <ItemGroup>
      <ConfigFilesToCopy Include="$(AppDataDir)\databases_config.json" Condition="Exists('$(AppDataDir)\databases_config.json')" />
      <ConfigFilesToCopy Include="$(AppDataDir)\oqc_scanner_config.json" Condition="Exists('$(AppDataDir)\oqc_scanner_config.json')" />
      <ConfigFilesToCopy Include="$(AppDataDir)\plc_config.json" Condition="Exists('$(AppDataDir)\plc_config.json')" />
      <ConfigFilesToCopy Include="$(AppDataDir)\camera_adjust_settings.json" Condition="Exists('$(AppDataDir)\camera_adjust_settings.json')" />
      <ConfigFilesToCopy Include="$(AppDataDir)\global_settings.json" Condition="Exists('$(AppDataDir)\global_settings.json')" />
      <ConfigFilesToCopy Include="$(AppDataLegacyDir)\global_settings.json" Condition="!Exists('$(AppDataDir)\global_settings.json') and Exists('$(AppDataLegacyDir)\global_settings.json')" />
      <ConfigFilesToCopy Include="$(AppDataDir)\global_chessboard_calibration.json" Condition="Exists('$(AppDataDir)\global_chessboard_calibration.json')" />
      <ConfigFilesToCopy Include="$(AppDataDir)\global_chessboard_settings.json" Condition="Exists('$(AppDataDir)\global_chessboard_settings.json')" />
      <ConfigFilesToCopy Include="$(AppDataDir)\recent_jobs.json" Condition="Exists('$(AppDataDir)\recent_jobs.json')" />
    </ItemGroup>

    <!-- Sao chép vào $(TargetDir)configs\system và $(TargetDir) -->
    <Copy SourceFiles="@(ConfigFilesToCopy)" DestinationFolder="$(SystemConfigDest)" SkipUnchangedFiles="true" ContinueOnError="true" />
    <Copy SourceFiles="@(ConfigFilesToCopy)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" ContinueOnError="true" />

    <!-- Đồng bộ jobs từ AppData\Vision2026\jobs hoặc Debug sang $(TargetDir)jobs -->
    <ItemGroup>
      <JobsToCopy Include="$(AppDataDir)\jobs\*.job" Condition="Exists('$(AppDataDir)\jobs')" />
      <JobsToCopy Include="$(ProjectDir)bin\x64\Debug\net8.0-windows\jobs\*.job" Condition="Exists('$(ProjectDir)bin\x64\Debug\net8.0-windows\jobs')" />
      <JobsToCopy Include="$(ProjectDir)bin\Debug\net8.0-windows\jobs\*.job" Condition="Exists('$(ProjectDir)bin\Debug\net8.0-windows\jobs')" />
    </ItemGroup>
    <Copy SourceFiles="@(JobsToCopy)" DestinationFolder="$(JobsDest)" SkipUnchangedFiles="true" ContinueOnError="true" />

    <!-- Đồng bộ configs recipes từ Debug sang $(TargetDir)configs -->
    <ItemGroup>
      <DebugConfigs Include="$(ProjectDir)bin\Debug\net8.0-windows\configs\**\*.*" Condition="Exists('$(ProjectDir)bin\Debug\net8.0-windows\configs')" />
    </ItemGroup>
    <Copy SourceFiles="@(DebugConfigs)" DestinationFolder="$(ConfigsDest)\%(RecursiveDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

</Project>
