<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0D0D10" />
    <LinearGradientBrush x:Key="HeaderBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#141418" Offset="0.0" />
        <GradientStop Color="#24242C" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#18181C" />
    <SolidColorBrush x:Key="PanelAltBackgroundBrush" Color="#222228" />
    <SolidColorBrush x:Key="BorderBrush" Color="#33333C" />
    <SolidColorBrush x:Key="DarkBorderBrush" Color="#484854" />
    
    <SolidColorBrush x:Key="TextBrush" Color="#F5F5F7" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#A1A1AA" />
    
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#272730" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#343440" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#4C4C5C" />

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0D0D10" />
    <SolidColorBrush x:Key="InputTextBrush" Color="#FFFFFF" />
    
    <SolidColorBrush x:Key="AccentBrush" Color="#007ACC" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#121216" />

    <DrawingBrush x:Key="CanvasGridBrush" TileMode="Tile" Viewport="0,0,50,50" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <!-- Solid background -->
                <GeometryDrawing Brush="#121216">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,50,50" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Minor grid lines (10px step) mờ nhẹ -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#0EFFFFFF" Thickness="0.7" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="10,0" EndPoint="10,50" />
                            <LineGeometry StartPoint="20,0" EndPoint="20,50" />
                            <LineGeometry StartPoint="30,0" EndPoint="30,50" />
                            <LineGeometry StartPoint="40,0" EndPoint="40,50" />
                            <LineGeometry StartPoint="0,10" EndPoint="50,10" />
                            <LineGeometry StartPoint="0,20" EndPoint="50,20" />
                            <LineGeometry StartPoint="0,30" EndPoint="50,30" />
                            <LineGeometry StartPoint="0,40" EndPoint="50,40" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Major grid lines (50px step) -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#25FFFFFF" Thickness="1.0" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,0" EndPoint="50,0" />
                            <LineGeometry StartPoint="0,0" EndPoint="0,50" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <SolidColorBrush x:Key="SnapLineBrush" Color="#00E5FF" />

</ResourceDictionary>
