<Window x:Class="VisionInspectionApp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VisionInspectionApp.UI"
        xmlns:viewModels="clr-namespace:VisionInspectionApp.UI.ViewModels"
        xmlns:views="clr-namespace:VisionInspectionApp.UI.Views"
        xmlns:oqc="clr-namespace:VisionInspectionApp.UI.Views.OQC"
        mc:Ignorable="d"
    Title="CMS VINA VISION SYSTEM"
    Height="900"
    Width="1400"
    FontFamily="Segoe UI"
    Background="{DynamicResource WindowBackgroundBrush}"
    Foreground="{DynamicResource TextBrush}"
    Icon="pack://application:,,,/VisionInspectionApp.UI;component/Assets/cms-vina-vision-system.ico">

    <Window.InputBindings>
    </Window.InputBindings>

    <Window.Resources>
        <SolidColorBrush x:Key="ShellBg" Color="#F3F6FB" />
        <SolidColorBrush x:Key="ShellSurface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ShellSurfaceSoft" Color="#F8FAFD" />
        <SolidColorBrush x:Key="ShellBorder" Color="#D9E2EC" />
        <SolidColorBrush x:Key="ShellAccent" Color="#0F5FA8" />
        <SolidColorBrush x:Key="ShellAccentDark" Color="#32c746" />
        <SolidColorBrush x:Key="ShellAccentTeal" Color="#18A6A3" />
        <SolidColorBrush x:Key="ShellText" Color="#132238" />
        <SolidColorBrush x:Key="ShellTextMuted" Color="#5F6B7A" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ShellAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ShellAccentDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.985" ScaleY="0.985" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource ShellAccentDark}"
                                    Padding="5"
                                    CornerRadius="0,0,0,0"
                                    Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- The Tabs -->
                                    <TabPanel Grid.Column="1" 
                                              IsItemsHost="True" 
                                              Margin="20,0,0,0" 
                                              VerticalAlignment="Bottom" />

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#1AFFFFFF"
                                                BorderBrush="#40FFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="10,6"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="#31D07D" Margin="0,0,8,0" />
                                                <TextBlock Text="Ready" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                        <Button Content="Close Job"
                                                Command="{Binding CloseJobCommand}"
                                                Background="#E53935"
                                                BorderBrush="#B71C1C"
                                                Foreground="White" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Margin="0,0,0,0"
                                    Padding="0">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10,10,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource ShellAccent}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource ShellAccentDark}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Opacity" Value="0.95" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type viewModels:ToolEditorViewModel}">
            <views:ToolEditorView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:InspectionViewModel}">
            <views:InspectionView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:CalibrationViewModel}">
            <views:CalibrationView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:ManualInspectionViewModel}">
            <views:ManualInspectionView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:OqcScannerViewModel}">
            <oqc:OqcScannerView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:CameraSettingsViewModel}">
            <views:CameraSettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <TabControl SelectedIndex="{Binding SelectedTabIndex, UpdateSourceTrigger=PropertyChanged}">
            <TabItem Header="Tool Editor">
                <ContentControl Content="{Binding ToolEditor}" />
            </TabItem>
            <TabItem Header="Calibration">
                <ContentControl Content="{Binding Calibration}" />
            </TabItem>
            <TabItem Header="Manual Inspection">
                <ContentControl Content="{Binding ManualInspection}" />
            </TabItem>
            <TabItem Header="OQC Scanner">
                <ContentControl Content="{Binding OqcScanner}" />
            </TabItem>
            <TabItem Header="Camera Settings">
                <ContentControl Content="{Binding CameraSettings}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
