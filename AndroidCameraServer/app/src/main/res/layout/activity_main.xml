<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="12dp">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📱 Galaxy S24 Ultra Camera Server"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvServerBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#2E7D32"
            android:text="ONLINE :8080"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />
    </LinearLayout>

    <!-- Network connection info card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface_card"
        android:padding="10dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvIpUsb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚡ Cáp USB (ADB): 127.0.0.1:8080 (Độ trễ &lt; 5ms)"
            android:textColor="@color/accent_blue"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvIpWifi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌐 Wi-Fi / LAN IP: Đang dò tìm..."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="3dp" />
    </LinearLayout>

    <!-- Live Camera View Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000"
        android:layout_marginBottom="8dp">

        <TextureView
            android:id="@+id/cameraTextureView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Pro Mode Parameter HUD Overlay -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#A0000000"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvHudLens"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍 Ống kính: Primary 1x (200MP ISOCELL HP2)"
                android:textColor="@color/accent_amber"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tvHudExposure"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💡 Phơi sáng: Auto"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvHudEv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EV: 0.0"
                    android:textColor="@color/accent_green"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tvHudFocus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🎯 Nét: Continuous AF"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvHudIsoWb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ISO: Auto • WB: Auto"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Controls & Quick Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginBottom="4dp">

        <Button
            android:id="@+id/btnToggleServer"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="DỪNG SERVER"
            android:textSize="11sp"
            android:textStyle="bold"
            android:backgroundTint="@color/accent_red"
            android:textColor="@color/white"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnSwitchLens"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="ĐỔI LENS"
            android:textSize="11sp"
            android:textStyle="bold"
            android:backgroundTint="@color/surface_card"
            android:textColor="@color/accent_blue"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnToggleTorch"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="FLASH LED"
            android:textSize="11sp"
            android:textStyle="bold"
            android:backgroundTint="@color/surface_card"
            android:textColor="@color/accent_amber" />
    </LinearLayout>

</LinearLayout>
