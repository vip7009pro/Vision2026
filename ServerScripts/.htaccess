# CMS VINA Vision System - Server Configuration
# Tu dong nang gioi han upload va bo nho cho may chu Apache / cPanel / LiteSpeed

<IfModule mod_php.c>
    php_value upload_max_filesize 1024M
    php_value post_max_size 1024M
    php_value memory_limit 1024M
    php_value max_execution_time 900
    php_value max_input_time 900
</IfModule>

<IfModule mod_php7.c>
    php_value upload_max_filesize 1024M
    php_value post_max_size 1024M
    php_value memory_limit 1024M
    php_value max_execution_time 900
    php_value max_input_time 900
</IfModule>

<IfModule mod_php8.c>
    php_value upload_max_filesize 1024M
    php_value post_max_size 1024M
    php_value memory_limit 1024M
    php_value max_execution_time 900
    php_value max_input_time 900
</IfModule>
